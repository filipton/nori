<?xml version="1.0" encoding="utf-8"?>
<!-- The author's artwork on a rice-white plate: the mark is black, transparency read as black
  on dark wallpapers and swallowed half of it. The monochrome layer is the mark's black alone, its light rim,
  grooves and spindle cut out, for the launcher's themed icons (Android 13+) to colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/nori_mark" />
    <monochrome android:drawable="@drawable/nori_mark_mono" />
</adaptive-icon>
