component Icon inherits Path {
    in property <string> path;
    in property <brush> colour: Theme.text;
    in property <bool> solid;
    in property <length> weight: 1.7px;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.path;
    fill: root.solid ? root.colour : transparent;
    stroke: root.solid ? transparent : root.colour;
    stroke-width: root.weight;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// Glass, as Tahoe draws it where it cannot see through: a dark tinted pane, a thin rim that catches the
// light along its top, and a soft shadow under it.
component Glass inherits Rectangle {
    in property <length> radius: 18px;
    in property <color> tint: #2a2a2d;
    in property <float> density: 0.88;
    in property <bool> lifted: true;
    border-radius: root.radius;
    background: root.tint.with-alpha(root.density);
    border-width: 1px;
    border-color: @linear-gradient(180deg, #ffffff2e 0%, #ffffff0f 35%, #ffffff0a 100%);
    drop-shadow-blur: root.lifted ? 24px : 0;
    drop-shadow-offset-y: root.lifted ? 8px : 0;
    drop-shadow-color: #0000006b;
}

// A borderless button: an icon that dims when not lit, and a round hover under it.
component IconButton inherits Rectangle {
    in property <string> path;
    in property <bool> solid;
    in property <bool> lit;
    in property <bool> quiet;
    in property <length> size: 32px;
    in property <length> icon: 19px;
    in property <color> ink: Theme.text;
    in property <color> base: transparent;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: touch.has-hover ? Theme.hover : root.base;
    animate background { duration: 160ms; easing: ease-out; }
    Icon {
        path: root.path;
        solid: root.solid;
        colour: root.lit ? Theme.accent : (root.quiet ? Theme.dim : root.ink);
        animate colour { duration: 200ms; }
        width: root.icon;
        height: root.icon;
        transform-scale: touch.pressed ? 0.86 : 1;
        animate transform-scale { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Play and pause: the two glyphs cross-fade and scale into each other, as Apple's do.
component PlayPause inherits Rectangle {
    in property <bool> playing;
    in property <length> size: 36px;
    in property <length> icon: 24px;
    in property <color> ink: Theme.text;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 160ms; easing: ease-out; }
    Rectangle {
        transform-scale: touch.pressed ? 0.86 : 1;
        animate transform-scale { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        Icon {
            path: Icons.play;
            solid: true;
            colour: root.ink;
            width: root.icon;
            height: root.icon;
            opacity: root.playing ? 0 : 1;
            transform-scale: root.playing ? 0.5 : 1;
            animate opacity, transform-scale { duration: 220ms; easing: ease-out; }
        }
        Icon {
            path: Icons.pause;
            solid: true;
            colour: root.ink;
            width: root.icon;
            height: root.icon;
            opacity: root.playing ? 1 : 0;
            transform-scale: root.playing ? 1 : 0.5;
            animate opacity, transform-scale { duration: 220ms; easing: ease-out; }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A page as it comes on screen: it fades in and rises the last few points into place.
component Fade inherits Rectangle {
    property <bool> shown;
    opacity: self.shown ? 1 : 0;
    y: self.shown ? 0 : 10px;
    animate opacity { duration: 240ms; easing: ease-out; }
    animate y { duration: 320ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
    init => { self.shown = true; }
}

// Apple's filled capsule buttons ("Play", "Shuffle").
component Capsule inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> solid-icon;
    in property <color> ink: Theme.accent;
    in property <color> label: white;
    callback clicked;
    height: 34px;
    width: max(124px, row.preferred-width + 40px);
    border-radius: self.height / 2;
    background: root.ink;
    opacity: touch.pressed ? 0.75 : 1;
    row := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            path: root.icon;
            solid: root.solid-icon;
            colour: root.label;
            weight: 2.2px;
            width: 13px;
            height: 13px;
        }
        Text {
            text: root.text;
            color: root.label;
            font-weight: 600;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A thin bar that can be dragged: the seek bar and the volume. `value` is 0 to 1; `done` says where it was
// let go, `moved` where it is while held.
component Bar inherits Rectangle {
    in property <float> value;
    in property <length> thin: 3px;
    in property <length> thick: 5px;
    in property <color> fill: #ffffffcc;
    in property <color> track: #ffffff24;
    out property <bool> hot: touch.has-hover || root.held >= 0;
    callback moved(float);
    callback done(float);
    property <float> held: -1;
    property <float> shown: root.held >= 0 ? root.held : max(0, min(1, root.value));
    height: 12px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.hot ? root.thick : root.thin;
        animate height { duration: 120ms; easing: ease-out; }
        border-radius: self.height / 2;
        background: root.track;
        clip: true;
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            background: root.fill;
        }
    }
    touch := TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.held = max(0, min(1, self.mouse-x / root.width));
                root.moved(root.held);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.held >= 0 {
                root.done(root.held);
                root.held = -1;
            }
        }
        moved => {
            if self.pressed {
                root.held = max(0, min(1, self.mouse-x / root.width));
                root.moved(root.held);
            }
        }
    }
}

// Artwork: rounded, with a hairline edge so dark covers keep their shape on the dark ground.
component Art inherits Rectangle {
    in property <image> source;
    in property <bool> shadow;
    border-radius: 6px;
    background: #2e2e30;
    drop-shadow-blur: root.shadow ? 20px : 0;
    drop-shadow-offset-y: root.shadow ? 8px : 0;
    drop-shadow-color: #00000070;
    Icon {
        path: Icons.note;
        colour: #ffffff38;
        width: parent.width * 0.34;
        height: self.width;
        weight: 1.4px;
        visible: root.source.width == 0;
    }
    Rectangle {
        border-radius: root.border-radius;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.source;
            image-fit: cover;
        }
    }
    Rectangle {
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: #ffffff12;
    }
}

// An album, artist or playlist in a grid or on a shelf: the artwork, and the title and the artist under
// it. The pointer over it brings a play button onto the artwork, as Music does.
component CardView inherits Rectangle {
    in property <Card> card;
    in property <image> picture;
    in property <bool> round;
    in property <bool> playable: !root.round;
    in property <length> side: 176px;
    callback open;
    callback play;
    width: root.side;
    height: root.side + 46px;
    Art {
        y: 0;
        width: root.side;
        height: root.side;
        source: root.picture;
        border-radius: root.round ? self.width / 2 : 8px;
        Rectangle {
            border-radius: parent.border-radius;
            background: touch.has-hover ? #00000030 : transparent;
            animate background { duration: 180ms; easing: ease-out; }
        }
    }
    Text {
        y: root.side + 8px;
        width: root.side;
        text: root.card.title;
        color: Theme.text;
        font-size: 13px;
        overflow: elide;
        horizontal-alignment: root.round ? center : left;
    }
    Text {
        y: root.side + 25px;
        width: root.side;
        text: root.card.sub;
        color: Theme.dim;
        font-size: 13px;
        overflow: elide;
        horizontal-alignment: root.round ? center : left;
    }
    touch := TouchArea {
        clicked => { root.open(); }
    }
    if root.playable: Rectangle {
        x: 10px;
        y: root.side - self.height - 10px;
        opacity: touch.has-hover || play-touch.has-hover ? 1 : 0;
        transform-scale: touch.has-hover || play-touch.has-hover ? 1 : 0.8;
        animate opacity, transform-scale { duration: 180ms; easing: ease-out; }
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: play-touch.has-hover ? Theme.accent : #1e1e1ec0;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000060;
        Icon {
            x: (parent.width - self.width) / 2 + 1px;
            path: Icons.play;
            solid: true;
            colour: white;
            width: 14px;
            height: 14px;
        }
        play-touch := TouchArea {
            enabled: parent.opacity > 0.5;
            clicked => { root.play(); }
        }
    }
}

// Cards in rows filling the page's width. Only the ones on screen are drawn, and only those ask for their
// covers.
component Grid inherits Flickable {
    in property <[Card]> cards;
    in property <int> rev;
    in property <bool> round;
    in property <length> pad: 32px;
    in property <length> bottom: 100px;
    pure callback art(string, int, int) -> image;
    callback open(Card);
    callback play(Card);
    property <length> gap: 22px;
    property <int> columns: max(2, floor((self.width - root.pad * 2 + root.gap) / (176px + root.gap)));
    // The cards grow a little so the rows reach both edges.
    property <length> side: (self.width - root.pad * 2 - (root.columns - 1) * root.gap) / root.columns;
    content-height: ceil(root.cards.length / root.columns) * (root.side + 46px + 24px) + root.bottom;
    for c[i] in root.cards: CardView {
        x: root.pad + mod(i, root.columns) * (root.side + root.gap);
        y: floor(i / root.columns) * (root.side + 46px + 24px);
        side: root.side;
        card: c;
        round: root.round;
        picture: root.art(c.art, 0, root.rev);
        open => { root.open(c); }
        play => { root.play(c); }
    }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <bool> more;
    callback clicked;
    alignment: start;
    spacing: 4px;
    height: 30px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: 19px;
        font-weight: 700;
        vertical-alignment: center;
    }
    if root.more: Icon {
        y: (parent.height - self.height) / 2 + 1px;
        path: Icons.chevron;
        colour: Theme.dim;
        weight: 2.4px;
        width: 15px;
        height: 15px;
    }
}

// A shelf of cards that scrolls sideways, under its title.
component ShelfView inherits VerticalLayout {
    in property <string> title;
    in property <[Card]> cards;
    in property <int> rev;
    in property <bool> round;
    pure callback art(string, int, int) -> image;
    callback open(Card);
    callback play(Card);
    spacing: 10px;
    padding-bottom: 26px;
    HorizontalLayout {
        padding-left: 32px;
        SectionTitle {
            text: root.title;
        }
    }
    Flickable {
        height: 176px + 46px;
        content-width: root.cards.length * (176px + 22px) + 64px - 22px;
        for c[i] in root.cards: CardView {
            x: 32px + i * (176px + 22px);
            card: c;
            round: root.round;
            picture: root.art(c.art, 0, root.rev);
            open => { root.open(c); }
            play => { root.play(c); }
        }
    }
}

// A song in a list, as Music lists them: the number (or the small artwork), the title, the artist and
// album, and the length, over a hairline. Double click plays; a right click offers the rest.
component SongLine inherits Rectangle {
    in property <SongRow> song;
    in property <int> number;
    in property <bool> show-album: true;
    in property <bool> thumb;
    in property <image> picture;
    in property <color> ink: Theme.accent;
    callback play;
    callback next;
    callback later;
    height: root.thumb ? 56px : 44px;
    border-radius: 7px;
    background: root.song.playing ? root.ink : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: 140ms; easing: ease-out; }
    Rectangle {
        x: root.thumb ? 64px : 44px;
        y: parent.height - 1px;
        width: parent.width - self.x - 8px;
        height: 1px;
        background: Theme.hairline;
    }
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "Play";
                activated => { root.play(); }
            }
            MenuItem {
                title: "Play Next";
                activated => { root.next(); }
            }
            MenuItem {
                title: "Play Last";
                activated => { root.later(); }
            }
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 12px;
            spacing: 12px;
            if root.thumb: Art {
                y: (parent.height - self.height) / 2;
                width: 44px;
                height: 44px;
                border-radius: 5px;
                source: root.picture;
            }
            if !root.thumb: Rectangle {
                width: 24px;
                if root.song.playing: Icon {
                    path: Icons.bars;
                    solid: true;
                    colour: white;
                    width: 15px;
                    height: 15px;
                }
                if !root.song.playing: Text {
                    width: 100%;
                    text: root.number;
                    color: root.song.playing ? #ffffffcc : Theme.dim;
                    font-size: 13px;
                    horizontal-alignment: right;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 2;
                Text {
                    text: root.song.title;
                    color: root.song.playing ? white : Theme.text;
                    font-size: 13px;
                    overflow: elide;
                }
                if root.thumb || root.show-album: Text {
                    text: root.song.artist;
                    color: root.song.playing ? #ffffffcc : Theme.dim;
                    font-size: 13px;
                    overflow: elide;
                }
            }
            if root.show-album: Text {
                horizontal-stretch: 1;
                text: root.song.album;
                color: root.song.playing ? #ffffffcc : Theme.dim;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.song.time;
                color: root.song.playing ? #ffffffcc : Theme.dim;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: 44px;
            }
        }
        touch := TouchArea {
            double-clicked => { root.play(); }
        }
    }
}

component SideItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <image> picture;
    in property <bool> has-picture;
    in property <bool> chosen;
    callback clicked;
    height: 34px;
    border-radius: 9px;
    background: root.chosen ? Theme.chosen : (touch.has-hover ? #ffffff0a : transparent);
    animate background { duration: 180ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        if !root.has-picture: Icon {
            y: (parent.height - self.height) / 2;
            path: root.icon;
            colour: Theme.accent;
            width: 20px;
            height: 20px;
        }
        if root.has-picture: Art {
            y: (parent.height - self.height) / 2;
            width: 24px;
            height: 24px;
            border-radius: 4px;
            source: root.picture;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-weight: root.chosen ? 600 : 400;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SideHeading inherits Text {
    color: Theme.dim;
    font-size: 12px;
    font-weight: 600;
    height: 30px;
    vertical-alignment: bottom;
    x: 10px;
}

// A page's large title, clear of the titlebar the page runs up under.
component Heading inherits VerticalLayout {
    in property <string> title;
    in property <string> caption;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 52px;
    padding-bottom: 16px;
    spacing: 2px;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 34px;
        font-weight: 700;
    }
    if root.caption != "": Text {
        text: root.caption;
        color: Theme.dim;
        font-size: 13px;
    }
}

// A text field: a rounded well, a magnifier or another icon, the placeholder until something is typed.
component Field inherits Rectangle {
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> secret;
    in-out property <string> text;
    callback edited(string);
    callback accepted;
    height: 34px;
    border-radius: 9px;
    background: #ffffff0f;
    border-width: input.has-focus ? 3px : 1px;
    border-color: input.has-focus ? Theme.accent.with-alpha(0.55) : #ffffff14;
    public function take-focus() {
        input.focus();
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            path: root.icon;
            colour: Theme.dim;
            width: 15px;
            height: 15px;
        }
        Rectangle {
            input := TextInput {
                width: 100%;
                text <=> root.text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                input-type: root.secret ? InputType.password : InputType.text;
                selection-background-color: Theme.accent.with-alpha(0.4);
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
            if root.text == "": Text {
                x: 0;
                text: root.placeholder;
                color: Theme.faint;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

// The player's controls: the transport, the song with its progress under it, lyrics, the queue and the
// volume. The main window draws them in its own glass capsule where the system has no glass (Linux); on
// macOS they are the whole of `PlayerBar`, a window of their own over the system's Liquid Glass.
component PlayerControls inherits Rectangle {
    in property <bool> has-song;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-art;
    in property <bool> playing;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> volume: 1;
    in property <int> inspector;
    in property <int> covers-rev;
    pure callback art(string, int, int) -> image;
    callback toggle();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback set-inspector(int);
    callback open-full();

    function clock(ms: int) -> string {
        let s = floor(max(0, ms) / 1000);
        return floor(s / 60) + ":" + (mod(s, 60) < 10 ? "0" : "") + mod(s, 60);
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 4px;
        IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.shuffle;
            lit: root.shuffle;
            quiet: true;
            size: 34px;
            icon: 20px;
            clicked => { root.toggle-shuffle(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.previous;
            solid: true;
            size: 36px;
            icon: 22px;
            clicked => { root.previous(); }
        }
        PlayPause {
            y: (parent.height - self.height) / 2;
            playing: root.playing;
            size: 36px;
            icon: 24px;
            clicked => { root.toggle(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.next;
            solid: true;
            size: 36px;
            icon: 22px;
            clicked => { root.next(); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.repeat;
            lit: root.repeat != 0;
            quiet: true;
            size: 34px;
            icon: 20px;
            clicked => { root.cycle-repeat(); }
            if root.repeat == 1: Text {
                x: parent.width - 11px;
                y: 3px;
                text: "1";
                color: Theme.accent;
                font-size: 8px;
                font-weight: 800;
            }
        }
        Rectangle {
            width: 10px;
        }
        // The song: its artwork (Now Playing on a click), the title, the artist and album,
        // and the progress under them, which thickens and shows the times under the pointer.
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            Art {
                y: (parent.height - self.height) / 2;
                width: 38px;
                height: 38px;
                border-radius: 5px;
                source: root.art(root.now-art, 0, root.covers-rev);
                TouchArea {
                    clicked => {
                        if root.has-song {
                            root.open-full();
                        }
                    }
                }
            }
            song-box := Rectangle {
                horizontal-stretch: 1;
                property <int> dragged: -1;
                VerticalLayout {
                    y: 8px;
                    height: 32px;
                    Text {
                        text: root.has-song ? root.now-title : "Not Playing";
                        color: Theme.text;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: seek.hot ? root.clock(song-box.dragged >= 0 ? song-box.dragged : root.position-ms) + "  /  " + root.clock(root.duration-ms) : root.now-artist + (root.now-album != "" ? " — " + root.now-album : "");
                        color: Theme.dim;
                        overflow: elide;
                    }
                }
                seek := Bar {
                    y: parent.height - self.height - 1px;
                    width: parent.width;
                    thin: 2px;
                    thick: 6px;
                    value: root.duration-ms > 0 ? (parent.dragged >= 0 ? parent.dragged : root.position-ms) / root.duration-ms : 0;
                    moved(v) => { parent.dragged = v * root.duration-ms; }
                    done(v) => {
                        parent.dragged = -1;
                        root.seek(v);
                    }
                }
            }
        }
        Rectangle {
            width: 10px;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.lyrics;
            lit: root.inspector == 2;
            size: 34px;
            icon: 20px;
            clicked => { root.set-inspector(root.inspector == 2 ? 0 : 2); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.queue;
            lit: root.inspector == 1;
            size: 34px;
            icon: 20px;
            clicked => { root.set-inspector(root.inspector == 1 ? 0 : 1); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            path: root.volume > 0 ? Icons.speaker : Icons.speaker-off;
            size: 34px;
            icon: 20px;
            clicked => { root.set-volume(root.volume > 0 ? 0 : 1); }
        }
        Bar {
            y: (parent.height - self.height) / 2;
            width: 84px;
            value: root.volume;
            moved(v) => { root.set-volume(v); }
            done(v) => { root.set-volume(v); }
        }
    }
}

// What plays next, as Music's panel lists it: AutoPlay and AutoMix as two wide pills, "Continue Playing"
// with where the songs come from and Clear, the songs with their artwork, and AutoPlay's promise at the end.
component QueueView inherits Rectangle {
    in property <[SongRow]> queue;
    in property <string> from;
    in property <bool> autoplay;
    in property <bool> automix;
    in property <int> covers-rev;
    in property <bool> wide;
    pure callback art(string, int, int) -> image;
    callback jump(int);
    callback clear;
    callback set-autoplay(bool);
    callback set-automix(bool);
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 0;
        HorizontalLayout {
            spacing: 8px;
            height: 34px;
            for pill[i] in [{ on: root.autoplay, label: "AutoPlay" }, { on: root.automix, label: "AutoMix" }]: Rectangle {
                border-radius: self.height / 2;
                background: pill.on ? Theme.accent : #ffffff1a;
                animate background { duration: 180ms; easing: ease-out; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        path: i == 0 ? Icons.infinity : Icons.rings;
                        colour: pill.on ? white : Theme.text;
                        weight: 2px;
                        width: 20px;
                        height: 20px;
                    }
                    if root.wide: Text {
                        text: pill.label;
                        color: pill.on ? white : Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => {
                        if i == 0 {
                            root.set-autoplay(!root.autoplay);
                        } else {
                            root.set-automix(!root.automix);
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            padding-left: 4px;
            padding-top: 14px;
            padding-bottom: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: "Continue Playing";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                }
                if root.from != "": Text {
                    text: "From " + root.from;
                    color: Theme.dim;
                    font-size: 13px;
                    overflow: elide;
                }
            }
            if root.queue.length > 0: Text {
                text: "Clear";
                color: Theme.accent;
                font-size: 13px;
                vertical-alignment: top;
                TouchArea {
                    clicked => { root.clear(); }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }
        Flickable {
            vertical-stretch: 1;
            content-height: rows.preferred-height;
            rows := VerticalLayout {
            width: parent.width;
            for s in root.queue: Rectangle {
                height: 50px;
                border-radius: 6px;
                background: qt.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 10px;
                    Art {
                        y: (parent.height - self.height) / 2;
                        width: 34px;
                        height: 34px;
                        border-radius: 4px;
                        source: root.art(s.art, 0, root.covers-rev);
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: s.title;
                            color: Theme.text;
                            font-size: 13px;
                            overflow: elide;
                        }
                        Text {
                            text: s.artist + (s.album != "" ? " — " + s.album : "");
                            color: Theme.dim;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: "···";
                        color: Theme.dim;
                        font-size: 14px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    x: 48px;
                    y: parent.height - 1px;
                    width: parent.width - 52px;
                    height: 1px;
                    background: Theme.hairline;
                }
                qt := TouchArea {
                    double-clicked => { root.jump(s.index); }
                }
            }
                if root.autoplay: HorizontalLayout {
                padding-left: 4px;
                padding-top: 16px;
                padding-bottom: 8px;
                spacing: 6px;
                Icon {
                    path: Icons.infinity;
                    colour: Theme.text;
                    weight: 2px;
                    width: 20px;
                    height: 20px;
                }
                VerticalLayout {
                    Text {
                        text: "AutoPlay";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Similar songs will play";
                        color: Theme.dim;
                        font-size: 13px;
                    }
                }
            }
            }
        }

    }
}

// Where the window is dragged from, and double-clicked to zoom: the content runs up under the titlebar.
component TitleStrip inherits TouchArea {
    callback drag;
    callback zoom;
    height: 44px;
    pointer-event(e) => {
        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
            root.drag();
        }
    }
    double-clicked => { root.zoom(); }
}

// The sidebar's rows: search and home, the library, the playlists, and settings and the server at its
// foot. The main window draws them over its own pane where the system has no glass (Linux); on macOS
// they are the whole of `SidebarWindow`, whose view sits inside the system's Liquid Glass over the page.
component SidebarContent inherits Rectangle {
    in property <int> view;
    in property <int> page-kind;
    in property <string> page-id;
    in property <[Card]> playlists;
    in property <string> server;
    in property <int> covers-rev;
    in property <length> inset-top;
    pure callback art(string, int, int) -> image;
    callback go(int);
    callback open-playlist(string);
    callback drag-window();
    callback zoom-window();

    TitleStrip {
        y: 0;
        drag => { root.drag-window(); }
        zoom => { root.zoom-window(); }
    }
    Flickable {
        y: root.inset-top;
        height: parent.height - self.y - foot.height;
        content-height: side.preferred-height;
        side := VerticalLayout {
            width: parent.width;
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 12px;
            spacing: 1px;
            SideItem {
                text: "Search";
                icon: Icons.search;
                chosen: root.view == 1;
                clicked => { root.go(1); }
            }
            SideItem {
                text: "Home";
                icon: Icons.home;
                chosen: root.view == 0;
                clicked => { root.go(0); }
            }
            SideHeading {
                text: "Library";
            }
            SideItem {
                text: "Artists";
                icon: Icons.artists;
                chosen: root.view == 3 || (root.view == 6 && root.page-kind == 1);
                clicked => { root.go(3); }
            }
            SideItem {
                text: "Albums";
                icon: Icons.albums;
                chosen: root.view == 2 || (root.view == 6 && root.page-kind == 0);
                clicked => { root.go(2); }
            }
            SideItem {
                text: "Songs";
                icon: Icons.songs;
                chosen: root.view == 5;
                clicked => { root.go(5); }
            }
            SideHeading {
                text: "Playlists";
            }
            SideItem {
                text: "All Playlists";
                icon: Icons.playlists;
                chosen: root.view == 4;
                clicked => { root.go(4); }
            }
            for p in root.playlists: SideItem {
                text: p.title;
                has-picture: true;
                picture: root.art(p.art, 0, root.covers-rev);
                chosen: root.view == 6 && root.page-kind == 2 && root.page-id == p.id;
                clicked => { root.open-playlist(p.id); }
            }
        }
    }
    foot := VerticalLayout {
        height: self.preferred-height;
        y: parent.height - self.height;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 12px;
        spacing: 1px;
        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }
        Rectangle {
            height: 6px;
        }
        SideItem {
            text: "Settings";
            icon: Icons.gear;
            chosen: root.view == 8;
            clicked => { root.go(8); }
        }
        SideItem {
            text: root.server;
            icon: Icons.server;
            chosen: root.view == 7;
            clicked => { root.go(7); }
        }
    }
}


export component AppWindow inherits Window {
    title: "nori";
    icon: @image-url("assets/logo.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 860px;
    min-height: 560px;
    // Clear, so the system's sidebar material shows through the sidebar's pane (macOS).
    background: root.vibrancy ? transparent : Theme.ground;
    default-font-size: 13px;
    default-font-family: root.font;

    // The system's own font on macOS (SF Pro), Inter elsewhere.
    in property <string> font: "Inter";
    // The system blurs what is behind the window where the interface is clear (macOS).
    in property <bool> vibrancy;
    // Room for the traffic lights at the top of the sidebar.
    in property <length> inset-top: 16px;

    // 0 home, 1 search, 2 albums, 3 artists, 4 playlists, 5 songs, 6 a page (album, artist, playlist), 7 login.
    in-out property <int> view: 0;
    in property <string> server;
    in property <string> greeting: "Home";
    in property <bool> loading;
    in property <string> failed;
    in property <string> note;
    in property <bool> note-error;
    // Bumped whenever a cover arrives: every picture asks `art` again and finds the new one.
    in property <int> covers-rev;
    pure callback art(string, int, int) -> image;

    in property <[Shelf]> shelves;
    in property <[Card]> albums;
    in property <[Card]> artists;
    in property <[Card]> playlists;
    in property <[SongRow]> songs;
    in property <bool> more-songs;

    in-out property <string> search-text;
    in property <[Card]> search-artists;
    in property <[Card]> search-albums;
    in property <[SongRow]> search-songs;
    in property <string> search-note;

    // The page open: 0 album, 1 artist, 2 playlist, and its id (the sidebar marks a playlist's).
    in property <int> page-kind;
    in property <string> page-id;
    in property <string> page-title;
    in property <string> page-sub;
    in property <string> page-caption;
    in property <string> page-art;
    in property <[SongRow]> page-songs;
    in property <[Card]> page-albums;
    // The page wears its cover's colours: the blurred cover (nori-look's wash) runs out into the page's own
    // colour, so there is no line where the picture stops.
    in property <image> page-wash;
    in property <color> page-bg: Theme.ground;
    in property <color> page-accent: Theme.accent;

    // What plays.
    in property <bool> has-song;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-art;
    in property <bool> playing;
    in property <bool> buffering;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> volume: 1;
    in property <[SongRow]> queue;
    // Now Playing's ground: the cover playing, blurred (nori-look's wash), in two layers that cross-fade.
    in property <image> wash-a;
    in property <image> wash-b;
    in property <bool> wash-on-b;
    in property <color> wash-tint: #202024;
    // The inspector on the right: 0 shut, 1 Playing Next, 2 lyrics. It keeps showing the last one while it
    // slides away.
    in-out property <int> inspector;
    property <int> shown-panel: 1;
    changed inspector => {
        if self.inspector != 0 {
            self.shown-panel = self.inspector;
        }
        self.player-changed();
    }
    in-out property <bool> full-player;
    // What Now Playing shows beside the artwork: 0 nothing, 1 the queue, 2 the lyrics; and how tall the line
    // sung is (the compositor keeps it sharp).
    in-out property <int> full-panel: 2;
    out property <length> full-lyric-h: 60px;
    // The player is a window of its own over the system's Liquid Glass (macOS): the page draws none.
    in property <bool> native-player;
    // The sidebar is the system's Liquid Glass over the page (macOS): the page's ground, its colour and an
    // artist's picture run under it, and the page draws no sidebar of its own.
    in property <bool> native-sidebar;
    // The page's area moved (the window was resized), or what the player window mirrors changed.
    callback page-moved();
    callback player-changed();
    changed width => { root.page-moved(); }
    changed height => { root.page-moved(); }
    changed full-player => { root.player-changed(); }
    changed view => { root.player-changed(); }
    // The lyrics of the song playing: the lines, the one sung (-1 for none), and a line about them.
    in property <[string]> lyrics-lines;
    in property <int> lyrics-active: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-note;
    in property <[SettingRow]> settings;
    // What the queue panel says: where the songs come from, and whether AutoPlay and AutoMix are on.
    in property <string> queue-from;
    in property <bool> autoplay;
    in property <bool> automix;
    callback clear-queue();
    // The settings page's tab: 0 General, 1 Playback, 2 Sound, 3 Storage.
    in-out property <int> settings-tab;
    callback settings-tab-chosen(int);

    in-out property <string> login-url: "https://";
    in-out property <string> login-user;
    in-out property <string> login-password;
    in property <string> login-error;
    in property <bool> login-busy;
    in property <bool> can-cancel-login;

    callback go(int);
    callback open-album(string);
    callback open-artist(string);
    callback open-playlist(string);
    callback play-album(string);
    callback play-playlist(string);
    // A song of a list: 0 the page, 1 the songs, 2 search. `how`: 0 play, 1 next, 2 at the end.
    callback song(int, int, int);
    callback play-page(bool);
    // The page's songs added at the end of the queue.
    callback page-later();
    callback more();
    callback search-edited(string);
    callback toggle();
    callback next();
    callback previous();
    callback seek(float);
    callback seek-by(int);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback jump(int);
    callback login();
    callback cancel-login();
    callback setting-toggled(string, bool);
    callback setting-chosen(string, int);
    callback setting-action(string);
    callback drag-window();
    callback zoom-window();

    function clock(ms: int) -> string {
        let s = floor(max(0, ms) / 1000);
        return floor(s / 60) + ":" + (mod(s, 60) < 10 ? "0" : "") + mod(s, 60);
    }


    // The keys Music answers to without a menu: space plays and pauses, the arrows seek, escape leaves
    // Now Playing. A text field that has the keys keeps them.
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == " " {
                root.toggle();
                return accept;
            }
            if e.text == Key.Escape && root.full-player {
                root.full-player = false;
                return accept;
            }
            if e.text == Key.RightArrow && !e.modifiers.control {
                root.seek-by(10000);
                return accept;
            }
            if e.text == Key.LeftArrow && !e.modifiers.control {
                root.seek-by(-10000);
                return accept;
            }
            reject
        }

        // The ground: near black under the page; under the sidebar, clear to the system's sidebar material
        // (macOS), the sidebar's own grey elsewhere.
        Rectangle {
            x: root.view == 7 || !root.vibrancy ? 0 : Theme.side-w;
            width: parent.width - self.x;
            background: Theme.ground;
        }
        // Under the system's glass sidebar: the ground half clear, so the glass takes the desktop's colour
        // through the window as well as the page's.
        if root.native-sidebar && root.view != 7: Rectangle {
            width: Theme.side-w;
            background: Theme.ground.with-alpha(0.55);
        }

        if root.view == 7: Rectangle {
            TitleStrip {
                y: 0;
                drag => { root.drag-window(); }
                zoom => { root.zoom-window(); }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: 360px;
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            padding-bottom: 8px;
                            Image {
                                source: @image-url("assets/logo.png");
                                height: 54px;
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: "Sign in to your Navidrome or Subsonic server.";
                            color: Theme.dim;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 10px;
                        }
                        Field {
                            icon: Icons.server;
                            placeholder: "Server address";
                            text <=> root.login-url;
                        }
                        Field {
                            icon: Icons.person;
                            placeholder: "User name";
                            text <=> root.login-user;
                        }
                        Field {
                            icon: Icons.key;
                            placeholder: "Password";
                            secret: true;
                            text <=> root.login-password;
                            accepted => {
                                if !root.login-busy {
                                    root.login();
                                }
                            }
                        }
                        if root.login-error != "": Text {
                            text: root.login-error;
                            color: #ff453a;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                        Rectangle {
                            height: 8px;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            if root.can-cancel-login: Capsule {
                                text: "Cancel";
                                ink: Theme.fill;
                                label: Theme.text;
                                clicked => { root.cancel-login(); }
                            }
                            Capsule {
                                text: root.login-busy ? "Signing In…" : "Sign In";
                                clicked => {
                                    if !root.login-busy {
                                        root.login();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.view != 7: Rectangle {
            // A page that wears its cover's colour: the colour and the wash behind it.
            if root.view == 6: Rectangle {
                x: root.native-sidebar ? 0 : Theme.side-w;
                width: parent.width - self.x;
                background: root.page-bg;
                Image {
                    y: 0;
                    width: 100%;
                    height: 440px;
                    source: root.page-wash;
                    image-fit: fill;
                }
                Rectangle {
                    y: 0;
                    height: 440px;
                    background: @linear-gradient(180deg, root.page-bg.with-alpha(0.15) 0%, root.page-bg.with-alpha(0.55) 55%, root.page-bg 100%);
                }
            }
            // The page, right of the sidebar; it runs up under the titlebar and under the player.
            Rectangle {
                x: Theme.side-w;
                width: parent.width - self.x - (root.inspector != 0 ? Theme.panel-w : 0);
                animate width { duration: 300ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                // Under the system's glass, an artist's picture runs on under the sidebar.
                clip: !root.native-sidebar;

                if root.view == 0: Fade {
                    Flickable {
                        content-height: home.preferred-height;
                        home := VerticalLayout {
                            width: parent.width;
                            padding-bottom: 100px;
                            Heading {
                                title: root.greeting;
                            }
                            for shelf in root.shelves: VerticalLayout {
                                if shelf.cards.length > 0: ShelfView {
                                    title: shelf.title;
                                    cards: shelf.cards;
                                    rev: root.covers-rev;
                                    art(a, s, r) => { return root.art(a, s, r); }
                                    open(c) => { root.open-album(c.id); }
                                    play(c) => { root.play-album(c.id); }
                                }
                            }
                        }
                    }
                }

                if root.view == 1: Fade {
                    VerticalLayout {
                        HorizontalLayout {
                            padding-left: 32px;
                            padding-right: 32px;
                            padding-top: 52px;
                            padding-bottom: 8px;
                            Field {
                                icon: Icons.search;
                                placeholder: "Artists, albums and songs";
                                text <=> root.search-text;
                                edited(t) => { root.search-edited(t); }
                                init => { self.take-focus(); }
                            }
                        }
                        if root.search-note != "": Text {
                            x: 34px;
                            text: root.search-note;
                            color: Theme.dim;
                            height: 24px;
                            vertical-alignment: center;
                        }
                        Flickable {
                            vertical-stretch: 1;
                            content-height: found.preferred-height;
                            found := VerticalLayout {
                                width: parent.width;
                                padding-top: 16px;
                                padding-bottom: 100px;
                                if root.search-artists.length > 0: ShelfView {
                                    title: "Artists";
                                    cards: root.search-artists;
                                    round: true;
                                    rev: root.covers-rev;
                                    art(a, s, r) => { return root.art(a, s, r); }
                                    open(c) => { root.open-artist(c.id); }
                                }
                                if root.search-albums.length > 0: ShelfView {
                                    title: "Albums";
                                    cards: root.search-albums;
                                    rev: root.covers-rev;
                                    art(a, s, r) => { return root.art(a, s, r); }
                                    open(c) => { root.open-album(c.id); }
                                    play(c) => { root.play-album(c.id); }
                                }
                                if root.search-songs.length > 0: HorizontalLayout {
                                    padding-left: 32px;
                                    padding-bottom: 6px;
                                    SectionTitle {
                                        text: "Songs";
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    for s[i] in root.search-songs: SongLine {
                                        song: s;
                                        number: i + 1;
                                        thumb: true;
                                        show-album: false;
                                        picture: root.art(s.art, 0, root.covers-rev);
                                        play => { root.song(2, i, 0); }
                                        next => { root.song(2, i, 1); }
                                        later => { root.song(2, i, 2); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.view == 2 || root.view == 3 || root.view == 4: Fade {
                    VerticalLayout {
                        Heading {
                            title: root.view == 2 ? "Albums" : root.view == 3 ? "Artists" : "Playlists";
                        }
                        Grid {
                            vertical-stretch: 1;
                            cards: root.view == 2 ? root.albums : root.view == 3 ? root.artists : root.playlists;
                            round: root.view == 3;
                            rev: root.covers-rev;
                            art(a, s, r) => { return root.art(a, s, r); }
                            open(c) => {
                                if root.view == 2 {
                                    root.open-album(c.id);
                                } else if root.view == 3 {
                                    root.open-artist(c.id);
                                } else {
                                    root.open-playlist(c.id);
                                }
                            }
                            play(c) => {
                                if root.view == 2 {
                                    root.play-album(c.id);
                                } else if root.view == 4 {
                                    root.play-playlist(c.id);
                                }
                            }
                        }
                    }
                }

                if root.view == 5: Fade {
                    VerticalLayout {
                        Heading {
                            title: "Songs";
                        }
                        HorizontalLayout {
                            vertical-stretch: 1;
                            padding-left: 24px;
                            padding-right: 16px;
                            ListView {
                                for s[i] in root.songs: SongLine {
                                    song: s;
                                    number: i + 1;
                                    play => { root.song(1, i, 0); }
                                    next => { root.song(1, i, 1); }
                                    later => { root.song(1, i, 2); }
                                }
                            }
                        }
                        if root.more-songs: HorizontalLayout {
                            padding: 12px;
                            padding-bottom: 92px;
                            alignment: center;
                            Capsule {
                                text: "More Songs";
                                ink: Theme.fill;
                                label: Theme.text;
                                clicked => { root.more(); }
                            }
                        }
                    }
                }

                // An album, an artist or a playlist, as iOS 27 draws its artist pages: the picture dissolves
                // into the page, and the page takes its colour.
                if root.view == 6: Fade {
                    Rectangle {
                        // An artist: the picture across the page's whole width, drifting up slower than the page
                        // as it scrolls, and dissolving into the page's colour.
                        if root.page-kind == 1: Rectangle {
                            y: max(-self.height, page-flick.content-y * 0.45);
                            x: root.native-sidebar ? -Theme.side-w : 0;
                            width: parent.width - self.x;
                            height: max(420px, root.height * 0.64);
                            opacity: 1 + max(-0.8, page-flick.content-y / self.height);
                            clip: true;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.art(root.page-art, 2, root.covers-rev);
                                image-fit: cover;
                                opacity: self.source.width > 0 ? 1 : 0;
                                animate opacity { duration: 400ms; easing: ease-out; }
                            }
                            Rectangle {
                                background: @linear-gradient(180deg, root.page-bg.with-alpha(0) 0%, root.page-bg.with-alpha(0) 45%, root.page-bg.with-alpha(0.7) 78%, root.page-bg 100%);
                            }
                        }

                        page-flick := Flickable {
                            content-height: detail.preferred-height;
                            detail := VerticalLayout {
                                width: parent.width;
                                padding-left: 32px;
                                padding-right: 32px;
                                padding-top: 60px;
                                padding-bottom: 100px;
                                spacing: 26px;
                                // An artist: the name and the play button over the bottom of the picture.
                                if root.page-kind == 1: VerticalLayout {
                                    spacing: 16px;
                                    Rectangle {
                                        height: max(420px, root.height * 0.64) - 60px - 170px;
                                    }
                                    Text {
                                        text: root.page-title;
                                        color: white;
                                        font-size: 44px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 18px;
                                        IconButton {
                                            y: (parent.height - self.height) / 2;
                                            path: Icons.shuffle;
                                            size: 42px;
                                            icon: 18px;
                                            ink: white;
                                            base: #ffffff2b;
                                            clicked => { root.play-page(true); }
                                        }
                                        Rectangle {
                                            width: 64px;
                                            height: 64px;
                                            border-radius: 32px;
                                            background: white;
                                            drop-shadow-blur: 18px;
                                            drop-shadow-color: #00000055;
                                            transform-scale: pt.pressed ? 0.92 : (pt.has-hover ? 1.04 : 1);
                                            animate transform-scale { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                                            Icon {
                                                x: (parent.width - self.width) / 2 + 2px;
                                                path: Icons.play;
                                                solid: true;
                                                colour: #111111;
                                                width: 26px;
                                                height: 26px;
                                            }
                                            pt := TouchArea {
                                                clicked => { root.play-page(false); }
                                            }
                                        }
                                        Rectangle {
                                            width: 42px;
                                        }
                                    }
                                }
                                // An album or a playlist: the artwork beside its title, as the Mac lays them out.
                                if root.page-kind != 1: HorizontalLayout {
                                    spacing: 28px;
                                    alignment: start;
                                    Art {
                                        width: 270px;
                                        height: 270px;
                                        border-radius: 10px;
                                        shadow: true;
                                        source: root.art(root.page-art, 1, root.covers-rev);
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Rectangle {
                                            height: 64px;
                                        }
                                        Text {
                                            text: root.page-title;
                                            color: Theme.text;
                                            font-size: 26px;
                                            font-weight: 700;
                                            wrap: word-wrap;
                                        }
                                        if root.page-sub != "": Text {
                                            text: root.page-sub;
                                            color: root.page-accent;
                                            font-size: 26px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.page-caption;
                                            color: Theme.dim;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                        Rectangle {
                                            vertical-stretch: 1;
                                        }
                                        // Shuffle in a circle, a wide Play, and add to the queue: quiet grey, in the accent, as Music has them.
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            IconButton {
                                                y: (parent.height - self.height) / 2;
                                                path: Icons.shuffle;
                                                size: 34px;
                                                icon: 18px;
                                                ink: root.page-accent;
                                                base: Theme.fill;
                                                clicked => { root.play-page(true); }
                                            }
                                            Capsule {
                                                text: "Play";
                                                icon: Icons.play;
                                                solid-icon: true;
                                                ink: Theme.fill;
                                                label: root.page-accent;
                                                clicked => { root.play-page(false); }
                                            }
                                            IconButton {
                                                y: (parent.height - self.height) / 2;
                                                path: Icons.plus;
                                                size: 34px;
                                                icon: 18px;
                                                ink: root.page-accent;
                                                base: Theme.fill;
                                                clicked => { root.page-later(); }
                                            }
                                        }
                                    }
                                }
                                if root.page-kind == 1 && root.page-albums.length > 0: SectionTitle {
                                    text: "Albums";
                                }
                                if root.page-kind == 1 && root.page-albums.length > 0: Grid {
                                    height: self.content-height;
                                    pad: 0;
                                    bottom: 0;
                                    interactive: false;
                                    cards: root.page-albums;
                                    rev: root.covers-rev;
                                    art(a, s, r) => { return root.art(a, s, r); }
                                    open(c) => { root.open-album(c.id); }
                                    play(c) => { root.play-album(c.id); }
                                }
                                // Only the rows on screen (and a few either side) are made: a playlist of thousands
                                // opens as fast as one of ten.
                                song-rows := Rectangle {
                                    property <length> row-h: root.page-kind == 2 ? 56px : 44px;
                                    property <length> seen-from: -page-flick.content-y - self.y - 400px;
                                    property <length> seen-to: -page-flick.content-y - self.y + page-flick.height + 400px;
                                    height: root.page-songs.length * self.row-h;
                                    for s[i] in root.page-songs: Rectangle {
                                        y: i * song-rows.row-h;
                                        height: song-rows.row-h;
                                        if (i + 1) * song-rows.row-h > song-rows.seen-from && i * song-rows.row-h < song-rows.seen-to: SongLine {
                                            width: parent.width;
                                            song: s;
                                            number: i + 1;
                                            ink: root.page-accent;
                                            show-album: root.page-kind == 2;
                                            thumb: root.page-kind == 2;
                                            picture: root.page-kind == 2 ? root.art(s.art, 0, root.covers-rev) : root.art("", 0, 0);
                                            play => { root.song(0, i, 0); }
                                            next => { root.song(0, i, 1); }
                                            later => { root.song(0, i, 2); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.view == 8: Fade {
                    Flickable {
                        content-height: prefs.preferred-height;
                        prefs := VerticalLayout {
                            width: parent.width;
                            padding-bottom: 100px;
                            // The title and the tabs centred over one narrow column, as the Mac's own
                            // settings windows have them.
                            Text {
                                text: "Settings";
                                color: Theme.text;
                                font-size: 22px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                height: 96px;
                                vertical-alignment: bottom;
                            }
                            HorizontalLayout {
                                alignment: center;
                                padding-top: 16px;
                                padding-bottom: 8px;
                                Rectangle {
                                    height: 30px;
                                    width: tabs.preferred-width + 6px;
                                    border-radius: 15px;
                                    background: Theme.fill;
                                    tabs := HorizontalLayout {
                                        x: 3px;
                                        padding-top: 3px;
                                        padding-bottom: 3px;
                                        spacing: 2px;
                                        for t[i] in ["General", "Playback", "Sound", "Storage"]: Rectangle {
                                            width: label.preferred-width + 32px;
                                            border-radius: 12px;
                                            background: root.settings-tab == i ? #ffffff26 : (ta.has-hover ? Theme.hover : transparent);
                                            animate background { duration: 160ms; easing: ease-out; }
                                            label := Text {
                                                text: t;
                                                color: Theme.text;
                                                font-size: 13px;
                                                font-weight: root.settings-tab == i ? 600 : 400;
                                            }
                                            ta := TouchArea {
                                                clicked => { root.settings-tab-chosen(i); }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 32px;
                                padding-right: 32px;
                                alignment: center;
                                VerticalLayout {
                                    width: min(560px, parent.width - 64px);
                                    for r in root.settings: VerticalLayout {
                                        if r.kind == 0: Text {
                                            text: r.title;
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 700;
                                            height: 44px;
                                            vertical-alignment: bottom;
                                        }
                                        if r.kind == 0: Rectangle {
                                            height: 8px;
                                        }
                                        if r.kind != 0: Rectangle {
                                            background: #ffffff0c;
                                            border-top-left-radius: r.first ? 10px : 0;
                                            border-top-right-radius: r.first ? 10px : 0;
                                            border-bottom-left-radius: r.last ? 10px : 0;
                                            border-bottom-right-radius: r.last ? 10px : 0;
                                            min-height: 44px;
                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 12px;
                                                padding-top: 8px;
                                                padding-bottom: 8px;
                                                spacing: 12px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 1;
                                                    Text {
                                                        text: r.title;
                                                        color: Theme.text;
                                                        font-size: 13px;
                                                    }
                                                    if r.detail != "" && r.kind != 4: Text {
                                                        text: r.detail;
                                                        color: Theme.dim;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                                if r.kind == 1: Switch {
                                                    y: (parent.height - self.height) / 2;
                                                    checked: r.on;
                                                    toggled => { root.setting-toggled(r.name, self.checked); }
                                                }
                                                if r.kind == 2: ComboBox {
                                                    y: (parent.height - self.height) / 2;
                                                    width: 190px;
                                                    model: r.options;
                                                    current-index: r.chosen;
                                                    selected => { root.setting-chosen(r.name, self.current-index); }
                                                }
                                                if r.kind == 3: Button {
                                                    y: (parent.height - self.height) / 2;
                                                    text: r.button;
                                                    clicked => { root.setting-action(r.name); }
                                                }
                                                if r.kind == 4: Text {
                                                    text: r.detail;
                                                    color: Theme.dim;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            if !r.last: Rectangle {
                                                x: 14px;
                                                y: parent.height - 1px;
                                                width: parent.width - 14px;
                                                height: 1px;
                                                background: Theme.hairline;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.loading: Text {
                    text: "Loading…";
                    color: Theme.dim;
                }
                if root.failed != "" && !root.loading: Text {
                    width: 60%;
                    text: root.failed;
                    color: Theme.dim;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                TitleStrip {
                    y: 0;
                    width: parent.width;
                    drag => { root.drag-window(); }
                    zoom => { root.zoom-window(); }
                }

                // A note for a few seconds, over the page's top.
                Glass {
                    x: (parent.width - self.width) / 2;
                    y: root.note != "" ? 14px : -50px;
                    animate y { duration: 260ms; easing: ease-out; }
                    width: min(parent.width - 40px, toast.preferred-width + 32px);
                    height: 32px;
                    radius: 16px;
                    toast := Text {
                        text: root.note;
                        color: root.note-error ? #ff453a : Theme.text;
                        overflow: elide;
                    }
                }



                // The player: a glass capsule floating over the page's bottom, as Tahoe's Music has it.
                if !root.native-player: Glass {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 12px;
                    width: min(parent.width - 32px, 720px);
                    height: 54px;
                    radius: 27px;
                    density: 0.9;
                    PlayerControls {
                        has-song: root.has-song;
                        now-title: root.now-title;
                        now-artist: root.now-artist;
                        now-album: root.now-album;
                        now-art: root.now-art;
                        playing: root.playing;
                        position-ms: root.position-ms;
                        duration-ms: root.duration-ms;
                        shuffle: root.shuffle;
                        repeat: root.repeat;
                        volume: root.volume;
                        inspector: root.inspector;
                        covers-rev: root.covers-rev;
                        art(a, s, r) => { return root.art(a, s, r); }
                        toggle => { root.toggle(); }
                        next => { root.next(); }
                        previous => { root.previous(); }
                        seek(v) => { root.seek(v); }
                        set-volume(v) => { root.set-volume(v); }
                        toggle-shuffle => { root.toggle-shuffle(); }
                        cycle-repeat => { root.cycle-repeat(); }
                        set-inspector(i) => { root.inspector = i; }
                        open-full => {
                            if root.has-song {
                                root.full-player = true;
                            }
                        }
                    }
                }
            }

            // The panel on the right, docked to the window's edge as Music's is: the lyrics, sung line by line,
            // or what plays next.
            Rectangle {
                x: root.inspector != 0 ? parent.width - Theme.panel-w : parent.width;
                animate x { duration: 300ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                width: Theme.panel-w;
                height: parent.height;
                background: Theme.panel;
                clip: true;
                Rectangle {
                    x: 0;
                    width: 1px;
                    background: #0000004d;
                }
                TitleStrip {
                    y: 0;
                    drag => { root.drag-window(); }
                    zoom => { root.zoom-window(); }
                }
                if root.shown-panel == 2 && root.lyrics-lines.length == 0: Text {
                    x: 24px;
                    width: parent.width - 48px;
                    text: root.lyrics-note != "" ? root.lyrics-note : "No lyrics";
                    color: Theme.dim;
                    font-size: 15px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.shown-panel == 2 && root.lyrics-lines.length > 0: lyric-flick := Flickable {
                    y: 16px;
                    height: parent.height - 16px;
                    content-height: sung.preferred-height;
                    animate content-y { duration: 560ms; easing: cubic-bezier(0.25, 0.8, 0.3, 1); }
                    sung := VerticalLayout {
                        width: parent.width;
                        padding-left: 22px;
                        padding-right: 22px;
                        padding-top: 40px;
                        padding-bottom: 400px;
                        spacing: 22px;
                        for line[i] in root.lyrics-lines: Text {
                            property <bool> lit: i == root.lyrics-active;
                            changed lit => {
                                if self.lit {
                                    lyric-flick.content-y = -max(0, min(self.y - lyric-flick.height * 0.1, lyric-flick.content-height - lyric-flick.height));
                                }
                            }
                            text: line;
                            wrap: word-wrap;
                            font-size: 22px;
                            font-weight: 700;
                            color: !root.lyrics-synced || self.lit ? #ffffffeb : #ffffff42;
                            animate color { duration: 420ms; easing: ease-out; }
                        }
                        if root.lyrics-note != "": Text {
                            text: root.lyrics-note;
                            color: Theme.faint;
                            font-size: 11px;
                        }
                    }
                }
                if root.shown-panel == 1: QueueView {
                    y: 30px;
                    height: parent.height - 30px - 76px;
                    queue: root.queue;
                    from: root.queue-from;
                    autoplay: root.autoplay;
                    automix: root.automix;
                    covers-rev: root.covers-rev;
                    art(a, s, r) => { return root.art(a, s, r); }
                    jump(i) => { root.jump(i); }
                    clear => { root.clear-queue(); }
                    set-autoplay(on) => { root.setting-toggled("autoFill", on); }
                    set-automix(on) => { root.setting-toggled("autoMix", on); }
                }
            }

            // The sidebar: full height from the window's edge, the system's sidebar material through it
            // (macOS), a hairline between it and the page, the traffic lights at its top.
            if !root.native-sidebar: Rectangle {
                x: 0;
                y: 0;
                width: Theme.side-w;
                height: parent.height;
                background: root.vibrancy ? #1e1e1e59 : #262628;
                // A page in its picture's colours runs under the sidebar, which takes a little of it.
                Rectangle {
                    background: root.view == 6 && root.page-kind == 1 ? root.page-bg.with-alpha(0.5) : root.page-bg.with-alpha(0);
                    animate background { duration: 450ms; easing: ease-in-out; }
                }
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: #000000a0;
                }
                SidebarContent {
                    view: root.view;
                    page-kind: root.page-kind;
                    page-id: root.page-id;
                    playlists: root.playlists;
                    server: root.server;
                    covers-rev: root.covers-rev;
                    inset-top: root.inset-top;
                    art(a, s, r) => { return root.art(a, s, r); }
                    go(v) => { root.go(v); }
                    open-playlist(id) => { root.open-playlist(id); }
                    drag-window => { root.drag-window(); }
                    zoom-window => { root.zoom-window(); }
                }
            }
        }

        // ---- Now Playing, over the whole window, as Music has it ----
        // The song's own colours behind everything; the artwork and the controls on the left; on the right the
        // lyrics (the line sung sharp, the rest soft: the compositor blurs them, glass.wgsl) or what plays next.

        Rectangle {
            opacity: root.full-player ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 300ms; easing: ease-out; }
            background: root.wash-tint;
            Image {
                width: 100%;
                height: 100%;
                source: root.wash-a;
                image-fit: cover;
                opacity: root.wash-on-b ? 0 : 1;
                animate opacity { duration: 800ms; easing: ease-in-out; }
            }
            Image {
                width: 100%;
                height: 100%;
                source: root.wash-b;
                image-fit: cover;
                opacity: root.wash-on-b ? 1 : 0;
                animate opacity { duration: 800ms; easing: ease-in-out; }
            }
            Rectangle {
                background: @linear-gradient(180deg, #0000002e 0%, #00000014 50%, #0000003d 100%);
            }
            // Swallows the clicks meant for the page underneath.
            TouchArea { }
            TitleStrip {
                y: 0;
                drag => { root.drag-window(); }
                zoom => { root.zoom-window(); }
            }
            // Back to the window, next to the traffic lights.
            Rectangle {
                x: 90px;
                y: 10px;
                width: 40px;
                height: 32px;
                border-radius: 16px;
                background: #ffffff1f;
                border-width: 1px;
                border-color: #ffffff26;
                Icon {
                    path: Icons.close;
                    colour: white;
                    weight: 2px;
                    width: 14px;
                    height: 14px;
                }
                TouchArea {
                    clicked => { root.full-player = false; }
                }
            }
            // The volume, in a glass pill at the top right.
            Rectangle {
                x: parent.width - self.width - 12px;
                y: 10px;
                width: 176px;
                height: 32px;
                border-radius: 16px;
                background: #ffffff1f;
                border-width: 1px;
                border-color: #ffffff26;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 10px;
                    Bar {
                        y: (parent.height - self.height) / 2;
                        horizontal-stretch: 1;
                        thin: 5px;
                        thick: 7px;
                        fill: white;
                        track: #ffffff40;
                        value: root.volume;
                        moved(v) => { root.set-volume(v); }
                        done(v) => { root.set-volume(v); }
                    }
                    Icon {
                        y: (parent.height - self.height) / 2;
                        path: Icons.speaker;
                        colour: white;
                        width: 16px;
                        height: 16px;
                    }
                }
            }

            // The artwork and the controls: centred in the window with nothing beside them, in the left half
            // with the lyrics or the queue.
            property <length> side: min(460px, root.height - 330px, (root.full-panel != 0 ? root.width / 2 : root.width) - 120px);
            full-art := VerticalLayout {
                x: (root.full-panel != 0 ? root.width / 2 : root.width) / 2 - parent.side / 2;
                animate x { duration: 380ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                y: (root.height - self.preferred-height) / 2 + (root.full-player ? 0 : 30px);
                animate y { duration: 420ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                width: parent.side;
                height: self.preferred-height;
                spacing: 0;
                Art {
                    width: parent.width;
                    height: self.width;
                    border-radius: 8px;
                    shadow: true;
                    drop-shadow-blur: 40px;
                    drop-shadow-offset-y: 18px;
                    source: root.art(root.now-art, 1, root.covers-rev);
                    transform-scale: root.playing ? 1 : 0.9;
                    animate transform-scale { duration: 500ms; easing: cubic-bezier(0.3, 1.35, 0.6, 1); }
                }
                Rectangle {
                    height: 26px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text {
                            text: root.now-title;
                            color: white;
                            font-size: 16px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: root.now-artist + (root.now-album != "" ? " — " + root.now-album : "");
                            color: #ffffffa6;
                            font-size: 14px;
                            overflow: elide;
                        }
                    }
                }
                Rectangle {
                    height: 20px;
                }
                Rectangle {
                    height: 14px;
                    property <int> dragged: -1;
                    Bar {
                        width: 100%;
                        thin: 5px;
                        thick: 8px;
                        fill: #ffffffd9;
                        track: #ffffff33;
                        value: root.duration-ms > 0 ? (parent.dragged >= 0 ? parent.dragged : root.position-ms) / root.duration-ms : 0;
                        moved(v) => { parent.dragged = v * root.duration-ms; }
                        done(v) => {
                            parent.dragged = -1;
                            root.seek(v);
                        }
                    }
                }
                HorizontalLayout {
                    padding-top: 4px;
                    Text {
                        text: root.clock(root.position-ms);
                        color: #ffffff8c;
                        font-size: 10px;
                    }
                    Text {
                        text: "-" + root.clock(root.duration-ms - root.position-ms);
                        color: #ffffff8c;
                        font-size: 10px;
                        horizontal-alignment: right;
                    }
                }
                Rectangle {
                    height: 16px;
                }
                HorizontalLayout {
                    alignment: space-between;
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        path: Icons.shuffle;
                        lit: root.shuffle;
                        ink: #ffffffcc;
                        icon: 19px;
                        size: 36px;
                        clicked => { root.toggle-shuffle(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        path: Icons.previous;
                        solid: true;
                        ink: white;
                        size: 50px;
                        icon: 34px;
                        clicked => { root.previous(); }
                    }
                    PlayPause {
                        y: (parent.height - self.height) / 2;
                        playing: root.playing;
                        ink: white;
                        size: 56px;
                        icon: 40px;
                        clicked => { root.toggle(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        path: Icons.next;
                        solid: true;
                        ink: white;
                        size: 50px;
                        icon: 34px;
                        clicked => { root.next(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        path: Icons.repeat;
                        lit: root.repeat != 0;
                        ink: #ffffffcc;
                        icon: 19px;
                        size: 36px;
                        clicked => { root.cycle-repeat(); }
                    }
                }
            }

            // The lyrics: big, the line sung at a fixed height and sharp, the rest soft and dim.
            if root.full-panel == 2 && root.lyrics-lines.length == 0: Text {
                x: root.width / 2 + 20px;
                width: root.width / 2 - 100px;
                text: root.lyrics-note != "" ? root.lyrics-note : "No lyrics for this song";
                color: #ffffff8c;
                font-size: 26px;
                font-weight: 700;
                wrap: word-wrap;
            }
            // Kept inside the part the compositor blurs (clear of the pills above and below).
            if root.full-panel == 2 && root.lyrics-lines.length > 0: full-lyrics := Flickable {
                x: root.width / 2 + 20px;
                width: root.width / 2 - 140px;
                y: 48px;
                height: root.height - 48px - 56px;
                content-height: full-sung.preferred-height;
                animate content-y { duration: 640ms; easing: cubic-bezier(0.25, 0.8, 0.3, 1); }
                full-sung := VerticalLayout {
                    width: parent.width;
                    padding-top: root.height * 0.36 - 48px;
                    padding-bottom: root.height;
                    spacing: 36px;
                    for line[i] in root.lyrics-lines: Text {
                        property <bool> lit: i == root.lyrics-active;
                        changed lit => {
                            if self.lit {
                                full-lyrics.content-y = -(self.y - (root.height * 0.36 - 48px));
                                root.full-lyric-h = self.height;
                            }
                        }
                        text: line;
                        wrap: word-wrap;
                        font-size: 44px;
                        font-weight: 700;
                        color: !root.lyrics-synced || self.lit ? white : #ffffff5c;
                        animate color { duration: 500ms; easing: ease-out; }
                    }
                }
            }
            if root.full-panel == 1: QueueView {
                x: root.width / 2 + 10px;
                width: root.width / 2 - 70px;
                y: 84px;
                height: root.height - 84px - 70px;
                wide: true;
                queue: root.queue;
                from: root.queue-from;
                autoplay: root.autoplay;
                automix: root.automix;
                covers-rev: root.covers-rev;
                art(a, s, r) => { return root.art(a, s, r); }
                jump(i) => { root.jump(i); }
                clear => { root.clear-queue(); }
                set-autoplay(on) => { root.setting-toggled("autoFill", on); }
                set-automix(on) => { root.setting-toggled("autoMix", on); }
            }

            // Lyrics and the queue, in a glass pill at the bottom right.
            Rectangle {
                x: parent.width - self.width - 14px;
                y: parent.height - self.height - 14px;
                width: 80px;
                height: 36px;
                border-radius: 18px;
                background: #ffffff1f;
                border-width: 1px;
                border-color: #ffffff26;
                HorizontalLayout {
                    padding: 3px;
                    spacing: 4px;
                    for b[i] in [2, 1]: Rectangle {
                        width: 34px;
                        border-radius: 15px;
                        background: root.full-panel == b ? white : transparent;
                        animate background { duration: 160ms; easing: ease-out; }
                        Icon {
                            path: b == 2 ? Icons.lyrics : Icons.queue;
                            colour: root.full-panel == b ? #1c1c1e : white;
                            width: 19px;
                            height: 19px;
                        }
                        TouchArea {
                            clicked => { root.full-panel = root.full-panel == b ? 0 : b; }
                        }
                    }
                }
            }
        }
    }
}

// The player on macOS: a borderless window of its own, kept over the bottom of the main window's page,
// with the system's Liquid Glass (NSGlassEffectView) behind it (glass.rs): the page scrolls under real glass.
export component PlayerBar inherits Window {
    title: "nori player";
    no-frame: true;
    background: transparent;
    default-font-size: 13px;
    default-font-family: root.font;
    in property <string> font: "Inter";
    in property <bool> has-song;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-art;
    in property <bool> playing;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> volume: 1;
    in property <int> inspector;
    in property <int> covers-rev;
    pure callback art(string, int, int) -> image;
    callback toggle();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback set-inspector(int);
    callback open-full();
    // The pane the glass is seen as, over a plain page as over covers: a faint light and a thin rim, lit
    // along the top as the system's glass is. The glass itself (behind) does the blurring.
    Rectangle {
        border-radius: self.height / 2;
        background: #ffffff05;
        border-width: 1px;
        border-color: @linear-gradient(180deg, #ffffff0f 0%, #ffffff05 50%, #ffffff08 100%);
    }
    PlayerControls {
        has-song: root.has-song;
        now-title: root.now-title;
        now-artist: root.now-artist;
        now-album: root.now-album;
        now-art: root.now-art;
        playing: root.playing;
        position-ms: root.position-ms;
        duration-ms: root.duration-ms;
        shuffle: root.shuffle;
        repeat: root.repeat;
        volume: root.volume;
        inspector: root.inspector;
        covers-rev: root.covers-rev;
        art(a, s, r) => { return root.art(a, s, r); }
        toggle => { root.toggle(); }
        next => { root.next(); }
        previous => { root.previous(); }
        seek(v) => { root.seek(v); }
        set-volume(v) => { root.set-volume(v); }
        toggle-shuffle => { root.toggle-shuffle(); }
        cycle-repeat => { root.cycle-repeat(); }
        set-inspector(i) => { root.set-inspector(i); }
        open-full => { root.open-full(); }
    }
}

// The sidebar on macOS: rendered by a window of its own whose view is moved into the system's Liquid
// Glass over the main window's page (glass.rs), so the glass takes its colour and its light from the page
// under it, and the rows stay sharp on top.
export component SidebarWindow inherits Window {
    title: "nori sidebar";
    no-frame: true;
    // A pane of its own over any page, as Music's sidebar is: a slight shade over the glass, and a hairline
    // where the page starts.
    Rectangle {
        background: #0000002e;
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: #ffffff09;
    }
    background: transparent;
    default-font-size: 13px;
    default-font-family: root.font;
    in property <string> font: "Inter";
    in property <int> view;
    in property <int> page-kind;
    in property <string> page-id;
    in property <[Card]> playlists;
    in property <string> server;
    in property <int> covers-rev;
    in property <length> inset-top;
    pure callback art(string, int, int) -> image;
    callback go(int);
    callback open-playlist(string);
    callback drag-window();
    callback zoom-window();
    SidebarContent {
        view: root.view;
        page-kind: root.page-kind;
        page-id: root.page-id;
        playlists: root.playlists;
        server: root.server;
        covers-rev: root.covers-rev;
        inset-top: root.inset-top;
        art(a, s, r) => { return root.art(a, s, r); }
        go(v) => { root.go(v); }
        open-playlist(id) => { root.open-playlist(id); }
        drag-window => { root.drag-window(); }
        zoom-window => { root.zoom-window(); }
    }
}
