// Opens an artist's or an album's page, from wherever its name shows (app.rs answers).
export global Go {
    callback artist(string);
    callback album(string);
}

// An artist's or album's name that opens its page: a pointer and an underline under it while hovered.
component Link inherits Text {
    in property <string> artist;
    in property <string> album;
    property <length> size: root.font-size > 0 ? root.font-size : 13px;
    lt := TouchArea {
        enabled: root.artist != "" || root.album != "";
        mouse-cursor: self.enabled ? pointer : default;
        clicked => {
            if root.artist != "" {
                Go.artist(root.artist);
            } else {
                Go.album(root.album);
            }
        }
    }
    if lt.has-hover && lt.enabled: Rectangle {
        x: root.horizontal-alignment == TextHorizontalAlignment.center ? (root.width - self.width) / 2 : 0;
        y: root.height / 2 + root.size * 0.55;
        width: min(root.width, root.preferred-width);
        height: 1px;
        background: root.color;
    }
}

// A song's artists as links: each name its own where the line names them one by one, else the line opens
// its one artist, or lists its several artists to choose from.
component ArtistLine inherits HorizontalLayout {
    in property <string> text;
    in property <string> artist;
    in property <Credits> credits;
    in property <brush> color;
    in property <length> font-size: 13px;
    alignment: start;
    for p in root.credits.pieces: Link {
        text: p.text;
        artist: p.id;
        color: root.color;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
        // Only names elide; what stands between them stays whole.
        min-width: p.id == "" ? self.preferred-width : 0;
    }
    if root.credits.pieces.length == 0 && root.credits.choices.length == 0: Link {
        text: root.text;
        artist: root.artist;
        color: root.color;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.credits.choices.length > 0: Text {
        text: root.text;
        color: root.color;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { list.show(); }
        }
        if ta.has-hover: Rectangle {
            y: parent.height / 2 + root.font-size * 0.55;
            width: min(parent.width, parent.preferred-width);
            height: 1px;
            background: root.color;
        }
        list := PopupWindow {
            x: 0;
            y: parent.height + 4px;
            width: 220px;
            close-policy: close-on-click-outside;
            Rectangle {
                border-radius: 8px;
                background: #2c2a2cf5;
                border-width: 1px;
                border-color: #ffffff1a;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000080;
                VerticalLayout {
                    padding: 4px;
                    for c in root.credits.choices: Rectangle {
                        height: 26px;
                        border-radius: 5px;
                        background: ca.has-hover ? Theme.accent : transparent;
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: c.text;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        ca := TouchArea {
                            clicked => {
                                list.close();
                                Go.artist(c.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

component Icon inherits Path {
    in property <string> path;
    in property <brush> colour: Theme.text;
    in property <bool> solid;
    in property <length> weight: 1.7px;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.path;
    fill: root.solid ? root.colour : transparent;
    stroke: root.solid ? transparent : root.colour;
    stroke-width: root.weight;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// Glass, as Tahoe draws it where it cannot see through: a dark tinted pane, a thin rim that catches the
// light along its top, and a soft shadow under it.
component Glass inherits Rectangle {
    in property <length> radius: 18px;
    in property <color> tint: #2a2a2d;
    in property <float> density: 0.88;
    in property <bool> lifted: true;
    border-radius: root.radius;
    background: root.tint.with-alpha(root.density);
    border-width: 1px;
    border-color: @linear-gradient(180deg, #ffffff2e 0%, #ffffff0f 35%, #ffffff0a 100%);
    drop-shadow-blur: root.lifted ? 24px : 0;
    drop-shadow-offset-y: root.lifted ? 8px : 0;
    drop-shadow-color: #0000006b;
}

// A borderless button: an icon that dims when not lit, and a round hover under it.
component IconButton inherits Rectangle {
    in property <string> path;
    in property <bool> solid;
    in property <bool> lit;
    in property <bool> quiet;
    in property <length> size: 32px;
    in property <length> icon: 19px;
    in property <color> ink: Theme.text;
    in property <color> base: transparent;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: touch.has-hover ? Theme.hover : root.base;
    animate background { duration: 160ms; easing: ease-out; }
    Icon {
        path: root.path;
        solid: root.solid;
        colour: root.lit ? Theme.accent : (root.quiet ? Theme.dim : root.ink);
        animate colour { duration: 200ms; }
        width: root.icon;
        height: root.icon;
        transform-scale: touch.pressed ? 0.86 : 1;
        animate transform-scale { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Play and pause: the two glyphs cross-fade and scale into each other, as Apple's do.
component PlayPause inherits Rectangle {
    in property <bool> playing;
    in property <length> size: 36px;
    in property <length> icon: 24px;
    in property <color> ink: Theme.text;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 160ms; easing: ease-out; }
    Rectangle {
        transform-scale: touch.pressed ? 0.86 : 1;
        animate transform-scale { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        Icon {
            path: Icons.play;
            solid: true;
            colour: root.ink;
            width: root.icon;
            height: root.icon;
            opacity: root.playing ? 0 : 1;
            transform-scale: root.playing ? 0.5 : 1;
            animate opacity, transform-scale { duration: 220ms; easing: ease-out; }
        }
        Icon {
            path: Icons.pause;
            solid: true;
            colour: root.ink;
            width: root.icon;
            height: root.icon;
            opacity: root.playing ? 1 : 0;
            transform-scale: root.playing ? 1 : 0.5;
            animate opacity, transform-scale { duration: 220ms; easing: ease-out; }
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A page as it comes on screen: it fades in and rises the last few points into place.
component Fade inherits Rectangle {
    property <bool> shown;
    opacity: self.shown ? 1 : 0;
    y: self.shown ? 0 : 10px;
    animate opacity { duration: 240ms; easing: ease-out; }
    animate y { duration: 320ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
    init => { self.shown = true; }
}

// Apple's filled capsule buttons ("Play", "Shuffle").
component Capsule inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> solid-icon;
    in property <color> ink: Theme.accent;
    in property <color> label: white;
    callback clicked;
    height: 34px;
    width: max(124px, row.preferred-width + 40px);
    border-radius: self.height / 2;
    background: root.ink;
    opacity: touch.pressed ? 0.75 : 1;
    row := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            path: root.icon;
            solid: root.solid-icon;
            colour: root.label;
            weight: 2.2px;
            width: 13px;
            height: 13px;
        }
        Text {
            text: root.text;
            color: root.label;
            font-weight: 600;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A thin bar that can be dragged: the seek bar and the volume. `value` is 0 to 1; `done` says where it was
// let go, `moved` where it is while held.
component Bar inherits Rectangle {
    in property <float> value;
    in property <length> thin: 3px;
    in property <length> thick: 5px;
    in property <color> fill: #ffffffcc;
    in property <color> track: #ffffff24;
    out property <bool> hot: touch.has-hover || root.held >= 0;
    callback moved(float);
    callback done(float);
    property <float> held: -1;
    property <float> shown: root.held >= 0 ? root.held : max(0, min(1, root.value));
    height: 12px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.hot ? root.thick : root.thin;
        animate height { duration: 120ms; easing: ease-out; }
        border-radius: self.height / 2;
        background: root.track;
        clip: true;
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            background: root.fill;
        }
    }
    touch := TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.held = max(0, min(1, self.mouse-x / root.width));
                root.moved(root.held);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.held >= 0 {
                root.done(root.held);
                root.held = -1;
            }
        }
        moved => {
            if self.pressed {
                root.held = max(0, min(1, self.mouse-x / root.width));
                root.moved(root.held);
            }
        }
    }
}

// Artwork: rounded, with a hairline edge so dark covers keep their shape on the dark ground.
component Art inherits Rectangle {
    in property <image> source;
    in property <bool> shadow;
    border-radius: 6px;
    background: #2e2e30;
    drop-shadow-blur: root.shadow ? 20px : 0;
    drop-shadow-offset-y: root.shadow ? 8px : 0;
    drop-shadow-color: #00000070;
    Icon {
        path: Icons.note;
        colour: #ffffff38;
        width: parent.width * 0.34;
        height: self.width;
        weight: 1.4px;
        visible: root.source.width == 0;
    }
    Rectangle {
        border-radius: root.border-radius;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            source: root.source;
            image-fit: cover;
        }
    }
    Rectangle {
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: #ffffff12;
    }
}

// An album, artist or playlist in a grid or on a shelf: the artwork, and the title and the artist under
// it. The pointer over it brings a play button onto the artwork, as Music does.
component CardView inherits Rectangle {
    in property <Card> card;
    in property <image> picture;
    in property <bool> round;
    in property <bool> playable: !root.round;
    in property <length> side: 176px;
    callback open;
    callback play;
    // Plays it and starts a jam (its menu, while jams are on).
    callback jam;
    width: root.side;
    height: root.side + 46px;
    Art {
        y: 0;
        width: root.side;
        height: root.side;
        source: root.picture;
        border-radius: root.round ? self.width / 2 : 8px;
        Rectangle {
            border-radius: parent.border-radius;
            background: touch.has-hover ? #00000030 : transparent;
            animate background { duration: 180ms; easing: ease-out; }
        }
    }
    Text {
        y: root.side + 8px;
        width: root.side;
        text: root.card.title;
        color: Theme.text;
        font-size: 13px;
        overflow: elide;
        horizontal-alignment: root.round ? center : left;
    }
    touch := TouchArea {
        clicked => { root.open(); }
    }
    Link {
        y: root.side + 25px;
        width: root.side;
        text: root.card.sub;
        artist: root.card.sub-artist;
        color: Theme.dim;
        font-size: 13px;
        overflow: elide;
        horizontal-alignment: root.round ? center : left;
    }
    // Over the TouchArea, which would take the right press too: the menu area answers only that.
    ContextMenuArea {
        enabled: root.playable && Jam.on && !Jam.hosting;
        Menu {
            MenuItem {
                title: "Play";
                activated => { root.play(); }
            }
            MenuItem {
                title: "Start a Jam";
                activated => { root.jam(); }
            }
        }
    }
    if root.playable: Rectangle {
        x: 10px;
        y: root.side - self.height - 10px;
        opacity: touch.has-hover || play-touch.has-hover ? 1 : 0;
        transform-scale: touch.has-hover || play-touch.has-hover ? 1 : 0.8;
        animate opacity, transform-scale { duration: 180ms; easing: ease-out; }
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: play-touch.has-hover ? Theme.accent : #1e1e1ec0;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000060;
        Icon {
            x: (parent.width - self.width) / 2 + 1px;
            path: Icons.play;
            solid: true;
            colour: white;
            width: 14px;
            height: 14px;
        }
        play-touch := TouchArea {
            enabled: parent.opacity > 0.5;
            clicked => { root.play(); }
        }
    }
}

// Cards in rows filling the page's width. Only the ones on screen are drawn, and only those ask for their
// covers.
component Grid inherits Flickable {
    in property <[Card]> cards;
    in property <int> rev;
    in property <bool> round;
    in property <length> pad: 32px;
    in property <length> bottom: 100px;
    pure callback art(string, int, int) -> image;
    callback open(Card);
    callback play(Card);
    callback jam(Card);
    property <length> gap: 22px;
    property <int> columns: max(2, floor((self.width - root.pad * 2 + root.gap) / (176px + root.gap)));
    // The cards grow a little so the rows reach both edges.
    property <length> side: (self.width - root.pad * 2 - (root.columns - 1) * root.gap) / root.columns;
    content-height: ceil(root.cards.length / root.columns) * (root.side + 46px + 24px) + root.bottom;
    for c[i] in root.cards: CardView {
        x: root.pad + mod(i, root.columns) * (root.side + root.gap);
        y: floor(i / root.columns) * (root.side + 46px + 24px);
        side: root.side;
        card: c;
        round: root.round;
        picture: root.art(c.art, 0, root.rev);
        open => { root.open(c); }
        play => { root.play(c); }
        jam => { root.jam(c); }
    }
}

component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <bool> more;
    callback clicked;
    alignment: start;
    spacing: 4px;
    height: 30px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: 19px;
        font-weight: 700;
        vertical-alignment: center;
    }
    if root.more: Icon {
        y: (parent.height - self.height) / 2 + 1px;
        path: Icons.chevron;
        colour: Theme.dim;
        weight: 2.4px;
        width: 15px;
        height: 15px;
    }
}

// A shelf of cards that scrolls sideways, under its title, as Music's: as many whole cards as fit across
// the page (grown a little to reach both edges), paged by the arrows over its sides while the pointer is on
// it. Until its cards are read it holds its place with plates, so the page does not shift as rows arrive.
// The cards are its children, placed at `gap + i * step` and `side` wide.
component ShelfView inherits VerticalLayout {
    in property <string> title;
    in property <int> count;
    in property <bool> loading;
    in property <bool> round;
    // A card's narrowest, and the height under its square (its captions).
    in property <length> least: 176px;
    in property <length> below: 46px;
    out property <length> gap: 22px;
    property <length> pad: 32px;
    property <int> columns: max(2, floor((self.width - root.pad * 2 + root.gap) / (root.least + root.gap)));
    out property <length> side: (self.width - root.pad * 2 - (root.columns - 1) * root.gap) / root.columns;
    out property <length> step: root.side + root.gap;
    property <int> shown: root.loading ? root.columns : root.count;
    // The row is seen from a gap before the left margin to a gap past the right one, so the cards beside
    // the whole ones are not glimpsed; it scrolls until its last card stands at the right margin.
    property <length> inset: root.pad - root.gap;
    property <length> seen: root.width - 2 * root.inset;
    property <length> end: min(0, root.seen - (root.gap + root.shown * root.step));
    // An arrow's page moves smoothly; a scroll by hand follows the hand.
    property <bool> paging;
    function page(by: int) {
        root.paging = true;
        flick.content-x = max(root.end, min(0, flick.content-x - by * root.columns * root.step));
        settle.running = true;
    }
    spacing: 10px;
    padding-bottom: 26px;
    HorizontalLayout {
        padding-left: root.pad;
        SectionTitle {
            text: root.title;
        }
    }
    hover := TouchArea {
        height: root.side + root.below;
        flick := Flickable {
            x: root.inset;
            width: root.seen;
            content-width: root.gap + root.shown * root.step;
            animate content-x { duration: root.paging ? 420ms : 0ms; easing: cubic-bezier(0.25, 0.8, 0.3, 1); }
            if root.loading: Rectangle {
                for i in root.columns: Rectangle {
                    x: root.gap + i * root.step;
                    width: root.side;
                    Rectangle {
                        y: 0;
                        height: root.side;
                        border-radius: root.round ? self.width / 2 : 8px;
                        background: Theme.fill;
                    }
                    Rectangle {
                        y: root.side + 12px;
                        width: root.side * 0.7;
                        x: 0;
                        height: 9px;
                        border-radius: 4.5px;
                        background: Theme.fill;
                    }
                    Rectangle {
                        y: root.side + 29px;
                        width: root.side * 0.45;
                        x: 0;
                        height: 9px;
                        border-radius: 4.5px;
                        background: Theme.hairline;
                    }
                }
            }
            Rectangle {
                visible: !root.loading;
                @children
            }
        }
        for b[i] in [{ by: -1, path: Icons.chevron-back }, { by: 1, path: Icons.chevron }]: Rectangle {
            property <bool> shown: hover.has-hover && (b.by < 0 ? flick.content-x < 0 : flick.content-x > root.end);
            x: b.by < 0 ? root.pad - self.width / 2 : root.width - root.pad - self.width / 2;
            y: (root.side - self.height) / 2;
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: arrow.has-hover ? #2c2c2ef2 : #1e1e1ed9;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000066;
            opacity: self.shown ? 1 : 0;
            animate opacity { duration: 160ms; easing: ease-out; }
            Icon {
                path: b.path;
                colour: Theme.text;
                weight: 2.4px;
                width: 16px;
                height: 16px;
            }
            arrow := TouchArea {
                enabled: parent.shown;
                clicked => { root.page(b.by); }
            }
        }
    }
    settle := Timer {
        interval: 450ms;
        running: false;
        triggered => {
            root.paging = false;
            self.running = false;
        }
    }
}

// A mix on "Top Picks", as Music draws them: four of its covers over its colour, melting into a band of the
// deeper colour that carries its name.
component PickCard inherits Rectangle {
    in property <Pick> pick;
    in property <length> side;
    in property <int> rev;
    pure callback art(string, int, int) -> image;
    callback open;
    width: root.side;
    height: root.side * 1.3;
    border-radius: 12px;
    clip: true;
    background: root.pick.deep;
    Rectangle {
        y: 0;
        height: root.side;
        background: root.pick.tint;
        if root.pick.covers.length >= 4: Rectangle {
            for k in 4: Image {
                x: mod(k, 2) * root.side / 2;
                y: floor(k / 2) * root.side / 2;
                width: root.side / 2;
                height: root.side / 2;
                source: root.art(root.pick.covers[k], 0, root.rev);
                image-fit: cover;
            }
        }
        if root.pick.covers.length > 0 && root.pick.covers.length < 4: Image {
            width: root.side;
            height: root.side;
            source: root.art(root.pick.covers[0], 0, root.rev);
            image-fit: cover;
        }
        Rectangle {
            y: root.side * 0.5;
            height: root.side * 0.5;
            background: @linear-gradient(180deg, root.pick.deep.with-alpha(0) 0%, root.pick.deep.with-alpha(0.75) 70%, root.pick.deep 100%);
        }
    }
    VerticalLayout {
        y: root.side - 6px;
        height: root.height - self.y;
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.pick.title;
            color: white;
            font-size: 17px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.pick.sub;
            color: #ffffffb3;
            font-size: 13px;
            overflow: elide;
        }
    }
    Rectangle {
        background: touch.has-hover ? #00000026 : transparent;
        animate background { duration: 180ms; easing: ease-out; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
}

// A song in a list, as Music lists them: the number (or the small artwork), the title, the artist and
// album, and the length, over a hairline. Double click plays; a right click offers the rest.
component SongLine inherits Rectangle {
    in property <SongRow> song;
    in property <int> number;
    in property <bool> show-album: true;
    in property <bool> thumb;
    // A playlist's row: the artist in a column of its own, under its head.
    in property <bool> table;
    // A table's columns: what is left beside the artwork and the time, split a half, a quarter, a quarter
    // (the playlist's heads use the same sums).
    property <length> cols: root.width - 8px - 12px - 44px - 44px - 4 * 12px;
    in property <image> picture;
    in property <color> ink: Theme.accent;
    callback play;
    callback next;
    callback later;
    callback jam;
    callback star;
    height: root.thumb ? 56px : 44px;
    border-radius: 7px;
    background: root.song.playing ? root.ink : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: 140ms; easing: ease-out; }
    Rectangle {
        x: root.thumb ? 64px : 44px;
        y: parent.height - 1px;
        width: parent.width - self.x - 8px;
        height: 1px;
        background: Theme.hairline;
    }
    touch := TouchArea {
        double-clicked => { root.play(); }
    }
    // Over the TouchArea, which would take the right press too: the menu area answers only that.
    ContextMenuArea {
        Menu {
            if !Jam.guest: MenuItem {
                title: "Play";
                activated => { root.play(); }
            }
            MenuItem {
                title: "Play Next";
                activated => { root.next(); }
            }
            MenuItem {
                title: Jam.guest ? "Add to Queue" : "Play Last";
                activated => { root.later(); }
            }
            if Jam.on && !Jam.hosting: MenuItem {
                title: "Start a Jam";
                activated => { root.jam(); }
            }
            MenuSeparator {}
            for m in root.song.menu: MenuItem {
                title: m.title;
                activated => {
                    if m.kind == 0 {
                        root.star();
                    } else if m.kind == 1 {
                        Go.album(m.id);
                    } else {
                        Go.artist(m.id);
                    }
                }
            }
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 12px;
            spacing: 12px;
            if root.thumb: Art {
                y: (parent.height - self.height) / 2;
                width: 44px;
                height: 44px;
                border-radius: 5px;
                source: root.picture;
            }
            if !root.thumb: Rectangle {
                width: 24px;
                if root.song.playing: Icon {
                    path: Icons.bars;
                    solid: true;
                    colour: white;
                    width: 15px;
                    height: 15px;
                }
                if !root.song.playing: Text {
                    width: 100%;
                    text: root.number;
                    color: root.song.playing ? #ffffffcc : Theme.dim;
                    font-size: 13px;
                    horizontal-alignment: right;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 2;
                preferred-width: 0;
                Text {
                    text: root.song.title;
                    color: root.song.playing ? white : Theme.text;
                    font-size: 13px;
                    overflow: elide;
                }
                if (root.thumb || root.show-album) && !root.table: ArtistLine {
                    text: root.song.artist;
                    artist: root.song.artist-id;
                    credits: root.song.credits;
                    color: root.song.playing ? #ffffffcc : Theme.dim;
                }
            }
            if root.show-album && !root.table: Link {
                horizontal-stretch: 1;
                preferred-width: 0;
                text: root.song.album;
                album: root.song.album-id;
                color: root.song.playing ? #ffffffcc : Theme.dim;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
            // A table's two columns stand at fixed places (the heads use the same sums), not where the layout
            // would share the width out.
            if root.table: Rectangle {
                preferred-width: 0;
                horizontal-stretch: 2;
            }
            // "Asked": a guest's request, until the host takes it.
            if root.song.by != "": Rectangle {
                y: (parent.height - self.height) / 2;
                height: 18px;
                width: bt.preferred-width + 14px;
                border-radius: 9px;
                background: Theme.accent.with-alpha(0.2);
                bt := Text {
                    text: root.song.by;
                    color: Theme.accent;
                    font-size: 10px;
                    font-weight: 600;
                }
            }
            Text {
                text: root.song.time;
                color: root.song.playing ? #ffffffcc : Theme.dim;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: right;
                width: 44px;
            }
        }
        if root.table: ArtistLine {
            x: 8px + 44px + 12px + root.cols * 0.5 + 12px;
            width: root.cols * 0.25;
            text: root.song.artist;
            artist: root.song.artist-id;
            credits: root.song.credits;
            color: root.song.playing ? #ffffffcc : Theme.dim;
            height: root.height;
        }
        if root.table: Link {
            x: 8px + 44px + 12px + root.cols * 0.75 + 24px;
            width: root.cols * 0.25;
            text: root.song.album;
            album: root.song.album-id;
            color: root.song.playing ? #ffffffcc : Theme.dim;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The column heads over a table of SongLines: the same sums as its columns.
component SongHeads inherits Rectangle {
    property <length> cols: self.width - 8px - 12px - 44px - 44px - 4 * 12px;
    for h in [{ t: "Song", x: 0, w: 0.5, g: 0 }, { t: "Artist", x: 0.5, w: 0.25, g: 1 }, { t: "Album", x: 0.75, w: 0.25, g: 2 }]: Text {
        x: 8px + 44px + 12px + root.cols * h.x + h.g * 12px;
        width: root.cols * h.w;
        text: h.t;
        color: Theme.dim;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        x: root.width - 12px - 44px;
        width: 44px;
        text: "Time";
        color: Theme.dim;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component SideItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <image> picture;
    in property <bool> has-picture;
    in property <bool> chosen;
    callback clicked;
    height: 34px;
    border-radius: 9px;
    background: root.chosen ? Theme.chosen : (touch.has-hover ? #ffffff0a : transparent);
    animate background { duration: 180ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        if !root.has-picture: Icon {
            y: (parent.height - self.height) / 2;
            path: root.icon;
            colour: Theme.accent;
            width: 20px;
            height: 20px;
        }
        if root.has-picture: Art {
            y: (parent.height - self.height) / 2;
            width: 24px;
            height: 24px;
            border-radius: 4px;
            source: root.picture;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-weight: root.chosen ? 600 : 400;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SideHeading inherits Text {
    color: Theme.dim;
    font-size: 12px;
    font-weight: 600;
    height: 30px;
    vertical-alignment: bottom;
    x: 10px;
}

// A page's large title, clear of the titlebar the page runs up under.
component Heading inherits VerticalLayout {
    in property <string> title;
    in property <string> caption;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 52px;
    padding-bottom: 16px;
    spacing: 2px;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 34px;
        font-weight: 700;
    }
    if root.caption != "": Text {
        text: root.caption;
        color: Theme.dim;
        font-size: 13px;
    }
}

// A text field: a rounded well, a magnifier or another icon, the placeholder until something is typed.
component Field inherits Rectangle {
    in property <string> placeholder;
    in property <string> icon;
    in property <bool> secret;
    in-out property <string> text;
    callback edited(string);
    callback accepted;
    height: 34px;
    border-radius: 9px;
    background: #ffffff0f;
    border-width: input.has-focus ? 3px : 1px;
    border-color: input.has-focus ? Theme.accent.with-alpha(0.55) : #ffffff14;
    public function take-focus() {
        input.focus();
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            path: root.icon;
            colour: Theme.dim;
            width: 15px;
            height: 15px;
        }
        Rectangle {
            input := TextInput {
                width: 100%;
                text <=> root.text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                input-type: root.secret ? InputType.password : InputType.text;
                selection-background-color: Theme.accent.with-alpha(0.4);
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
            if root.text == "": Text {
                x: 0;
                text: root.placeholder;
                color: Theme.faint;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
}

// The player's controls: the transport, the song with its progress under it, lyrics, the queue and the
// volume. The main window draws them in its own glass capsule where the system has no glass (Linux); on
// macOS they are the whole of `PlayerBar`, a window of their own over the system's Liquid Glass.
component PlayerControls inherits Rectangle {
    in property <bool> has-song;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-artist-id;
    in property <string> now-album-id;
    in property <Credits> now-credits;
    in property <bool> now-starred;
    in property <string> now-art;
    in property <bool> playing;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> volume: 1;
    in property <int> inspector;
    in property <int> covers-rev;
    in property <bool> devices-on;
    // The jam this computer hosts, as the strip beside the song says it ("Jam · 2 listening"); empty for none.
    in property <string> jam;
    // "Playing on <device>" while another device plays and this player controls it; empty while it plays here.
    in property <string> playing-on;
    // A jam guest's player: it shows the jam's song and controls nothing.
    in property <bool> guest;
    pure callback art(string, int, int) -> image;
    // The heart pressed.
    callback star();
    callback toggle();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback set-inspector(int);
    callback open-full();

    function clock(ms: int) -> string {
        let s = floor(max(0, ms) / 1000);
        return floor(s / 60) + ":" + (mod(s, 60) < 10 ? "0" : "") + mod(s, 60);
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 4px;
        if !root.guest: IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.shuffle;
            lit: root.shuffle;
            quiet: true;
            size: 34px;
            icon: 20px;
            clicked => { root.toggle-shuffle(); }
        }
        if !root.guest: IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.previous;
            solid: true;
            size: 36px;
            icon: 22px;
            clicked => { root.previous(); }
        }
        if !root.guest: PlayPause {
            y: (parent.height - self.height) / 2;
            playing: root.playing;
            size: 36px;
            icon: 24px;
            clicked => { root.toggle(); }
        }
        if !root.guest: IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.next;
            solid: true;
            size: 36px;
            icon: 22px;
            clicked => { root.next(); }
        }
        if !root.guest: IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.repeat;
            lit: root.repeat != 0;
            quiet: true;
            size: 34px;
            icon: 20px;
            clicked => { root.cycle-repeat(); }
            if root.repeat == 1: Text {
                x: parent.width - 11px;
                y: 3px;
                text: "1";
                color: Theme.accent;
                font-size: 8px;
                font-weight: 800;
            }
        }
        Rectangle {
            width: 10px;
        }
        // The song: its artwork (Now Playing on a click), the title, the artist and album,
        // and the progress under them, which thickens and shows the times under the pointer.
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 10px;
            Art {
                y: (parent.height - self.height) / 2;
                width: 38px;
                height: 38px;
                border-radius: 5px;
                source: root.art(root.now-art, 0, root.covers-rev);
                TouchArea {
                    clicked => {
                        if root.has-song {
                            root.open-full();
                        }
                    }
                }
            }
            song-box := Rectangle {
                horizontal-stretch: 1;
                property <int> dragged: -1;
                VerticalLayout {
                    y: 8px;
                    height: 32px;
                    Text {
                        text: root.has-song ? root.now-title : "Not Playing";
                        color: Theme.text;
                        font-weight: 600;
                        overflow: elide;
                    }
                    line := HorizontalLayout {
                        spacing: 8px;
                        // While another device plays, its strip takes the artist's place (the line is short).
                        property <bool> elsewhere: root.playing-on != "" && !seek.hot;
                        if seek.hot: Text {
                            horizontal-stretch: 1;
                            text: root.clock(song-box.dragged >= 0 ? song-box.dragged : root.position-ms) + "  /  " + root.clock(root.duration-ms);
                            color: Theme.dim;
                            overflow: elide;
                        }
                        if !line.elsewhere && !seek.hot: HorizontalLayout {
                            horizontal-stretch: 1;
                            ArtistLine {
                                max-width: self.preferred-width;
                                // The artists before the album, which elides first.
                                horizontal-stretch: 0;
                                text: root.now-artist;
                                artist: root.now-artist-id;
                                credits: root.now-credits;
                                color: Theme.dim;
                            }
                            if root.now-album != "": Text {
                                text: " — ";
                                color: Theme.dim;
                            }
                            if root.now-album != "": Link {
                                horizontal-stretch: 1;
                                text: root.now-album;
                                album: root.now-album-id;
                                color: Theme.dim;
                                overflow: elide;
                            }
                        }
                        // Where the music plays, as Android's "Playing on" strip: a click opens the devices. Else
                        // the jam, which a click opens in the queue panel.
                        if line.elsewhere || (root.playing-on == "" && root.jam != ""): HorizontalLayout {
                            spacing: 4px;
                            horizontal-stretch: root.playing-on != "" ? 1 : 0;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: root.playing-on != "" ? Icons.speaker : Icons.people;
                                colour: Theme.accent;
                                weight: 2px;
                                width: 14px;
                                height: 14px;
                            }
                            Text {
                                text: root.playing-on != "" ? root.playing-on : root.jam;
                                color: Theme.accent;
                                font-size: 11px;
                                font-weight: 600;
                                overflow: elide;
                                vertical-alignment: center;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.set-inspector(root.playing-on != "" ? 3 : 1); }
                                }
                            }
                        }
                    }
                }
                seek := Bar {
                    y: parent.height - self.height - 1px;
                    width: parent.width;
                    thin: 2px;
                    thick: 6px;
                    value: root.duration-ms > 0 ? (parent.dragged >= 0 ? parent.dragged : root.position-ms) / root.duration-ms : 0;
                    moved(v) => {
                        if !root.guest {
                            parent.dragged = v * root.duration-ms;
                        }
                    }
                    done(v) => {
                        parent.dragged = -1;
                        if !root.guest {
                            root.seek(v);
                        }
                    }
                }
            }
            if root.has-song && !root.guest: IconButton {
                y: (parent.height - self.height) / 2;
                path: Icons.heart;
                solid: root.now-starred;
                lit: root.now-starred;
                quiet: true;
                size: 30px;
                icon: 18px;
                clicked => { root.star(); }
            }
        }
        Rectangle {
            width: 10px;
        }
        if root.devices-on: IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.devices;
            lit: root.inspector == 3;
            size: 34px;
            icon: 20px;
            clicked => { root.set-inspector(root.inspector == 3 ? 0 : 3); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.lyrics;
            lit: root.inspector == 2;
            size: 34px;
            icon: 20px;
            clicked => { root.set-inspector(root.inspector == 2 ? 0 : 2); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            path: Icons.queue;
            lit: root.inspector == 1;
            size: 34px;
            icon: 20px;
            clicked => { root.set-inspector(root.inspector == 1 ? 0 : 1); }
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            path: root.volume > 0 ? Icons.speaker : Icons.speaker-off;
            size: 34px;
            icon: 20px;
            clicked => { root.set-volume(root.volume > 0 ? 0 : 1); }
        }
        Bar {
            y: (parent.height - self.height) / 2;
            width: 84px;
            value: root.volume;
            moved(v) => { root.set-volume(v); }
            done(v) => { root.set-volume(v); }
        }
    }
}

// Where the music plays (remote control), as Music's AirPlay list and Spotify's devices: this computer
// first, then the account's other devices with what each plays, the one playing ticked. A click moves the
// music there; this player then shows and controls it.
component DevicesView inherits Rectangle {
    in property <[DeviceRow]> devices;
    callback pick(string);
    // The jam's row was clicked while it is on: the queue panel shows it.
    callback open-jam();
    callback join-jam();
    Flickable {
        VerticalLayout {
            alignment: start;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 2px;
            HorizontalLayout {
                padding-left: 6px;
                height: 34px;
                Text {
                    text: "Play on";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                }
            }
            for d in root.devices: VerticalLayout {
                Rectangle {
                    height: 52px;
                    border-radius: 10px;
                    background: dt.has-hover ? Theme.hover : transparent;
                    animate background { duration: 140ms; easing: ease-out; }
                    dt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick(d.id); }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 8px;
                        spacing: 10px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: d.active ? Theme.accent : #ffffff1a;
                            animate background { duration: 180ms; easing: ease-out; }
                            Icon {
                                path: d.kind == 1 ? Icons.phone : d.kind == 2 ? Icons.terminal : Icons.computer;
                                colour: d.active ? white : Theme.text;
                                weight: 1.8px;
                                width: 18px;
                                height: 18px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: d.name;
                                color: d.active ? Theme.accent : Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if d.line != "": Text {
                                text: d.line;
                                color: Theme.dim;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                        if d.active: Icon {
                            y: (parent.height - self.height) / 2;
                            path: Icons.check;
                            colour: Theme.accent;
                            weight: 2.2px;
                            width: 16px;
                            height: 16px;
                        }
                    }
                }
                if d.note != "": HorizontalLayout {
                    padding-left: 50px;
                    padding-right: 6px;
                    Text {
                        text: d.note;
                        color: #ff6b6b;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
            if root.devices.length <= 1: HorizontalLayout {
                padding: 6px;
                Text {
                    text: "No other devices yet. Turn on “Control from other devices” in nori on them.";
                    color: Theme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            // The jam: starting one, or the one on (its row opens it in the queue panel) and ending it.
            if Jam.on || Jam.hosting || Jam.note != "": Rectangle {
                height: 13px;
                Rectangle {
                    x: 6px;
                    width: parent.width - 12px;
                    height: 1px;
                    background: Theme.hairline;
                }
            }
            if Jam.note != "": Text {
                text: Jam.note;
                color: Theme.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            if Jam.on || Jam.hosting: Rectangle {
                height: 52px;
                border-radius: 10px;
                background: jt.has-hover ? Theme.hover : transparent;
                animate background { duration: 140ms; easing: ease-out; }
                jt := TouchArea {
                    clicked => {
                        if Jam.hosting {
                            root.open-jam();
                        } else {
                            Jam.start();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 10px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: Jam.hosting ? Theme.accent : #ffffff1a;
                        Icon {
                            path: Icons.people;
                            colour: Jam.hosting ? white : Theme.text;
                            weight: 2px;
                            width: 18px;
                            height: 18px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: Jam.hosting ? "Your Jam" : "Start a Jam";
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: Jam.hosting ? Jam.strip : "Others join with a link and ask for songs";
                            color: Theme.dim;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                    if Jam.hosting: Text {
                        text: "End";
                        color: et.has-hover ? #ff6961 : #ff453a;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        et := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Jam.end(); }
                        }
                    }
                }
            }
            // Someone else's jam, joined with their invite link.
            if !Jam.guest: Rectangle {
                height: 52px;
                border-radius: 10px;
                background: jj.has-hover ? Theme.hover : transparent;
                animate background { duration: 140ms; easing: ease-out; }
                jj := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.join-jam(); }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 10px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: #ffffff1a;
                        Icon {
                            path: Icons.plus;
                            colour: Theme.text;
                            weight: 2px;
                            width: 16px;
                            height: 16px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Join a Jam…";
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: "With the invite link someone sent you";
                            color: Theme.dim;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// A small rounded button of the Mac's.
component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: 24px;
    width: bl.preferred-width + 22px;
    border-radius: 6px;
    background: ba.pressed ? #ffffff36 : (ba.has-hover ? #ffffff2b : #ffffff1f);
    opacity: root.enabled ? 1 : 0.4;
    bl := Text {
        text: root.text;
        color: Theme.text;
        font-size: 13px;
    }
    ba := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A round button in a panel's row: a quiet grey one, or the accent's for the yes.
component RoundButton inherits Rectangle {
    in property <string> path;
    in property <bool> lit;
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: root.lit ? (rt.has-hover ? Theme.accent.brighter(0.15) : Theme.accent) : (rt.has-hover ? #ffffff2b : #ffffff1a);
    animate background { duration: 140ms; easing: ease-out; }
    Icon {
        path: root.path;
        colour: root.lit ? white : Theme.text;
        weight: 2.2px;
        width: 13px;
        height: 13px;
        transform-scale: rt.pressed ? 0.85 : 1;
        animate transform-scale { duration: 220ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }
    rt := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A person's initial in a circle, coloured by their place in the jam.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <int> place;
    in property <length> side: 24px;
    property <[color]> tints: [#ff9f0a, #30d158, #64d2ff, #bf5af2, #ff375f, #ffd60a];
    property <color> tint: root.tints[mod(root.place, root.tints.length)];
    width: root.side;
    height: root.side;
    border-radius: root.side / 2;
    background: @linear-gradient(160deg, root.tint 0%, root.tint.darker(0.35) 100%);
    border-width: 1.5px;
    border-color: Theme.panel;
    Text {
        text: root.initial;
        color: white;
        font-size: root.side * 0.46;
        font-weight: 700;
    }
}

// A popover of the panel's: the dark rounded pane the choosers' lists use.
component Popover inherits Rectangle {
    border-radius: 12px;
    background: #2c2a2c;
    border-width: 1px;
    border-color: #ffffff1a;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000090;
}

// The jam over the queue, as Music's SharePlay and Spotify's Jam put it: who listens (their avatars and how
// many), the invite (a QR code and the link, in a popover), ending it, and the songs asked for, each to
// accept or refuse.
component JamHeader inherits VerticalLayout {
    in property <int> covers-rev;
    pure callback art(string, int, int) -> image;
    spacing: 0;
    padding-bottom: 12px;
    HorizontalLayout {
        height: 30px;
        spacing: 8px;
        padding-left: 4px;
        Icon {
            y: (parent.height - self.height) / 2;
            path: Icons.people;
            colour: Theme.accent;
            weight: 2px;
            width: 20px;
            height: 20px;
        }
        Text {
            horizontal-stretch: 1;
            text: Jam.guest ? Jam.host + "’s Jam" : "Jam";
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        // A guest's "Listen here" (playing along in sync) goes here, where the host has Invite.
        if !Jam.guest: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 26px;
            width: il.preferred-width + 34px;
            border-radius: 13px;
            background: ia.has-hover ? Theme.accent.brighter(0.15) : Theme.accent;
            HorizontalLayout {
                alignment: center;
                spacing: 5px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    path: Icons.plus;
                    colour: white;
                    weight: 2.4px;
                    width: 11px;
                    height: 11px;
                }
                il := Text {
                    text: "Invite";
                    color: white;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            ia := TouchArea {
                clicked => { invite.show(); }
            }
        }
    }
    // Who listens: their avatars overlapping and how many; the people popover on a click.
    HorizontalLayout {
        height: 34px;
        spacing: 8px;
        padding-left: 4px;
        Rectangle {
            width: Jam.people.length == 0 ? 0 : min(Jam.people.length, 5) * 17px + 7px;
            for p[i] in Jam.people: Avatar {
                visible: i < 5;
                x: i * 17px;
                y: (parent.height - self.height) / 2;
                initial: p.initial;
                place: i;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { people.show(); }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: Jam.listening;
            color: pa.has-hover ? Theme.text : Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            pa := TouchArea {
                mouse-cursor: pointer;
                clicked => { people.show(); }
            }
        }
        Text {
            text: Jam.guest ? "Leave" : "End Jam";
            color: ea.has-hover ? #ff6961 : #ff453a;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            ea := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if Jam.guest {
                        Jam.leave();
                    } else {
                        Jam.end();
                    }
                }
            }
        }
    }
    if Jam.asks.length > 0: Text {
        text: Jam.guest ? "You Asked For" : "Asked For";
        color: Theme.dim;
        font-size: 12px;
        font-weight: 600;
        height: 26px;
        vertical-alignment: bottom;
        x: 4px;
    }
    for a in Jam.asks: Rectangle {
        height: a.note != "" ? 62px : 50px;
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 2px;
            spacing: 8px;
            Art {
                y: (parent.height - self.height) / 2;
                width: 34px;
                height: 34px;
                border-radius: 4px;
                source: root.art(a.art, 0, root.covers-rev);
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 0;
                padding-left: 2px;
                Text {
                    text: a.title;
                    color: Theme.text;
                    font-size: 13px;
                    overflow: elide;
                }
                Text {
                    text: a.line;
                    color: Theme.dim;
                    font-size: 11px;
                    overflow: elide;
                }
                if a.note != "": Text {
                    text: a.note;
                    color: Theme.faint;
                    font-size: 10px;
                    overflow: elide;
                }
            }
            if Jam.guest: Rectangle {
                y: (parent.height - self.height) / 2;
                height: 18px;
                width: at.preferred-width + 14px;
                border-radius: 9px;
                background: #ffffff1a;
                at := Text {
                    text: "Asked";
                    color: Theme.dim;
                    font-size: 10px;
                    font-weight: 600;
                }
            }
            if !Jam.guest: RoundButton {
                y: (parent.height - self.height) / 2;
                path: Icons.close;
                clicked => { Jam.decide(a.request, false); }
            }
            if !Jam.guest: RoundButton {
                y: (parent.height - self.height) / 2;
                path: Icons.check;
                lit: true;
                clicked => { Jam.decide(a.request, true); }
            }
        }
        Rectangle {
            x: 48px;
            y: parent.height - 1px;
            width: parent.width - 52px;
            height: 1px;
            background: Theme.hairline;
        }
    }

    invite := PopupWindow {
        x: 0;
        y: 34px;
        width: root.width;
        close-policy: close-on-click-outside;
        Popover {
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text {
                    text: "Invite to Your Jam";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 184px;
                        height: 184px;
                        border-radius: 14px;
                        background: white;
                        Image {
                            width: 160px;
                            height: 160px;
                            source: Jam.qr;
                            image-rendering: pixelated;
                        }
                    }
                }
                Text {
                    text: "Others join by scanning this code with nori, or by opening the link.";
                    color: Theme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                if Jam.reach != "": Text {
                    text: Jam.reach;
                    color: #ff9f0a;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Rectangle {
                    height: 28px;
                    border-radius: 7px;
                    background: #ffffff0f;
                    border-width: 1px;
                    border-color: #ffffff14;
                    Text {
                        x: 9px;
                        width: parent.width - 18px;
                        text: Jam.link;
                        color: Theme.dim;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    Capsule {
                        text: "Copy Link";
                        icon: Icons.copy;
                        clicked => {
                            Jam.copy-link();
                            invite.close();
                        }
                    }
                }
            }
        }
    }

    people := PopupWindow {
        x: 0;
        y: 64px;
        width: root.width;
        close-policy: close-on-click-outside;
        Popover {
            VerticalLayout {
                padding: 8px;
                spacing: 0;
                Text {
                    text: "People";
                    color: Theme.dim;
                    font-size: 12px;
                    font-weight: 600;
                    height: 26px;
                    vertical-alignment: center;
                    x: 8px;
                }
                if Jam.people.length == 0: Text {
                    text: "No one has joined yet. Invite people with the link or the code.";
                    color: Theme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                    x: 8px;
                }
                for p[i] in Jam.people: Rectangle {
                    height: 44px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 6px;
                        spacing: 10px;
                        Avatar {
                            y: (parent.height - self.height) / 2;
                            side: 28px;
                            initial: p.initial;
                            place: i;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            min-width: 0;
                            Text {
                                text: p.name;
                                color: Theme.text;
                                font-size: 13px;
                                overflow: elide;
                            }
                            Text {
                                text: p.role;
                                color: Theme.dim;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                        if !Jam.guest: SmallButton {
                            y: (parent.height - self.height) / 2;
                            text: p.admin ? "Make Guest" : "Make Admin";
                            clicked => { Jam.promote(p.id, !p.admin); }
                        }
                        if !Jam.guest: RoundButton {
                            y: (parent.height - self.height) / 2;
                            path: Icons.close;
                            clicked => { Jam.send-out(p.id); }
                        }
                    }
                }
            }
        }
    }
}

// What plays next, as Music's panel lists it: AutoPlay and AutoMix as two wide pills, "Continue Playing"
// with where the songs come from and Clear, the songs with their artwork, and AutoPlay's promise at the end.
component QueueView inherits Rectangle {
    in property <[SongRow]> queue;
    in property <string> from;
    in property <bool> autoplay;
    in property <bool> automix;
    in property <int> covers-rev;
    // Its songs can be taken out, moved and cleared (here or on the device playing).
    in property <bool> editable: true;
    // Rows move up and down: the list plays in its order (not shuffled).
    in property <bool> movable;
    // "Removed “Song”" for a few seconds after a song is taken out, with Undo beside it.
    in property <string> undo-text;
    pure callback art(string, int, int) -> image;
    callback jump(int);
    callback clear;
    // A row's song taken out, by its list index.
    callback remove(int);
    // The song at a list index moved to another's.
    callback move(int, int);
    callback undo;
    callback set-autoplay(bool);
    callback set-automix(bool);
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 0;
        if Jam.hosting || Jam.guest: JamHeader {
            vertical-stretch: 0;
            covers-rev: root.covers-rev;
            art(a, s, r) => { return root.art(a, s, r); }
        }
        // The jam's host keeps AutoPlay and AutoMix; a guest has none.
        if !Jam.guest: HorizontalLayout {
            spacing: 8px;
            height: 34px;
            vertical-stretch: 0;
            for pill[i] in [{ on: root.autoplay, label: "AutoPlay" }, { on: root.automix, label: "AutoMix" }]: Rectangle {
                border-radius: self.height / 2;
                background: pill.on ? Theme.accent : #ffffff1a;
                animate background { duration: 180ms; easing: ease-out; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        path: i == 0 ? Icons.infinity : Icons.rings;
                        colour: pill.on ? white : Theme.text;
                        weight: 2px;
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        text: pill.label;
                        color: pill.on ? white : Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => {
                        if i == 0 {
                            root.set-autoplay(!root.autoplay);
                        } else {
                            root.set-automix(!root.automix);
                        }
                    }
                }
            }
        }
        // The heading keeps its height; the list below takes the rest, however long it is.
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 4px;
            padding-top: 14px;
            padding-bottom: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                Text {
                    text: "Continue Playing";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                }
                if root.from != "": Text {
                    text: "From " + root.from;
                    color: Theme.dim;
                    font-size: 13px;
                    overflow: elide;
                }
            }
            if root.editable && root.queue.length > 0: Text {
                text: "Clear";
                color: Theme.accent;
                font-size: 13px;
                vertical-alignment: top;
                TouchArea {
                    clicked => { root.clear(); }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }
        Flickable {
            vertical-stretch: 1;
            content-height: rows.preferred-height;
            // At the top however few the rows: a short queue left its space above them.
            rows := VerticalLayout {
            width: parent.width;
            alignment: start;
            for s[i] in root.queue: qrow := Rectangle {
                // A row put in opens from nothing; one leaving folds away (app.rs takes it out after).
                property <bool> opened: !s.fresh;
                // Its buttons show while the pointer is over the row.
                property <bool> hot: qt.has-hover || up.hovered || dn.hovered || rm.hovered;
                height: s.leaving || !self.opened ? 0 : 50px;
                opacity: s.leaving || !self.opened ? 0 : 1;
                animate height, opacity { duration: 300ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                clip: true;
                Timer {
                    interval: 16ms;
                    running: !parent.opened;
                    triggered => { parent.opened = true; }
                }
                border-radius: 6px;
                background: qt.has-hover ? Theme.hover : transparent;
                // The row's content inside it, so the row stays hovered over its links and buttons.
                qt := TouchArea {
                    double-clicked => { root.jump(s.index); }
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 10px;
                    Art {
                        y: (parent.height - self.height) / 2;
                        width: 34px;
                        height: 34px;
                        border-radius: 4px;
                        source: root.art(s.art, 0, root.covers-rev);
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: s.title;
                            color: Theme.text;
                            font-size: 13px;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            ArtistLine {
                                max-width: self.preferred-width;
                                // The artists before the album, which elides first.
                                horizontal-stretch: 0;
                                text: s.artist;
                                artist: s.artist-id;
                                credits: s.credits;
                                color: Theme.dim;
                                font-size: 11px;
                            }
                            if s.album != "": Text {
                                text: " — ";
                                color: Theme.dim;
                                font-size: 11px;
                            }
                            if s.album != "": Link {
                                horizontal-stretch: 1;
                                text: s.album;
                                album: s.album-id;
                                color: Theme.dim;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }
                    // Who asked for it in the jam.
                    if s.by != "": Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 18px;
                        width: min(bt.preferred-width, 72px) + 14px;
                        border-radius: 9px;
                        background: Theme.accent.with-alpha(0.2);
                        bt := Text {
                            width: min(self.preferred-width, 72px);
                            text: s.by;
                            color: Theme.accent;
                            font-size: 10px;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }
                    // Up, down and out, while hovered.
                    Rectangle {
                        width: root.editable && qrow.hot ? (root.movable ? 78px : 26px) : 0;
                        clip: true;
                        animate width { duration: 160ms; easing: ease-out; }
                        HorizontalLayout {
                            alignment: end;
                            up := IconButton {
                                y: (parent.height - self.height) / 2;
                                visible: root.movable;
                                path: Icons.up;
                                size: 26px;
                                icon: 14px;
                                quiet: i == 0;
                                clicked => {
                                    if i > 0 {
                                        root.move(s.index, root.queue[i - 1].index);
                                    }
                                }
                            }
                            dn := IconButton {
                                y: (parent.height - self.height) / 2;
                                visible: root.movable;
                                path: Icons.down;
                                size: 26px;
                                icon: 14px;
                                quiet: i == root.queue.length - 1;
                                clicked => {
                                    if i < root.queue.length - 1 {
                                        root.move(s.index, root.queue[i + 1].index);
                                    }
                                }
                            }
                            rm := IconButton {
                                y: (parent.height - self.height) / 2;
                                path: Icons.close;
                                size: 26px;
                                icon: 13px;
                                clicked => { root.remove(s.index); }
                            }
                        }
                    }
                }
                }
                Rectangle {
                    x: 48px;
                    y: parent.height - 1px;
                    width: parent.width - 52px;
                    height: 1px;
                    background: Theme.hairline;
                }
            }
                if root.autoplay && !Jam.guest: HorizontalLayout {
                padding-left: 4px;
                padding-top: 16px;
                padding-bottom: 8px;
                spacing: 6px;
                Icon {
                    path: Icons.infinity;
                    colour: Theme.text;
                    weight: 2px;
                    width: 20px;
                    height: 20px;
                }
                VerticalLayout {
                    Text {
                        text: "AutoPlay";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Similar songs will play";
                        color: Theme.dim;
                        font-size: 13px;
                    }
                }
            }
            }
        }

    }
    // The undo of a song taken out, as a pill over the foot of the list.
    if root.undo-text != "": Rectangle {
        x: 12px + (parent.width - 24px - self.width) / 2;
        y: parent.height - self.height - 12px;
        width: min(parent.width - 24px, ut.preferred-width + ua.preferred-width + 40px);
        height: 34px;
        border-radius: 17px;
        background: #3a383a;
        border-width: 1px;
        border-color: #ffffff1a;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000080;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;
            ut := Text {
                horizontal-stretch: 1;
                text: root.undo-text;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            ua := Text {
                text: "Undo";
                color: Theme.accent;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.undo(); }
                }
            }
        }
    }
}

// A switch in the Mac's own manner.
component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : #ffffff29;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 160ms; easing: ease-out; }
    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        animate x { duration: 180ms; easing: cubic-bezier(0.3, 1.2, 0.6, 1); }
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: white;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000050;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(!root.on); }
    }
}

// A menu of choices: the one chosen and a chevron; a click opens the list under it.
component Chooser inherits Rectangle {
    in property <[string]> options;
    in property <int> chosen;
    in property <bool> enabled: true;
    callback picked(int);
    width: max(140px, shown.preferred-width + 40px);
    height: 26px;
    border-radius: 7px;
    background: ca.has-hover ? #ffffff24 : #ffffff17;
    opacity: root.enabled ? 1 : 0.4;
    shown := Text {
        x: 10px;
        text: root.chosen >= 0 && root.chosen < root.options.length ? root.options[root.chosen] : "—";
        color: Theme.text;
        font-size: 13px;
    }
    Icon {
        x: parent.width - self.width - 8px;
        path: Icons.down;
        colour: Theme.dim;
        weight: 2.2px;
        width: 11px;
        height: 11px;
    }
    ca := TouchArea {
        enabled: root.enabled;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 200px);
        Rectangle {
            border-radius: 8px;
            background: #2c2a2cf5;
            border-width: 1px;
            border-color: #ffffff1a;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;
            VerticalLayout {
                padding: 4px;
                for o[i] in root.options: Rectangle {
                    height: 26px;
                    border-radius: 5px;
                    background: oa.has-hover ? Theme.accent : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 6px;
                        Text {
                            width: 12px;
                            text: i == root.chosen ? "✓" : "";
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        Text {
                            text: o;
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    oa := TouchArea {
                        clicked => { root.picked(i); }
                    }
                }
            }
        }
    }
}

// One row of the settings page, of whichever kind.
component SettingLine inherits VerticalLayout {
    in property <SettingRow> item;
    callback toggled(string, bool);
    callback chosen(string, int);
    callback action(string);
    callback slid(string, float, bool);
    callback typed(string, string);
    callback moved(string, bool);
    callback source(string, bool);
    callback swatch(int);
    if root.item.kind == 0: Text {
        text: root.item.title;
        color: Theme.text;
        font-size: 13px;
        font-weight: 700;
        height: 44px;
        vertical-alignment: bottom;
    }
    if root.item.kind == 0: Rectangle {
        height: 8px;
    }
    if root.item.kind == 9: HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        Text {
            text: root.item.title;
            color: Theme.dim;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
    if root.item.kind != 0 && root.item.kind != 9: Rectangle {
        background: #ffffff0c;
        border-top-left-radius: root.item.first ? 10px : 0;
        border-top-right-radius: root.item.first ? 10px : 0;
        border-bottom-left-radius: root.item.last ? 10px : 0;
        border-bottom-right-radius: root.item.last ? 10px : 0;
        min-height: 44px;
        if root.item.kind == 11 || root.item.kind == 12 || (root.item.kind == 8 && !root.item.on): TouchArea {
            clicked => { root.action(root.item.kind == 8 ? "server:" + root.item.name : root.item.name); }
        }
        VerticalLayout {
            padding-left: 14px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 12px;
                if root.item.kind == 8: Icon {
                    y: (parent.height - self.height) / 2;
                    path: Icons.server;
                    colour: root.item.on ? Theme.accent : Theme.dim;
                    width: 18px;
                    height: 18px;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.item.title;
                        color: root.item.kind == 12 ? Theme.accent : Theme.text;
                        opacity: root.item.enabled || root.item.kind == 4 ? 1 : 0.45;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if root.item.detail != "" && root.item.kind != 11: Text {
                        text: root.item.detail;
                        color: Theme.dim;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                if root.item.kind == 1: Toggle {
                    y: (parent.height - self.height) / 2;
                    on: root.item.on;
                    enabled: root.item.enabled;
                    toggled(v) => { root.toggled(root.item.name, v); }
                }
                if root.item.kind == 2: Chooser {
                    y: (parent.height - self.height) / 2;
                    options: root.item.options;
                    chosen: root.item.chosen;
                    enabled: root.item.enabled;
                    picked(i) => { root.chosen(root.item.name, i); }
                }
                if root.item.kind == 3: SmallButton {
                    y: (parent.height - self.height) / 2;
                    text: root.item.button;
                    enabled: root.item.enabled;
                    clicked => { root.action(root.item.name); }
                }
                if root.item.kind == 6: HorizontalLayout {
                    spacing: 4px;
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        path: "M6 14.5 L12 8.5 L18 14.5";
                        quiet: true;
                        size: 24px;
                        icon: 14px;
                        clicked => { root.moved(root.item.name, true); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        path: Icons.down;
                        quiet: true;
                        size: 24px;
                        icon: 14px;
                        clicked => { root.moved(root.item.name, false); }
                    }
                    Toggle {
                        y: (parent.height - self.height) / 2;
                        on: root.item.on;
                        toggled(v) => { root.source(root.item.name, v); }
                    }
                }
                if root.item.kind == 8 && root.item.on: Text {
                    text: "✓";
                    color: Theme.accent;
                    vertical-alignment: center;
                }
                if root.item.kind == 11: Text {
                    text: root.item.detail;
                    color: Theme.dim;
                    vertical-alignment: center;
                }
                if root.item.kind == 11: Icon {
                    y: (parent.height - self.height) / 2;
                    path: Icons.chevron;
                    colour: Theme.dim;
                    weight: 2.2px;
                    width: 12px;
                    height: 12px;
                }
                if root.item.kind == 10: HorizontalLayout {
                    spacing: 8px;
                    for c[i] in root.item.swatches: Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: c;
                        border-width: i == root.item.chosen ? 2px : 0;
                        border-color: white;
                        TouchArea {
                            clicked => { root.swatch(i); }
                        }
                    }
                }
            }
            if root.item.kind == 5: Bar {
                thin: 4px;
                thick: 6px;
                fill: Theme.accent;
                value: (root.item.value - root.item.min) / max(0.0001, root.item.max - root.item.min);
                moved(v) => { root.slid(root.item.name, root.item.min + v * (root.item.max - root.item.min), false); }
                done(v) => { root.slid(root.item.name, root.item.min + v * (root.item.max - root.item.min), true); }
            }
            if root.item.kind == 7: Field {
                height: 28px;
                secret: true;
                placeholder: "Not set";
                text: root.item.button;
                accepted => { root.typed(root.item.name, self.text); }
            }
        }
        if !root.item.last: Rectangle {
            x: 14px;
            y: parent.height - 1px;
            width: parent.width - 14px;
            height: 1px;
            background: Theme.hairline;
        }
    }
}

// A vertical slider, as a graphic equalizer's band: dragged up and down, filled from 0 dB to its level.
component BandSlider inherits Rectangle {
    in property <float> value;
    in property <float> lo: -12;
    in property <float> hi: 12;
    in property <bool> enabled: true;
    callback moved(float, bool);
    property <float> held: -100;
    property <float> shown: root.held > -99 ? root.held : root.value;
    property <length> track: root.height - 14px;
    property <length> knob: (1 - (root.shown - root.lo) / (root.hi - root.lo)) * root.track;
    property <length> zero: (1 - (0 - root.lo) / (root.hi - root.lo)) * root.track;
    width: 22px;
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 7px;
        height: root.track;
        width: 4px;
        border-radius: 2px;
        background: #ffffff22;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: min(root.knob, root.zero) + 7px;
        width: 4px;
        height: abs(root.knob - root.zero);
        background: Theme.accent;
    }
    Rectangle {
        y: root.knob;
        width: parent.width;
        height: 14px;
        border-radius: 7px;
        background: white;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000070;
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.held = round(max(root.lo, min(root.hi, root.hi - (self.mouse-y - 7px) / root.track * (root.hi - root.lo))) * 2) / 2;
                root.moved(root.held, false);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.held > -99 {
                root.moved(root.held, true);
                root.held = -100;
            }
        }
        moved => {
            if self.pressed {
                root.held = round(max(root.lo, min(root.hi, root.hi - (self.mouse-y - 7px) / root.track * (root.hi - root.lo))) * 2) / 2;
                root.moved(root.held, false);
            }
        }
    }
}

// A row with a label, a horizontal slider and its value.
component LevelRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> shown;
    in property <float> value;
    in property <float> lo;
    in property <float> hi;
    in property <bool> enabled: true;
    callback moved(float, bool);
    spacing: 12px;
    height: 32px;
    if root.label != "": Text {
        width: 80px;
        text: root.label;
        color: Theme.text;
        vertical-alignment: center;
    }
    Bar {
        y: (parent.height - self.height) / 2;
        horizontal-stretch: 1;
        thin: 4px;
        thick: 6px;
        fill: Theme.accent;
        opacity: root.enabled ? 1 : 0.45;
        value: (root.value - root.lo) / max(0.0001, root.hi - root.lo);
        moved(v) => { root.moved(root.lo + v * (root.hi - root.lo), false); }
        done(v) => { root.moved(root.lo + v * (root.hi - root.lo), true); }
    }
    if root.shown != "": Text {
        width: 72px;
        text: root.shown;
        color: Theme.dim;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> lit;
    callback clicked;
    height: 28px;
    width: cl.preferred-width + 24px;
    border-radius: 14px;
    background: root.lit ? Theme.accent : (ch.has-hover ? #ffffff26 : #ffffff17);
    animate background { duration: 150ms; easing: ease-out; }
    cl := Text {
        text: root.text;
        color: root.lit ? white : Theme.text;
        font-size: 13px;
    }
    ch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component EqSection inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 700;
    height: 40px;
    vertical-alignment: bottom;
}

// A switch with its title and a line under it.
component ToggleLine inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    in property <bool> on;
    callback toggled(bool);
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text {
            text: root.title;
            color: Theme.text;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.dim;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
    Toggle {
        y: (parent.height - self.height) / 2;
        on: root.on;
        toggled(v) => { root.toggled(v); }
    }
}

component EqualizerPage inherits Flickable {
    in property <bool> on;
    in property <bool> graphic;
    in property <int> count;
    in property <[EqBandRow]> bands;
    in property <string> curve;
    in property <[string]> presets;
    in property <bool> auto-preamp;
    in property <float> preamp;
    in property <string> preamp-label;
    in property <float> balance;
    in property <string> balance-label;
    in property <bool> mono;
    in property <bool> limiter;
    in property <float> ceiling;
    in property <string> ceiling-label;
    in property <string> crossfeed-preset;
    in property <float> crossfeed;
    in property <string> crossfeed-label;
    in property <float> cut;
    in property <string> cut-label;
    in property <string> bypass;
    in property <[float]> ranges;
    callback back;
    callback set(string, string);
    callback level(string, float, bool);
    callback gain(int, float, bool);
    callback tool(string, int);
    callback sized(length, length);
    content-height: page.preferred-height;
    page := VerticalLayout {
        width: parent.width;
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 52px;
        padding-bottom: 110px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            IconButton {
                y: (parent.height - self.height) / 2;
                path: "M15 5.5 L8.5 12 L15 18.5";
                size: 30px;
                icon: 16px;
                clicked => { root.back(); }
            }
            Text {
                text: "Equalizer";
                color: Theme.text;
                font-size: 30px;
                font-weight: 700;
                horizontal-stretch: 1;
            }
            Toggle {
                y: (parent.height - self.height) / 2;
                on: root.on;
                toggled(v) => { root.set("eq", v ? "true" : "false"); }
            }
        }
        if root.bypass != "": Rectangle {
            border-radius: 10px;
            background: #ff453a33;
            height: bt.preferred-height + 20px;
            bt := Text {
                x: 12px;
                width: parent.width - 24px;
                text: root.bypass;
                color: Theme.text;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Chip {
                text: "Graphic";
                lit: root.graphic;
                clicked => { root.set("eqMode", "GRAPHIC"); }
            }
            Chip {
                text: "Parametric";
                lit: !root.graphic;
                clicked => { root.set("eqMode", "PARAMETRIC"); }
            }
            Rectangle {
                width: 16px;
            }
            if root.graphic: HorizontalLayout {
                spacing: 8px;
                for n in [5, 10, 15, 31]: Chip {
                    text: n + " bands";
                    lit: root.count == n;
                    clicked => { root.set("eqLayout", n); }
                }
            }
        }
        Text {
            text: root.graphic ? "Each slider is the level at its frequency. Neighbouring bands are corrected for each other, so the sound follows the sliders." : "Each band is a filter of its own: drag its level, or add another.";
            color: Theme.dim;
            font-size: 12px;
            wrap: word-wrap;
        }
        // The curve the graphic equalizer plays, and a vertical slider per band under it.
        if root.graphic: Rectangle {
            height: 96px;
            border-radius: 10px;
            background: #ffffff08;
            Rectangle {
                y: parent.height / 2;
                height: 1px;
                background: Theme.hairline;
            }
            // Drawn by the core at this box's own size, so the curve fills it (a path keeps its box's shape).
            changed width => { root.sized(self.width - 24px, self.height); }
            init => { root.sized(self.width - 24px, self.height); }
            Path {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                commands: root.curve;
                stroke: root.on ? Theme.accent : Theme.dim;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
            }
        }
        if root.graphic: HorizontalLayout {
            height: 220px;
            alignment: space-between;
            for b[i] in root.bands: VerticalLayout {
                spacing: 6px;
                Text {
                    text: b.value;
                    color: Theme.dim;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    BandSlider {
                        value: b.gain;
                        lo: root.ranges.length > 1 ? root.ranges[0] : -12;
                        hi: root.ranges.length > 1 ? root.ranges[1] : 12;
                        enabled: root.on;
                        moved(v, last) => { root.gain(i, v, last); }
                    }
                }
                Text {
                    text: b.label;
                    color: Theme.dim;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }
        }
        if !root.graphic: VerticalLayout {
            spacing: 2px;
            for b[i] in root.bands: HorizontalLayout {
                spacing: 8px;
                if b.uses-gain: LevelRow {
                    horizontal-stretch: 1;
                    label: b.label;
                    shown: b.value + " dB";
                    value: b.gain;
                    lo: root.ranges.length > 1 ? root.ranges[0] : -12;
                    hi: root.ranges.length > 1 ? root.ranges[1] : 12;
                    enabled: root.on;
                    moved(v, last) => { root.gain(i, v, last); }
                }
                if !b.uses-gain: Text {
                    horizontal-stretch: 1;
                    text: b.label + "   " + b.value;
                    color: Theme.text;
                    height: 32px;
                    vertical-alignment: center;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    path: Icons.close;
                    quiet: true;
                    size: 26px;
                    icon: 12px;
                    clicked => { root.tool("remove-band", i); }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if !root.graphic: Chip {
                text: "Add band";
                clicked => { root.tool("add-band", 0); }
            }
            Chip {
                text: "Reset";
                clicked => { root.tool("reset", 0); }
            }
        }
        EqSection {
            text: "Presets";
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for pr[i] in root.presets: Chip {
                text: pr;
                clicked => { root.tool("preset", i); }
            }
        }
        ToggleLine {
            padding-top: 12px;
            title: root.preamp-label;
            detail: "Automatic pulls the level down by the largest boost so the curve cannot clip";
            on: root.auto-preamp;
            toggled(v) => { root.tool(v ? "auto-preamp" : "manual-preamp", 0); }
        }
        if !root.auto-preamp: LevelRow {
            value: root.preamp;
            lo: root.ranges.length > 3 ? root.ranges[2] : -20;
            hi: root.ranges.length > 3 ? root.ranges[3] : 6;
            enabled: root.on;
            moved(v, last) => { root.level("eqPreamp", v, last); }
        }
        EqSection {
            text: "Output";
        }
        LevelRow {
            label: "Balance";
            shown: root.balance-label;
            value: root.balance;
            lo: -1;
            hi: 1;
            moved(v, last) => { root.level("balance", v, last); }
        }
        ToggleLine {
            title: "Mono";
            detail: "Both channels summed, for one-earbud listening";
            on: root.mono;
            toggled(v) => { root.set("mono", v ? "true" : "false"); }
        }
        ToggleLine {
            title: "Limiter";
            detail: "Catches what a boost or a positive ReplayGain would clip. Adds 5 ms of delay; below the ceiling the audio passes through untouched.";
            on: root.limiter;
            toggled(v) => { root.set("limiter", v ? "true" : "false"); }
        }
        if root.limiter: LevelRow {
            label: "Ceiling";
            shown: root.ceiling-label;
            value: root.ceiling;
            lo: root.ranges.length > 7 ? root.ranges[6] : -12;
            hi: root.ranges.length > 7 ? root.ranges[7] : 0;
            moved(v, last) => { root.level("limiter", v, last); }
        }
        EqSection {
            text: "Crossfeed";
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for c in [{ v: "OFF", t: "Off" }, { v: "DEFAULT", t: "Default" }, { v: "CHU_MOY", t: "Chu Moy" }, { v: "JAN_MEIER", t: "Jan Meier" }]: Chip {
                text: c.t;
                lit: root.crossfeed-preset == c.v;
                clicked => { root.set("crossfeedPreset", c.v); }
            }
        }
        Text {
            text: root.crossfeed-label;
            color: Theme.dim;
            font-size: 12px;
            wrap: word-wrap;
        }
        LevelRow {
            value: root.crossfeed;
            lo: root.ranges.length > 9 ? root.ranges[8] : 0;
            hi: root.ranges.length > 9 ? root.ranges[9] : 12;
            moved(v, last) => { root.level("crossfeed", v, last); }
        }
        if root.crossfeed > 0: Text {
            text: root.cut-label;
            color: Theme.dim;
            font-size: 12px;
        }
        if root.crossfeed > 0: LevelRow {
            value: root.cut;
            lo: root.ranges.length > 11 ? root.ranges[10] : 300;
            hi: root.ranges.length > 11 ? root.ranges[11] : 2000;
            moved(v, last) => { root.level("crossfeedCut", v, last); }
        }
    }
}

// Where the window is dragged from, and double-clicked to zoom: the content runs up under the titlebar.
component TitleStrip inherits TouchArea {
    callback drag;
    callback zoom;
    height: 44px;
    pointer-event(e) => {
        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
            root.drag();
        }
    }
    double-clicked => { root.zoom(); }
}

// The sidebar's rows: search and home, the library, the playlists, and settings and the server at its
// foot. The main window draws them over its own pane where the system has no glass (Linux); on macOS
// they are the whole of `SidebarWindow`, whose view sits inside the system's Liquid Glass over the page.
component SidebarContent inherits Rectangle {
    in property <int> view;
    in property <int> page-kind;
    in property <string> page-id;
    in property <[Card]> playlists;
    in property <[Card]> side-playlists;
    in property <string> server;
    in property <string> account;
    in property <string> account-initial;
    // A jam guest's: search only (the host's library opens from what it finds).
    in property <bool> guest;
    callback open-accounts();
    in property <int> covers-rev;
    in property <length> inset-top;
    pure callback art(string, int, int) -> image;
    callback go(int);
    callback open-playlist(string);
    callback drag-window();
    callback zoom-window();

    TitleStrip {
        y: 0;
        drag => { root.drag-window(); }
        zoom => { root.zoom-window(); }
    }
    Flickable {
        y: root.inset-top;
        height: parent.height - self.y - foot.height;
        content-height: side.preferred-height;
        side := VerticalLayout {
            width: parent.width;
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 12px;
            spacing: 1px;
            SideItem {
                text: "Search";
                icon: Icons.search;
                chosen: root.view == 1;
                clicked => { root.go(1); }
            }
            if !root.guest: SideItem {
                text: "Home";
                icon: Icons.home;
                chosen: root.view == 0;
                clicked => { root.go(0); }
            }
            if !root.guest: SideHeading {
                text: "Library";
            }
            if !root.guest: SideItem {
                text: "Artists";
                icon: Icons.artists;
                chosen: root.view == 3 || (root.view == 6 && root.page-kind == 1);
                clicked => { root.go(3); }
            }
            if !root.guest: SideItem {
                text: "Albums";
                icon: Icons.albums;
                chosen: root.view == 2 || (root.view == 6 && root.page-kind == 0);
                clicked => { root.go(2); }
            }
            if !root.guest: SideItem {
                text: "Songs";
                icon: Icons.songs;
                chosen: root.view == 5;
                clicked => { root.go(5); }
            }
            if !root.guest: SideHeading {
                text: "Playlists";
            }
            if !root.guest: SideItem {
                text: "All Playlists";
                icon: Icons.playlists;
                chosen: root.view == 4;
                clicked => { root.go(4); }
            }
            for p in root.side-playlists: SideItem {
                text: p.title;
                has-picture: true;
                picture: root.art(p.art, 0, root.covers-rev);
                chosen: root.view == 6 && root.page-kind == 2 && root.page-id == p.id;
                clicked => { root.open-playlist(p.id); }
            }
        }
    }
    foot := VerticalLayout {
        height: self.preferred-height;
        y: parent.height - self.height;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 8px;
        padding-bottom: 12px;
        spacing: 1px;
        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }
        Rectangle {
            height: 6px;
        }
        if !root.guest: SideItem {
            text: "Settings";
            icon: Icons.gear;
            chosen: root.view == 8 || root.view == 9;
            clicked => { root.go(8); }
        }
        // The account: who is signed in, and where; its settings on a click.
        Rectangle {
            height: 40px;
            border-radius: 9px;
            background: aa.has-hover ? #ffffff0a : transparent;
            HorizontalLayout {
                padding-left: 6px;
                spacing: 9px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: @linear-gradient(160deg, #8e8e93 0%, #5a5a5e 100%);
                    Text {
                        text: root.account != "" ? root.account-initial : "?";
                        color: white;
                        font-size: 13px;
                        font-weight: 600;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.account != "" ? root.account : root.server;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 500;
                        overflow: elide;
                    }
                    if root.account != "": Text {
                        text: root.server;
                        color: Theme.dim;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
            }
            aa := TouchArea {
                clicked => { root.open-accounts(); }
            }
        }
    }
}


export component AppWindow inherits Window {
    title: "nori";
    icon: @image-url("assets/logo.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 860px;
    min-height: 560px;
    background: Theme.ground;
    default-font-size: 13px;
    default-font-family: root.font;

    // The system's own font on macOS (SF Pro), Inter elsewhere.
    in property <string> font: "Inter";
    // Room for the traffic lights at the top of the sidebar.
    in property <length> inset-top: 16px;

    // 0 home, 1 search, 2 albums, 3 artists, 4 playlists, 5 songs, 6 a page (album, artist, playlist), 7 login.
    in-out property <int> view: 0;
    in property <string> server;
    in property <string> greeting: "Home";
    in property <bool> loading;
    in property <string> failed;
    in property <string> note;
    in property <bool> note-error;
    // Bumped whenever a cover arrives: every picture asks `art` again and finds the new one.
    in property <int> covers-rev;
    pure callback art(string, int, int) -> image;

    in property <[Shelf]> shelves;
    in property <[Pick]> picks;
    // The page is one of the mixes, laid out as a playlist.
    in property <bool> page-mix;
    in property <bool> picks-loaded;
    callback open-mix(string);
    in property <[Card]> albums;
    in property <[Card]> artists;
    in property <[Card]> playlists;
    in property <[SongRow]> songs;
    in property <bool> more-songs;

    in-out property <string> search-text;
    in property <[Card]> search-artists;
    in property <[Card]> search-albums;
    in property <[SongRow]> search-songs;
    in property <string> search-note;

    // The page open: 0 album, 1 artist, 2 playlist, and its id (the sidebar marks a playlist's).
    in property <int> page-kind;
    in property <string> page-id;
    in property <string> page-title;
    in property <string> page-sub;
    // The artist the page's subtitle names (an album's), whose page a click on it opens.
    in property <string> page-sub-artist;
    in property <string> page-caption;
    in property <string> page-art;
    in property <[SongRow]> page-songs;
    in property <[Card]> page-albums;
    // The page wears its cover's colours: the blurred cover (nori-look's wash) runs out into the page's own
    // colour, so there is no line where the picture stops.
    in property <image> page-wash;
    in property <color> page-bg: Theme.ground;
    in property <color> page-accent: Theme.accent;

    // What plays.
    in property <bool> has-song;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-artist-id;
    in property <Credits> now-credits;
    in property <bool> now-starred;
    in property <string> now-album-id;
    in property <string> now-art;
    in property <bool> playing;
    in property <bool> buffering;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> volume: 1;
    in property <[SongRow]> queue;
    // Now Playing's ground: the cover playing, blurred (nori-look's wash), in two layers that cross-fade.
    in property <image> wash-a;
    in property <image> wash-b;
    in property <bool> wash-on-b;
    in property <color> wash-tint: #202024;
    // The inspector on the right: 0 shut, 1 Playing Next, 2 lyrics, 3 the other devices. It keeps showing
    // the last one while it slides away.
    in-out property <int> inspector;
    // Remote control is on: the devices button, and the places the music can play.
    in property <bool> devices-on;
    in property <[DeviceRow]> devices;
    // A device row was clicked: the music moves there ("" for this computer).
    callback pick-device(string);
    // "Playing on <device>" while another device plays: the player shows and controls it.
    in property <string> playing-on;
    property <int> shown-panel: 1;
    changed inspector => {
        if self.inspector != 0 {
            self.shown-panel = self.inspector;
        }
        self.player-changed();
    }
    in-out property <bool> full-player;
    // What Now Playing shows beside the artwork: 0 nothing, 1 the queue, 2 the lyrics; and how tall the line
    // sung is (the compositor keeps it sharp).
    in-out property <int> full-panel: 2;
    out property <length> full-lyric-h: 60px;
    // Where the line sung is on the window now, as the lyrics scroll to it: the compositor's sharp band
    // follows it. Scrolled by hand, every line is sharp until the next one is sung.
    out property <length> full-lyric-top: full-lyrics.y + full-lyrics.content-y + root.full-lyric-at;
    out property <bool> full-lyrics-browsed;
    property <length> full-lyric-at;
    // The player is a window of its own over the system's Liquid Glass (macOS): the page draws none.
    in property <bool> native-player;
    // The sidebar is the system's Liquid Glass over the page (macOS): the page's ground, its colour and an
    // artist's picture run under it, and the page draws no sidebar of its own.
    in property <bool> native-sidebar;
    // The page's area moved (the window was resized), or what the player window mirrors changed.
    callback page-moved();
    callback player-changed();
    changed width => { root.page-moved(); }
    changed height => { root.page-moved(); }
    changed full-player => { root.player-changed(); }
    changed full-panel => { root.player-changed(); }
    changed view => { root.player-changed(); }
    // The lyrics of the song playing: the lines, the one sung (-1 for none), and a line about them.
    in property <[string]> lyrics-lines;
    in property <int> lyrics-active: -1;
    // The lit line filling word by word (lyrics with word times): what is sung, the character being sung and
    // how far, and the rest.
    in property <bool> lyric-sweeping;
    in property <string> lyric-sung;
    in property <string> lyric-now;
    in property <float> lyric-mix;
    in property <string> lyric-rest;
    callback lyric-tapped(int);
    in property <[LyricPiece]> lyric-pieces-side;
    in property <[LyricPiece]> lyric-pieces-full;
    in property <bool> lyrics-synced;
    in property <string> lyrics-note;
    in property <[SettingRow]> settings;
    // Who is signed in (the account row), and the text the page's list is narrowed by.
    in property <string> account;
    in property <string> account-initial;
    callback open-accounts();
    in-out property <string> find-text;
    // Every playlist, for the sidebar (the Playlists page's list may be narrowed).
    in property <[Card]> side-playlists;
    property <string> list-name: root.view == 2 ? "Albums" : root.view == 3 ? "Artists" : root.view == 4 ? "Playlists" : root.view == 5 ? "Songs" : root.view == 6 && root.page-kind == 0 ? "Album" : root.view == 6 && root.page-kind == 2 ? (root.page-mix ? "Mix" : "Playlist") : "";
    callback find-edited(string);
    // The artist chosen on the Artists page.
    in property <string> artist-chosen;
    callback choose-artist(string);
    // The equalizer page (view 9), from the settings.
    in property <bool> eq-on;
    in property <bool> eq-graphic;
    in property <int> eq-count;
    in property <[EqBandRow]> eq-bands;
    in property <string> eq-curve;
    in property <[string]> eq-presets;
    in property <bool> eq-auto-preamp;
    in property <float> eq-preamp;
    in property <string> eq-preamp-label;
    in property <float> eq-balance;
    in property <string> eq-balance-label;
    in property <bool> eq-mono;
    in property <bool> eq-limiter;
    in property <float> eq-ceiling;
    in property <string> eq-ceiling-label;
    in property <string> eq-crossfeed-preset;
    in property <float> eq-crossfeed;
    in property <string> eq-crossfeed-label;
    in property <float> eq-cut;
    in property <string> eq-cut-label;
    in property <string> eq-bypass;
    in property <[float]> eq-ranges;
    callback setting-slid(string, float, bool);
    callback setting-typed(string, string);
    callback source-moved(string, bool);
    callback accent-chosen(int);
    callback eq-set(string, string);
    callback eq-gain(int, float, bool);
    callback eq-tool(string, int);
    callback eq-sized(length, length);
    // The curve's box, points.
    in-out property <length> eq-curve-w: 800px;
    in-out property <length> eq-curve-h: 96px;
    // What the queue panel says: where the songs come from, and whether AutoPlay and AutoMix are on.
    in property <string> queue-from;
    in property <bool> autoplay;
    in property <bool> automix;
    callback clear-queue();
    // "Join a Jam": the sheet open, its link, why it failed, and joining under way.
    in-out property <bool> join-open;
    in-out property <string> join-link;
    in property <string> join-error;
    in property <bool> join-busy;
    callback join-jam(string);
    // A queue row's song taken out or moved (list indexes), and the last one taken out put back.
    callback remove-queued(int);
    callback move-queued(int, int);
    callback undo-removed();
    in property <string> queue-undo;
    // Settings tab: 0 General, 1 Playback, 2 Sound, 3 Lyrics, 4 Library, 5 Data, 6 Servers.
    in-out property <int> settings-tab;
    callback settings-tab-chosen(int);

    in-out property <string> login-url: "https://";
    in-out property <string> login-user;
    in-out property <string> login-password;
    in property <string> login-error;
    in property <bool> login-busy;
    in property <bool> can-cancel-login;

    callback go(int);
    callback open-album(string);
    callback open-artist(string);
    callback open-playlist(string);
    callback play-album(string);
    callback play-playlist(string);
    // A song of a list: 0 the page, 1 the songs, 2 search. `how`: 0 play, 1 next, 2 at the end, 3 play and
    // start a jam, 4 its heart.
    callback song(int, int, int);
    callback play-page(bool);
    // Plays an album (0) or playlist (1) and starts a jam.
    callback jam-play(int, string);
    // The page's songs added at the end of the queue.
    callback page-later();
    callback more();
    callback search-edited(string);
    callback toggle();
    // The heart of the song playing pressed.
    callback star();
    callback next();
    callback previous();
    callback seek(float);
    callback seek-by(int);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback jump(int);
    callback login();
    callback cancel-login();
    callback setting-toggled(string, bool);
    callback setting-chosen(string, int);
    callback setting-action(string);
    callback drag-window();
    callback zoom-window();
    // Worker messages are waiting in the app's inbox.
    callback messages-arrived();

    function clock(ms: int) -> string {
        let s = floor(max(0, ms) / 1000);
        return floor(s / 60) + ":" + (mod(s, 60) < 10 ? "0" : "") + mod(s, 60);
    }


    // The keys Music answers to without a menu: space plays and pauses, the arrows seek, escape leaves
    // Now Playing. A text field that has the keys keeps them.
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == " " {
                root.toggle();
                return accept;
            }
            if e.text == Key.Escape && root.full-player {
                root.full-player = false;
                return accept;
            }
            if e.text == Key.RightArrow && !e.modifiers.control {
                root.seek-by(10000);
                return accept;
            }
            if e.text == Key.LeftArrow && !e.modifiers.control {
                root.seek-by(-10000);
                return accept;
            }
            reject
        }

        Rectangle {
            background: Theme.ground;
        }
        // Half-clear ground under the glass sidebar.
        if root.native-sidebar && root.view != 7: Rectangle {
            width: Theme.side-w;
            background: Theme.ground.with-alpha(0.55);
        }

        if root.view == 7: Rectangle {
            TitleStrip {
                y: 0;
                drag => { root.drag-window(); }
                zoom => { root.zoom-window(); }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: 360px;
                        spacing: 12px;
                        HorizontalLayout {
                            alignment: center;
                            padding-bottom: 8px;
                            Image {
                                source: @image-url("assets/logo.png");
                                height: 54px;
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: "Sign in to your Navidrome or Subsonic server.";
                            color: Theme.dim;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 10px;
                        }
                        Field {
                            icon: Icons.server;
                            placeholder: "Server address";
                            text <=> root.login-url;
                        }
                        Field {
                            icon: Icons.person;
                            placeholder: "User name";
                            text <=> root.login-user;
                        }
                        Field {
                            icon: Icons.key;
                            placeholder: "Password";
                            secret: true;
                            text <=> root.login-password;
                            accepted => {
                                if !root.login-busy {
                                    root.login();
                                }
                            }
                        }
                        if root.login-error != "": Text {
                            text: root.login-error;
                            color: #ff453a;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                        Rectangle {
                            height: 8px;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            if root.can-cancel-login: Capsule {
                                text: "Cancel";
                                ink: Theme.fill;
                                label: Theme.text;
                                clicked => { root.cancel-login(); }
                            }
                            Capsule {
                                text: root.login-busy ? "Signing In…" : "Sign In";
                                clicked => {
                                    if !root.login-busy {
                                        root.login();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.view != 7: Rectangle {
            // A page that wears its cover's colour: the colour and the wash behind it.
            if root.view == 6: Rectangle {
                x: root.native-sidebar ? 0 : Theme.side-w;
                width: parent.width - self.x;
                background: root.page-bg;
                Image {
                    y: 0;
                    width: 100%;
                    height: 440px;
                    source: root.page-wash;
                    image-fit: fill;
                }
                Rectangle {
                    y: 0;
                    height: 440px;
                    background: @linear-gradient(180deg, root.page-bg.with-alpha(0.15) 0%, root.page-bg.with-alpha(0.55) 55%, root.page-bg 100%);
                }
            }
            // The page, right of the sidebar; it runs up under the titlebar and under the player.
            Rectangle {
                x: Theme.side-w;
                width: parent.width - self.x - (root.inspector != 0 ? Theme.panel-w : 0);
                animate width { duration: 300ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                // Under the system's glass, an artist's picture runs on under the sidebar.
                clip: !root.native-sidebar;

                if root.view == 0: Fade {
                    Flickable {
                        content-height: home.preferred-height;
                        home := VerticalLayout {
                            width: parent.width;
                            padding-bottom: 100px;
                            Heading {
                                title: root.greeting;
                            }
                            if !root.picks-loaded || root.picks.length > 0: picks-shelf := ShelfView {
                                title: "Top Picks for You";
                                count: root.picks.length;
                                loading: !root.picks-loaded;
                                least: 230px;
                                below: self.side * 0.3;
                                for m[i] in root.picks: PickCard {
                                    x: picks-shelf.gap + i * picks-shelf.step;
                                    side: picks-shelf.side;
                                    pick: m;
                                    rev: root.covers-rev;
                                    art(a, s, r) => { return root.art(a, s, r); }
                                    open => { root.open-mix(m.id); }
                                }
                            }
                            for shelf in root.shelves: VerticalLayout {
                                if !shelf.loaded || shelf.cards.length > 0: albums-shelf := ShelfView {
                                    title: shelf.title;
                                    count: shelf.cards.length;
                                    loading: !shelf.loaded;
                                    for c[i] in shelf.cards: CardView {
                                        x: albums-shelf.gap + i * albums-shelf.step;
                                        side: albums-shelf.side;
                                        card: c;
                                        picture: root.art(c.art, 0, root.covers-rev);
                                        open => { root.open-album(c.id); }
                                        play => { root.play-album(c.id); }
                                        jam => { root.jam-play(0, c.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.view == 1: Fade {
                    VerticalLayout {
                        HorizontalLayout {
                            padding-left: 32px;
                            padding-right: 32px;
                            padding-top: 52px;
                            padding-bottom: 8px;
                            Field {
                                icon: Icons.search;
                                placeholder: "Artists, albums and songs";
                                text <=> root.search-text;
                                edited(t) => { root.search-edited(t); }
                                init => { self.take-focus(); }
                            }
                        }
                        if root.search-note != "": Text {
                            x: 34px;
                            text: root.search-note;
                            color: Theme.dim;
                            height: 24px;
                            vertical-alignment: center;
                        }
                        Flickable {
                            vertical-stretch: 1;
                            content-height: found.preferred-height;
                            found := VerticalLayout {
                                width: parent.width;
                                padding-top: 16px;
                                padding-bottom: 100px;
                                if root.search-artists.length > 0: artists-found := ShelfView {
                                    title: "Artists";
                                    count: root.search-artists.length;
                                    round: true;
                                    for c[i] in root.search-artists: CardView {
                                        x: artists-found.gap + i * artists-found.step;
                                        side: artists-found.side;
                                        card: c;
                                        round: true;
                                        picture: root.art(c.art, 0, root.covers-rev);
                                        open => { root.open-artist(c.id); }
                                    }
                                }
                                if root.search-albums.length > 0: albums-found := ShelfView {
                                    title: "Albums";
                                    count: root.search-albums.length;
                                    for c[i] in root.search-albums: CardView {
                                        x: albums-found.gap + i * albums-found.step;
                                        side: albums-found.side;
                                        card: c;
                                        picture: root.art(c.art, 0, root.covers-rev);
                                        open => { root.open-album(c.id); }
                                        play => { root.play-album(c.id); }
                                        jam => { root.jam-play(0, c.id); }
                                    }
                                }
                                if root.search-songs.length > 0: HorizontalLayout {
                                    padding-left: 32px;
                                    padding-bottom: 6px;
                                    SectionTitle {
                                        text: "Songs";
                                    }
                                }
                                VerticalLayout {
                                    padding-left: 24px;
                                    padding-right: 24px;
                                    for s[i] in root.search-songs: SongLine {
                                        song: s;
                                        number: i + 1;
                                        thumb: true;
                                        show-album: false;
                                        picture: root.art(s.art, 0, root.covers-rev);
                                        play => { root.song(2, i, 0); }
                                        jam => { root.song(2, i, 3); }
                                        star => { root.song(2, i, 4); }
                                        next => { root.song(2, i, 1); }
                                        later => { root.song(2, i, 2); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.view == 2 || root.view == 4: Fade {
                    Grid {
                        y: 64px;
                        height: parent.height - 64px;
                        cards: root.view == 2 ? root.albums : root.playlists;
                        rev: root.covers-rev;
                        art(a, s, r) => { return root.art(a, s, r); }
                        open(c) => {
                            if root.view == 2 {
                                root.open-album(c.id);
                            } else {
                                root.open-playlist(c.id);
                            }
                        }
                        play(c) => {
                            if root.view == 2 {
                                root.play-album(c.id);
                            } else {
                                root.play-playlist(c.id);
                            }
                        }
                        jam(c) => { root.jam-play(root.view == 2 ? 0 : 1, c.id); }
                    }
                }

                // Artists as Music lists them: every artist down the left, the one chosen on the right.
                if root.view == 3: Fade {
                    ListView {
                        x: 0;
                        y: 64px;
                        width: 300px;
                        height: parent.height - 64px;
                        for a in root.artists: Rectangle {
                            height: 52px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                Rectangle {
                                    border-radius: 9px;
                                    background: root.artist-chosen == a.id ? Theme.chosen : (ar.has-hover ? Theme.hover : transparent);
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 12px;
                                        Art {
                                            y: (parent.height - self.height) / 2;
                                            width: 38px;
                                            height: 38px;
                                            border-radius: 19px;
                                            source: root.art(a.art, 0, root.covers-rev);
                                        }
                                        Text {
                                            text: a.title;
                                            color: Theme.text;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    ar := TouchArea {
                                        clicked => { root.choose-artist(a.id); }
                                        double-clicked => { root.open-artist(a.id); }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        x: 300px;
                        width: 1px;
                        background: Theme.hairline;
                    }
                    Flickable {
                        x: 301px;
                        y: 64px;
                        width: parent.width - 301px;
                        height: parent.height - 64px;
                        content-height: chosen.preferred-height;
                        chosen := VerticalLayout {
                            width: parent.width;
                            padding-left: 30px;
                            padding-right: 30px;
                            padding-top: 16px;
                            padding-bottom: 100px;
                            spacing: 8px;
                            if root.artist-chosen != "": HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: root.page-title;
                                    color: Theme.text;
                                    font-size: 28px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                IconButton {
                                    y: (parent.height - self.height) / 2;
                                    path: Icons.play;
                                    solid: true;
                                    ink: Theme.accent;
                                    base: Theme.fill;
                                    size: 32px;
                                    icon: 15px;
                                    clicked => { root.play-page(false); }
                                }
                                IconButton {
                                    y: (parent.height - self.height) / 2;
                                    path: Icons.shuffle;
                                    ink: Theme.accent;
                                    base: Theme.fill;
                                    size: 32px;
                                    icon: 15px;
                                    clicked => { root.play-page(true); }
                                }
                            }
                            if root.artist-chosen != "": Text {
                                text: root.page-caption;
                                color: Theme.dim;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            if root.artist-chosen != "": Rectangle {
                                height: 1px;
                                background: Theme.hairline;
                            }
                            if root.artist-chosen != "": Grid {
                                height: self.content-height;
                                pad: 0;
                                bottom: 0;
                                interactive: false;
                                cards: root.page-albums;
                                rev: root.covers-rev;
                                art(a, s, r) => { return root.art(a, s, r); }
                                open(c) => { root.open-album(c.id); }
                                play(c) => { root.play-album(c.id); }
                                jam(c) => { root.jam-play(0, c.id); }
                            }
                        }
                    }
                }

                if root.view == 5: Fade {
                    VerticalLayout {
                        Rectangle {
                            height: 56px;
                        }
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 16px;
                            SongHeads {
                                height: 28px;
                            }
                        }
                        HorizontalLayout {
                            vertical-stretch: 1;
                            padding-left: 24px;
                            padding-right: 16px;
                            ListView {
                                // The next page is asked for as the end comes within a screen, or when the rows
                                // do not fill the list.
                                function near-end() {
                                    if root.more-songs && self.content-height + self.content-y < self.visible-height * 2 {
                                        root.more();
                                    }
                                }
                                changed content-y => { self.near-end(); }
                                changed content-height => { self.near-end(); }
                                for s[i] in root.songs: SongLine {
                                    song: s;
                                    number: i + 1;
                                    table: true;
                                    thumb: true;
                                    picture: root.art(s.art, 0, root.covers-rev);
                                    play => { root.song(1, i, 0); }
                                    jam => { root.song(1, i, 3); }
                                    star => { root.song(1, i, 4); }
                                    next => { root.song(1, i, 1); }
                                    later => { root.song(1, i, 2); }
                                }
                            }
                        }
                    }
                }

                // An album, an artist or a playlist, as iOS 27 draws its artist pages: the picture dissolves
                // into the page, and the page takes its colour.
                if root.view == 6: Fade {
                    Rectangle {
                        // An artist: the picture across the page's whole width, drifting up slower than the page
                        // as it scrolls, and dissolving into the page's colour.
                        if root.page-kind == 1: Rectangle {
                            y: max(-self.height, page-flick.content-y * 0.45);
                            x: root.native-sidebar ? -Theme.side-w : 0;
                            width: parent.width - self.x;
                            height: max(420px, root.height * 0.64);
                            opacity: 1 + max(-0.8, page-flick.content-y / self.height);
                            clip: true;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: root.art(root.page-art, 2, root.covers-rev);
                                image-fit: cover;
                                opacity: self.source.width > 0 ? 1 : 0;
                                animate opacity { duration: 400ms; easing: ease-out; }
                            }
                            Rectangle {
                                background: @linear-gradient(180deg, root.page-bg.with-alpha(0) 0%, root.page-bg.with-alpha(0) 45%, root.page-bg.with-alpha(0.7) 78%, root.page-bg 100%);
                            }
                        }

                        page-flick := Flickable {
                            content-height: detail.preferred-height;
                            detail := VerticalLayout {
                                width: parent.width;
                                padding-left: 32px;
                                padding-right: 32px;
                                padding-top: 60px;
                                padding-bottom: 100px;
                                spacing: 26px;
                                // An artist: the name and the play button over the bottom of the picture.
                                if root.page-kind == 1: VerticalLayout {
                                    spacing: 16px;
                                    Rectangle {
                                        height: max(420px, root.height * 0.64) - 60px - 170px;
                                    }
                                    Text {
                                        text: root.page-title;
                                        color: white;
                                        font-size: 44px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 18px;
                                        IconButton {
                                            y: (parent.height - self.height) / 2;
                                            path: Icons.shuffle;
                                            size: 42px;
                                            icon: 18px;
                                            ink: white;
                                            base: #ffffff2b;
                                            clicked => { root.play-page(true); }
                                        }
                                        Rectangle {
                                            width: 64px;
                                            height: 64px;
                                            border-radius: 32px;
                                            background: white;
                                            drop-shadow-blur: 18px;
                                            drop-shadow-color: #00000055;
                                            transform-scale: pt.pressed ? 0.92 : (pt.has-hover ? 1.04 : 1);
                                            animate transform-scale { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                                            Icon {
                                                x: (parent.width - self.width) / 2 + 2px;
                                                path: Icons.play;
                                                solid: true;
                                                colour: #111111;
                                                width: 26px;
                                                height: 26px;
                                            }
                                            pt := TouchArea {
                                                clicked => { root.play-page(false); }
                                            }
                                        }
                                        Rectangle {
                                            width: 42px;
                                        }
                                    }
                                }
                                // An album or a playlist: the artwork beside its title, as the Mac lays them out.
                                if root.page-kind != 1: HorizontalLayout {
                                    spacing: 28px;
                                    alignment: start;
                                    Art {
                                        width: 270px;
                                        height: 270px;
                                        border-radius: 10px;
                                        shadow: true;
                                        source: root.art(root.page-art, 1, root.covers-rev);
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Rectangle {
                                            height: 64px;
                                        }
                                        Text {
                                            text: root.page-title;
                                            color: Theme.text;
                                            font-size: 26px;
                                            font-weight: 700;
                                            wrap: word-wrap;
                                        }
                                        if root.page-sub != "": Link {
                                            text: root.page-sub;
                                            artist: root.page-sub-artist;
                                            color: root.page-accent;
                                            font-size: 26px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.page-caption;
                                            color: Theme.dim;
                                            font-size: 12px;
                                            font-weight: 600;
                                        }
                                        Rectangle {
                                            vertical-stretch: 1;
                                        }
                                        // Shuffle in a circle, a wide Play, and add to the queue: quiet grey, in the accent, as Music has them.
                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;
                                            IconButton {
                                                y: (parent.height - self.height) / 2;
                                                path: Icons.shuffle;
                                                size: 34px;
                                                icon: 18px;
                                                ink: root.page-accent;
                                                base: Theme.fill;
                                                clicked => { root.play-page(true); }
                                            }
                                            Capsule {
                                                text: "Play";
                                                icon: Icons.play;
                                                solid-icon: true;
                                                ink: Theme.fill;
                                                label: root.page-accent;
                                                clicked => { root.play-page(false); }
                                            }
                                            IconButton {
                                                y: (parent.height - self.height) / 2;
                                                path: Icons.plus;
                                                size: 34px;
                                                icon: 18px;
                                                ink: root.page-accent;
                                                base: Theme.fill;
                                                clicked => { root.page-later(); }
                                            }
                                        }
                                    }
                                }
                                if root.page-kind == 1 && root.page-albums.length > 0: SectionTitle {
                                    text: "Albums";
                                }
                                if root.page-kind == 1 && root.page-albums.length > 0: Grid {
                                    height: self.content-height;
                                    pad: 0;
                                    bottom: 0;
                                    interactive: false;
                                    cards: root.page-albums;
                                    rev: root.covers-rev;
                                    art(a, s, r) => { return root.art(a, s, r); }
                                    open(c) => { root.open-album(c.id); }
                                    play(c) => { root.play-album(c.id); }
                                    jam(c) => { root.jam-play(0, c.id); }
                                }
                                // Only the rows on screen (and a few either side) are made: a playlist of thousands
                                // opens as fast as one of ten.
                                song-rows := Rectangle {
                                    property <length> row-h: root.page-kind == 2 ? 56px : 44px;
                                    // A playlist's column heads, right over its rows.
                                    property <length> head: root.page-kind == 2 && root.page-songs.length > 0 ? 28px : 0;
                                    property <length> seen-from: -page-flick.content-y - self.y - self.head - 400px;
                                    property <length> seen-to: -page-flick.content-y - self.y - self.head + page-flick.height + 400px;
                                    height: self.head + root.page-songs.length * self.row-h;
                                    if song-rows.head > 0: SongHeads {
                                        y: 0;
                                        height: song-rows.head;
                                    }
                                    for s[i] in root.page-songs: Rectangle {
                                        y: song-rows.head + i * song-rows.row-h;
                                        height: song-rows.row-h;
                                        if (i + 1) * song-rows.row-h > song-rows.seen-from && i * song-rows.row-h < song-rows.seen-to: SongLine {
                                            width: parent.width;
                                            song: s;
                                            number: s.index + 1;
                                            table: root.page-kind == 2;
                                            ink: root.page-accent;
                                            show-album: root.page-kind == 2;
                                            thumb: root.page-kind == 2;
                                            picture: root.page-kind == 2 ? root.art(s.art, 0, root.covers-rev) : root.art("", 0, 0);
                                            play => { root.song(0, s.index, 0); }
                                            jam => { root.song(0, s.index, 3); }
                                            star => { root.song(0, s.index, 4); }
                                            next => { root.song(0, s.index, 1); }
                                            later => { root.song(0, s.index, 2); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.view == 8: Fade {
                    Flickable {
                        content-height: prefs.preferred-height;
                        prefs := VerticalLayout {
                            width: parent.width;
                            padding-bottom: 100px;
                            // The title and the tabs centred over one narrow column, as the Mac's own
                            // settings windows have them.
                            Text {
                                text: "Settings";
                                color: Theme.text;
                                font-size: 22px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                height: 96px;
                                vertical-alignment: bottom;
                            }
                            HorizontalLayout {
                                alignment: center;
                                padding-top: 16px;
                                padding-bottom: 8px;
                                Rectangle {
                                    height: 30px;
                                    width: tabs.preferred-width + 6px;
                                    border-radius: 15px;
                                    background: Theme.fill;
                                    tabs := HorizontalLayout {
                                        x: 3px;
                                        padding-top: 3px;
                                        padding-bottom: 3px;
                                        spacing: 2px;
                                        for t[i] in ["General", "Playback", "Sound", "Lyrics", "Library", "Storage", "Accounts"]: Rectangle {
                                            width: label.preferred-width + 26px;
                                            border-radius: 12px;
                                            background: root.settings-tab == i ? #ffffff26 : (ta.has-hover ? Theme.hover : transparent);
                                            animate background { duration: 160ms; easing: ease-out; }
                                            label := Text {
                                                text: t;
                                                color: Theme.text;
                                                font-size: 13px;
                                                font-weight: root.settings-tab == i ? 600 : 400;
                                            }
                                            ta := TouchArea {
                                                clicked => { root.settings-tab-chosen(i); }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 32px;
                                padding-right: 32px;
                                alignment: center;
                                VerticalLayout {
                                    width: min(600px, parent.width - 64px);
                                    for r in root.settings: SettingLine {
                                        item: r;
                                        toggled(name, on) => { root.setting-toggled(name, on); }
                                        chosen(name, i) => { root.setting-chosen(name, i); }
                                        action(name) => { root.setting-action(name); }
                                        slid(name, v, last) => { root.setting-slid(name, v, last); }
                                        typed(name, text) => { root.setting-typed(name, text); }
                                        moved(id, up) => { root.source-moved(id, up); }
                                        source(id, on) => { root.setting-toggled("lyricsService:" + id, on); }
                                        swatch(i) => { root.accent-chosen(i); }
                                    }
                                }
                            }
                        }
                    }
                }

                // The equalizer, as the Android app's: the switch, graphic or parametric, the bands, the presets,
                // the pre-amp, then the output and the crossfeed.
                if root.view == 9: Fade {
                    EqualizerPage {
                        on: root.eq-on;
                        graphic: root.eq-graphic;
                        count: root.eq-count;
                        bands: root.eq-bands;
                        curve: root.eq-curve;
                        presets: root.eq-presets;
                        auto-preamp: root.eq-auto-preamp;
                        preamp: root.eq-preamp;
                        preamp-label: root.eq-preamp-label;
                        balance: root.eq-balance;
                        balance-label: root.eq-balance-label;
                        mono: root.eq-mono;
                        limiter: root.eq-limiter;
                        ceiling: root.eq-ceiling;
                        ceiling-label: root.eq-ceiling-label;
                        crossfeed-preset: root.eq-crossfeed-preset;
                        crossfeed: root.eq-crossfeed;
                        crossfeed-label: root.eq-crossfeed-label;
                        cut: root.eq-cut;
                        cut-label: root.eq-cut-label;
                        bypass: root.eq-bypass;
                        ranges: root.eq-ranges;
                        back => { root.go(8); }
                        set(name, value) => { root.eq-set(name, value); }
                        level(name, v, last) => { root.setting-slid(name, v, last); }
                        gain(i, v, last) => { root.eq-gain(i, v, last); }
                        tool(name, i) => { root.eq-tool(name, i); }
                        sized(w, h) => { root.eq-sized(w, h); }
                    }
                }

                if root.loading: Text {
                    text: "Loading…";
                    color: Theme.dim;
                }
                if root.failed != "" && !root.loading: Text {
                    width: 60%;
                    text: root.failed;
                    color: Theme.dim;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                TitleStrip {
                    y: 0;
                    width: parent.width;
                    drag => { root.drag-window(); }
                    zoom => { root.zoom-window(); }
                }

                // The toolbar, as Music's: the page's name on the left where it has no big title, and a field that
                // narrows what the page lists.
                if root.view >= 2 && root.view <= 5: Text {
                    x: 24px;
                    y: 18px;
                    text: root.list-name;
                    color: Theme.dim;
                    font-size: 13px;
                    font-weight: 600;
                }
                if root.list-name != "": Field {
                    x: parent.width - self.width - 16px;
                    y: 9px;
                    width: 226px;
                    height: 34px;
                    border-radius: 17px;
                    icon: Icons.search;
                    placeholder: "Find in " + root.list-name;
                    text <=> root.find-text;
                    edited(t) => { root.find-edited(t); }
                }

                // A note for a few seconds, over the page's top.
                Glass {
                    x: (parent.width - self.width) / 2;
                    y: root.note != "" ? 14px : -50px;
                    animate y { duration: 260ms; easing: ease-out; }
                    width: min(parent.width - 40px, toast.preferred-width + 32px);
                    height: 32px;
                    radius: 16px;
                    toast := Text {
                        text: root.note;
                        color: root.note-error ? #ff453a : Theme.text;
                        overflow: elide;
                    }
                }



                // The player: a glass capsule floating over the page's bottom, as Tahoe's Music has it.
                if !root.native-player: Glass {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 12px;
                    width: min(parent.width - 32px, 720px);
                    height: 54px;
                    radius: 27px;
                    density: 0.9;
                    PlayerControls {
                        has-song: root.has-song;
                        now-title: root.now-title;
                        now-artist: root.now-artist;
                        now-album: root.now-album;
                        now-artist-id: root.now-artist-id;
                        now-credits: root.now-credits;
                        now-starred: root.now-starred;
                        now-album-id: root.now-album-id;
                        now-art: root.now-art;
                        playing: root.playing;
                        position-ms: root.position-ms;
                        duration-ms: root.duration-ms;
                        shuffle: root.shuffle;
                        repeat: root.repeat;
                        volume: root.volume;
                        inspector: root.inspector;
                        covers-rev: root.covers-rev;
                        devices-on: root.devices-on;
                        jam: Jam.strip;
                        guest: Jam.guest;
                        playing-on: root.playing-on;
                        art(a, s, r) => { return root.art(a, s, r); }
                        toggle => { root.toggle(); }
                        star => { root.star(); }
                        next => { root.next(); }
                        previous => { root.previous(); }
                        seek(v) => { root.seek(v); }
                        set-volume(v) => { root.set-volume(v); }
                        toggle-shuffle => { root.toggle-shuffle(); }
                        cycle-repeat => { root.cycle-repeat(); }
                        set-inspector(i) => { root.inspector = i; }
                        open-full => {
                            if root.has-song {
                                root.full-player = true;
                            }
                        }
                    }
                }
            }

            // The panel on the right, docked to the window's edge as Music's is: the lyrics, sung line by line,
            // or what plays next.
            Rectangle {
                x: root.inspector != 0 ? parent.width - Theme.panel-w : parent.width;
                animate x { duration: 300ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                width: Theme.panel-w;
                height: parent.height;
                background: Theme.panel;
                clip: true;
                Rectangle {
                    x: 0;
                    width: 1px;
                    background: #0000004d;
                }
                TitleStrip {
                    y: 0;
                    drag => { root.drag-window(); }
                    zoom => { root.zoom-window(); }
                }
                if root.shown-panel == 2 && root.lyrics-lines.length == 0: Text {
                    x: 24px;
                    width: parent.width - 48px;
                    text: root.lyrics-note != "" ? root.lyrics-note : "No lyrics";
                    color: Theme.dim;
                    font-size: 15px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.shown-panel == 2 && root.lyrics-lines.length > 0: lyric-flick := Flickable {
                    y: 16px;
                    height: parent.height - 16px;
                    content-height: sung.preferred-height;
                    animate content-y { duration: 560ms; easing: cubic-bezier(0.25, 0.8, 0.3, 1); }
                    sung := VerticalLayout {
                        width: parent.width;
                        padding-left: 22px;
                        padding-right: 22px;
                        padding-top: 40px;
                        padding-bottom: 400px;
                        spacing: 22px;
                        for line[i] in root.lyrics-lines: Text {
                            property <bool> lit: i == root.lyrics-active;
                            // How lit the line is, fading as it changes: set when it changes (a change handler
                            // runs whether or not the line is drawn just then), so a line sung fades from white.
                            property <float> level;
                            animate level { duration: 420ms; easing: ease-out; }
                            // Scrolled to when lit, and when the lyrics come in with this line already sung.
                            changed lit => {
                                self.level = self.lit ? 1 : 0;
                                if self.lit {
                                    lyric-flick.content-y = -max(0, min(self.y - lyric-flick.height * 0.1, lyric-flick.content-height - lyric-flick.height));
                                }
                            }
                            init => {
                                self.level = self.lit ? 1 : 0;
                                if self.lit {
                                    lyric-flick.content-y = -max(0, min(self.y - lyric-flick.height * 0.1, lyric-flick.content-height - lyric-flick.height));
                                }
                            }
                            // Lyrics with word times are drawn by the StyledText (the Text only lays the line out):
                            // the lit line fills, and a line sung fades from white as the others do.
                            text: line;
                            wrap: word-wrap;
                            font-size: 22px;
                            font-weight: 700;
                            color: root.lyric-sweeping ? transparent : !root.lyrics-synced || self.lit ? #ffffffeb : #ffffff42;
                            animate color { duration: 420ms; easing: ease-out; }
                            if root.lyric-sweeping: StyledText {
                                // Kept while the pieces draw the line lit, only hidden: its colour comes up to white with them, so
                                // the line fades back from white when the next one takes over.
                                visible: !(parent.lit && root.lyric-pieces-side.length > 0);
                                width: 100%;
                                height: 100%;
                                default-font-size: 22px;
                                default-color: Colors.white.with-alpha(0.26 + (0.92 - 0.26) * parent.level);
                                text: parent.lit ? @markdown("**\{root.lyric-sung}<font color=\"\{Colors.white.with-alpha(0.26 + 0.66 * root.lyric-mix)}\">\{root.lyric-now}</font><font color=\"#ffffff42\">\{root.lyric-rest}</font>**") : @markdown("**\{line}**");
                            }
                            if self.lit && root.lyric-sweeping && root.lyric-pieces-side.length > 0: Rectangle {
                                width: 100%;
                                height: 100%;
                                for p in root.lyric-pieces-side: Text {
                                    x: p.x * 1px;
                                    y: p.y * 1px - p.lift * 2px;
                                    width: p.w * 1px;
                                    text: p.text;
                                    wrap: no-wrap;
                                    font-size: 22px;
                                    font-weight: 700;
                                    color: @linear-gradient(90deg, Colors.white.with-alpha(p.a0) 0%, Colors.white.with-alpha(p.aa) p.a * 100%, Colors.white.with-alpha(p.ab) p.b * 100%, Colors.white.with-alpha(p.a1) 100%);
                                    transform-scale-x: (1 + 0.04 * p.swell) * 100%;
                                    transform-scale-y: (1 + 0.04 * p.swell) * 100%;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.lyric-tapped(i); }
                            }
                        }
                        if root.lyrics-note != "": Text {
                            text: root.lyrics-note;
                            color: Theme.faint;
                            font-size: 11px;
                        }
                    }
                }
                if root.shown-panel == 3: DevicesView {
                    y: 30px;
                    height: parent.height - 30px - 76px;
                    devices: root.devices;
                    pick(id) => { root.pick-device(id); }
                    open-jam => { root.inspector = 1; }
                    join-jam => { root.join-open = true; }
                }
                if root.shown-panel == 1: QueueView {
                    y: 30px;
                    height: parent.height - 30px - 76px;
                    queue: root.queue;
                    from: root.queue-from;
                    autoplay: root.autoplay;
                    automix: root.automix;
                    covers-rev: root.covers-rev;
                    editable: !Jam.guest;
                    movable: !root.shuffle;
                    undo-text: root.queue-undo;
                    art(a, s, r) => { return root.art(a, s, r); }
                    jump(i) => { root.jump(i); }
                    clear => { root.clear-queue(); }
                    remove(i) => { root.remove-queued(i); }
                    move(f, t) => { root.move-queued(f, t); }
                    undo => { root.undo-removed(); }
                    set-autoplay(on) => { root.setting-toggled("autoFill", on); }
                    set-automix(on) => { root.setting-toggled("autoMix", on); }
                }
            }

            // The sidebar drawn by the page (no glass sidebar window).
            if !root.native-sidebar: Rectangle {
                x: 0;
                y: 0;
                width: Theme.side-w;
                height: parent.height;
                background: #262628;
                // A page in its picture's colours runs under the sidebar, which takes a little of it.
                Rectangle {
                    background: root.view == 6 && root.page-kind == 1 ? root.page-bg.with-alpha(0.5) : root.page-bg.with-alpha(0);
                    animate background { duration: 450ms; easing: ease-in-out; }
                }
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: #000000a0;
                }
                SidebarContent {
                    view: root.view;
                    page-kind: root.page-kind;
                    page-id: root.page-id;
                    playlists: root.playlists;
                    side-playlists: root.side-playlists;
                    server: root.server;
                    account: root.account;
                    account-initial: root.account-initial;
                    guest: Jam.guest;
                    open-accounts => { root.open-accounts(); }
                    covers-rev: root.covers-rev;
                    inset-top: root.inset-top;
                    art(a, s, r) => { return root.art(a, s, r); }
                    go(v) => { root.go(v); }
                    open-playlist(id) => { root.open-playlist(id); }
                    drag-window => { root.drag-window(); }
                    zoom-window => { root.zoom-window(); }
                }
            }
        }

        // ---- Now Playing, over the whole window, as Music has it ----
        // The song's own colours behind everything; the artwork and the controls on the left; on the right the
        // lyrics (the line sung sharp, the rest soft: the compositor blurs them, glass.wgsl) or what plays next.

        Rectangle {
            opacity: root.full-player ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: 300ms; easing: ease-out; }
            background: root.wash-tint;
            Image {
                width: 100%;
                height: 100%;
                source: root.wash-a;
                image-fit: cover;
                opacity: root.wash-on-b ? 0 : 1;
                animate opacity { duration: 800ms; easing: ease-in-out; }
            }
            Image {
                width: 100%;
                height: 100%;
                source: root.wash-b;
                image-fit: cover;
                opacity: root.wash-on-b ? 1 : 0;
                animate opacity { duration: 800ms; easing: ease-in-out; }
            }
            Rectangle {
                background: @linear-gradient(180deg, #0000002e 0%, #00000014 50%, #0000003d 100%);
            }
            // Swallows the clicks meant for the page underneath.
            TouchArea { }
            TitleStrip {
                y: 0;
                drag => { root.drag-window(); }
                zoom => { root.zoom-window(); }
            }
            // Back to the window: a dark glass capsule level with the traffic lights, as Music's.
            Rectangle {
                x: 84px;
                y: 11px;
                width: 46px;
                height: 30px;
                border-radius: 15px;
                background: xa.pressed ? #00000052 : xa.has-hover ? #0000003d : #0000002e;
                border-width: 1px;
                border-color: #ffffff2b;
                animate background { duration: 120ms; }
                Icon {
                    path: Icons.close;
                    colour: #ffffffeb;
                    weight: 1.5px;
                    width: 13px;
                    height: 13px;
                }
                xa := TouchArea {
                    clicked => { root.full-player = false; }
                }
            }
            // The volume, in a glass pill at the top right.
            Rectangle {
                x: parent.width - self.width - 12px;
                y: 10px;
                width: 176px;
                height: 32px;
                border-radius: 16px;
                background: #ffffff1f;
                border-width: 1px;
                border-color: #ffffff26;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 10px;
                    Bar {
                        y: (parent.height - self.height) / 2;
                        horizontal-stretch: 1;
                        thin: 5px;
                        thick: 7px;
                        fill: white;
                        track: #ffffff40;
                        value: root.volume;
                        moved(v) => { root.set-volume(v); }
                        done(v) => { root.set-volume(v); }
                    }
                    Icon {
                        y: (parent.height - self.height) / 2;
                        path: Icons.speaker;
                        colour: white;
                        width: 16px;
                        height: 16px;
                    }
                }
            }

            // The artwork and the controls: centred in the window with nothing beside them, in the left half
            // with the lyrics or the queue.
            property <length> side: min(460px, root.height - 330px, (root.full-panel != 0 ? root.width / 2 : root.width) - 120px);
            full-art := VerticalLayout {
                x: (root.full-panel != 0 ? root.width / 2 : root.width) / 2 - parent.side / 2;
                animate x { duration: 380ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                y: (root.height - self.preferred-height) / 2 + (root.full-player ? 0 : 30px);
                animate y { duration: 420ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                width: parent.side;
                height: self.preferred-height;
                spacing: 0;
                Art {
                    width: parent.width;
                    height: self.width;
                    border-radius: 8px;
                    shadow: true;
                    drop-shadow-blur: 40px;
                    drop-shadow-offset-y: 18px;
                    source: root.art(root.now-art, 1, root.covers-rev);
                    transform-scale: root.playing ? 1 : 0.9;
                    animate transform-scale { duration: 500ms; easing: cubic-bezier(0.3, 1.35, 0.6, 1); }
                }
                Rectangle {
                    height: 26px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text {
                            text: root.now-title;
                            color: white;
                            font-size: 16px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            ArtistLine {
                                max-width: self.preferred-width;
                                // The artists before the album, which elides first.
                                horizontal-stretch: 0;
                                text: root.now-artist;
                                artist: root.now-artist-id;
                                credits: root.now-credits;
                                color: #ffffffa6;
                                font-size: 14px;
                            }
                            if root.now-album != "": Text {
                                text: " — ";
                                color: #ffffffa6;
                                font-size: 14px;
                            }
                            if root.now-album != "": Link {
                                horizontal-stretch: 1;
                                text: root.now-album;
                                album: root.now-album-id;
                                color: #ffffffa6;
                                font-size: 14px;
                                overflow: elide;
                            }
                        }
                        if root.playing-on != "": HorizontalLayout {
                            padding-top: 6px;
                            spacing: 5px;
                            alignment: start;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: Icons.speaker;
                                colour: white;
                                weight: 2px;
                                width: 15px;
                                height: 15px;
                            }
                            Text {
                                text: root.playing-on;
                                color: white;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.full-player = false;
                                        root.inspector = 3;
                                    }
                                }
                            }
                        }
                    }
                    IconButton {
                        y: 2px;
                        path: Icons.heart;
                        solid: root.now-starred;
                        ink: #ffffffcc;
                        size: 34px;
                        icon: 20px;
                        clicked => { root.star(); }
                    }
                }
                Rectangle {
                    height: 20px;
                }
                Rectangle {
                    height: 14px;
                    property <int> dragged: -1;
                    Bar {
                        width: 100%;
                        thin: 5px;
                        thick: 8px;
                        fill: #ffffffd9;
                        track: #ffffff33;
                        value: root.duration-ms > 0 ? (parent.dragged >= 0 ? parent.dragged : root.position-ms) / root.duration-ms : 0;
                        moved(v) => { parent.dragged = v * root.duration-ms; }
                        done(v) => {
                            parent.dragged = -1;
                            root.seek(v);
                        }
                    }
                }
                HorizontalLayout {
                    padding-top: 4px;
                    Text {
                        text: root.clock(root.position-ms);
                        color: #ffffff8c;
                        font-size: 10px;
                    }
                    Text {
                        text: "-" + root.clock(root.duration-ms - root.position-ms);
                        color: #ffffff8c;
                        font-size: 10px;
                        horizontal-alignment: right;
                    }
                }
                Rectangle {
                    height: 16px;
                }
                HorizontalLayout {
                    alignment: space-between;
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        path: Icons.shuffle;
                        lit: root.shuffle;
                        ink: #ffffffcc;
                        icon: 19px;
                        size: 36px;
                        clicked => { root.toggle-shuffle(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        path: Icons.previous;
                        solid: true;
                        ink: white;
                        size: 50px;
                        icon: 34px;
                        clicked => { root.previous(); }
                    }
                    PlayPause {
                        y: (parent.height - self.height) / 2;
                        playing: root.playing;
                        ink: white;
                        size: 56px;
                        icon: 40px;
                        clicked => { root.toggle(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        path: Icons.next;
                        solid: true;
                        ink: white;
                        size: 50px;
                        icon: 34px;
                        clicked => { root.next(); }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        path: Icons.repeat;
                        lit: root.repeat != 0;
                        ink: #ffffffcc;
                        icon: 19px;
                        size: 36px;
                        clicked => { root.cycle-repeat(); }
                    }
                }
            }

            // The lyrics: big, the line sung at a fixed height and sharp, the rest soft and dim.
            if root.full-panel == 2 && root.lyrics-lines.length == 0: Text {
                x: root.width / 2 + 20px;
                width: root.width / 2 - 100px;
                text: root.lyrics-note != "" ? root.lyrics-note : "No lyrics for this song";
                color: #ffffff8c;
                font-size: 26px;
                font-weight: 700;
                wrap: word-wrap;
            }
            // Kept inside the part the compositor blurs (clear of the pills above and below). Always there, so
            // the window can say where the line sung is; its lines only while shown.
            full-lyrics := Flickable {
                visible: root.full-panel == 2 && root.lyrics-lines.length > 0;
                flicked => { root.full-lyrics-browsed = true; }
                x: root.width / 2 + 20px;
                width: root.width / 2 - 140px;
                y: 48px;
                height: root.height - 48px - 56px;
                content-height: full-sung.preferred-height;
                animate content-y { duration: 640ms; easing: cubic-bezier(0.25, 0.8, 0.3, 1); }
                full-sung := VerticalLayout {
                    width: parent.width;
                    padding-top: root.height * 0.36 - 48px;
                    padding-bottom: root.height;
                    spacing: 36px;
                    for line[i] in full-lyrics.visible ? root.lyrics-lines : []: Text {
                        property <bool> lit: i == root.lyrics-active;
                        // The line the lyrics are scrolled to: the one sung, or the last once all are over.
                        property <bool> aimed: i == min(root.lyrics-active, root.lyrics-lines.length - 1);
                        // As the panel's: how lit, fading as it changes, whether or not the line is drawn just then.
                        property <float> level;
                        animate level { duration: 500ms; easing: ease-out; }
                        changed lit => {
                            self.level = self.lit ? 1 : 0;
                        }
                        changed aimed => {
                            if self.aimed {
                                full-lyrics.content-y = -(self.y - (root.height * 0.36 - 48px));
                                root.full-lyric-h = self.height;
                                root.full-lyric-at = self.y;
                                root.full-lyrics-browsed = false;
                            }
                        }
                        init => {
                            self.level = self.lit ? 1 : 0;
                            if self.aimed {
                                full-lyrics.content-y = -(self.y - (root.height * 0.36 - 48px));
                                root.full-lyric-h = self.height;
                                root.full-lyric-at = self.y;
                            }
                        }
                        text: line;
                        wrap: word-wrap;
                        font-size: 44px;
                        font-weight: 700;
                        color: root.lyric-sweeping ? transparent : !root.lyrics-synced || self.lit ? white : #ffffff5c;
                        animate color { duration: 500ms; easing: ease-out; }
                        if root.lyric-sweeping: StyledText {
                            // Kept while the pieces draw the line lit, only hidden: its colour comes up to white with them, so
                            // the line fades back from white when the next one takes over.
                            visible: !(parent.lit && root.lyric-pieces-full.length > 0);
                            width: 100%;
                            height: 100%;
                            default-font-size: 44px;
                            default-color: Colors.white.with-alpha(0.36 + (1 - 0.36) * parent.level);
                            text: parent.lit ? @markdown("**\{root.lyric-sung}<font color=\"\{Colors.white.with-alpha(0.36 + 0.64 * root.lyric-mix)}\">\{root.lyric-now}</font><font color=\"#ffffff5c\">\{root.lyric-rest}</font>**") : @markdown("**\{line}**");
                        }
                        if self.lit && root.lyric-sweeping && root.lyric-pieces-full.length > 0: Rectangle {
                            width: 100%;
                            height: 100%;
                            for p in root.lyric-pieces-full: Text {
                                x: p.x * 1px;
                                y: p.y * 1px - p.lift * 3px;
                                width: p.w * 1px;
                                text: p.text;
                                wrap: no-wrap;
                                font-size: 44px;
                                font-weight: 700;
                                color: @linear-gradient(90deg, Colors.white.with-alpha(p.a0) 0%, Colors.white.with-alpha(p.aa) p.a * 100%, Colors.white.with-alpha(p.ab) p.b * 100%, Colors.white.with-alpha(p.a1) 100%);
                                transform-scale-x: (1 + 0.04 * p.swell) * 100%;
                                transform-scale-y: (1 + 0.04 * p.swell) * 100%;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.lyric-tapped(i); }
                        }
                    }
                }
            }
            if root.full-panel == 1: QueueView {
                x: root.width / 2 + 10px;
                width: root.width / 2 - 70px;
                y: 84px;
                height: root.height - 84px - 70px;
                queue: root.queue;
                from: root.queue-from;
                autoplay: root.autoplay;
                automix: root.automix;
                covers-rev: root.covers-rev;
                editable: !Jam.guest;
                movable: !root.shuffle;
                undo-text: root.queue-undo;
                art(a, s, r) => { return root.art(a, s, r); }
                jump(i) => { root.jump(i); }
                clear => { root.clear-queue(); }
                remove(i) => { root.remove-queued(i); }
                move(f, t) => { root.move-queued(f, t); }
                undo => { root.undo-removed(); }
                set-autoplay(on) => { root.setting-toggled("autoFill", on); }
                set-automix(on) => { root.setting-toggled("autoMix", on); }
            }

            // Lyrics and the queue, in a glass pill at the bottom right.
            Rectangle {
                x: parent.width - self.width - 14px;
                y: parent.height - self.height - 14px;
                width: 80px;
                height: 36px;
                border-radius: 18px;
                background: #ffffff1f;
                border-width: 1px;
                border-color: #ffffff26;
                HorizontalLayout {
                    padding: 3px;
                    spacing: 4px;
                    for b[i] in [2, 1]: Rectangle {
                        width: 34px;
                        border-radius: 15px;
                        background: root.full-panel == b ? white : transparent;
                        animate background { duration: 160ms; easing: ease-out; }
                        Icon {
                            path: b == 2 ? Icons.lyrics : Icons.queue;
                            colour: root.full-panel == b ? #1c1c1e : white;
                            width: 19px;
                            height: 19px;
                        }
                        TouchArea {
                            clicked => { root.full-panel = root.full-panel == b ? 0 : b; }
                        }
                    }
                }
            }
        }

        // Join a Jam: a sheet over the window, as the Mac's sheets come down from its top.
        if root.join-open: Rectangle {
            background: #00000066;
            TouchArea {
                clicked => { root.join-open = false; }
            }
            Popover {
                x: (parent.width - self.width) / 2;
                y: 80px;
                width: 420px;
                height: sheet.preferred-height;
                TouchArea {}
                sheet := VerticalLayout {
                    padding: 22px;
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            path: Icons.people;
                            colour: Theme.accent;
                            weight: 2px;
                            width: 30px;
                            height: 30px;
                        }
                    }
                    Text {
                        text: "Join a Jam";
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Paste the invite link someone sent you. You can ask for songs, and see what plays and who added it.";
                        color: Theme.dim;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    Field {
                        height: 34px;
                        border-radius: 8px;
                        clip: true;
                        icon: Icons.people;
                        placeholder: "nori://jam?…";
                        text <=> root.join-link;
                        accepted => { root.join-jam(root.join-link); }
                    }
                    if root.join-error != "": Text {
                        text: root.join-error;
                        color: #ff453a;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        SmallButton {
                            text: "Cancel";
                            clicked => { root.join-open = false; }
                        }
                        Capsule {
                            text: root.join-busy ? "Joining…" : "Join";
                            icon: Icons.people;
                            clicked => {
                                if !root.join-busy {
                                    root.join-jam(root.join-link);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// The player as its own window, composited as a glass layer over the page (compositor.rs).
export component PlayerBar inherits Window {
    title: "nori player";
    no-frame: true;
    background: transparent;
    default-font-size: 13px;
    default-font-family: root.font;
    in property <string> font: "Inter";
    in property <bool> has-song;
    in property <string> now-title;
    in property <string> now-artist;
    in property <string> now-album;
    in property <string> now-artist-id;
    in property <Credits> now-credits;
    in property <bool> now-starred;
    in property <string> now-album-id;
    in property <string> now-art;
    in property <bool> playing;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <float> volume: 1;
    in property <int> inspector;
    in property <int> covers-rev;
    in property <bool> devices-on;
    in property <string> jam;
    in property <string> playing-on;
    in property <bool> guest;
    pure callback art(string, int, int) -> image;
    callback toggle();
    callback star();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback set-inspector(int);
    callback open-full();
    // The pane the glass is seen as, over a plain page as over covers: a faint light and a thin rim, lit
    // along the top as the system's glass is. The glass itself (behind) does the blurring.
    Rectangle {
        border-radius: self.height / 2;
        background: #ffffff05;
        border-width: 1px;
        border-color: @linear-gradient(180deg, #ffffff0f 0%, #ffffff05 50%, #ffffff08 100%);
    }
    PlayerControls {
        has-song: root.has-song;
        now-title: root.now-title;
        now-artist: root.now-artist;
        now-album: root.now-album;
        now-artist-id: root.now-artist-id;
        now-credits: root.now-credits;
        now-starred: root.now-starred;
        now-album-id: root.now-album-id;
        now-art: root.now-art;
        playing: root.playing;
        position-ms: root.position-ms;
        duration-ms: root.duration-ms;
        shuffle: root.shuffle;
        repeat: root.repeat;
        volume: root.volume;
        inspector: root.inspector;
        covers-rev: root.covers-rev;
        devices-on: root.devices-on;
        jam: root.jam;
        guest: root.guest;
        playing-on: root.playing-on;
        art(a, s, r) => { return root.art(a, s, r); }
        toggle => { root.toggle(); }
        star => { root.star(); }
        next => { root.next(); }
        previous => { root.previous(); }
        seek(v) => { root.seek(v); }
        set-volume(v) => { root.set-volume(v); }
        toggle-shuffle => { root.toggle-shuffle(); }
        cycle-repeat => { root.cycle-repeat(); }
        set-inspector(i) => { root.set-inspector(i); }
        open-full => { root.open-full(); }
    }
}

// The sidebar as its own window, composited as a glass layer over the page (compositor.rs).
export component SidebarWindow inherits Window {
    title: "nori sidebar";
    no-frame: true;
    // A pane of its own over any page, as Music's sidebar is: a slight shade over the glass, and a hairline
    // where the page starts.
    Rectangle {
        background: #0000002e;
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: #ffffff09;
    }
    background: transparent;
    default-font-size: 13px;
    default-font-family: root.font;
    in property <string> font: "Inter";
    in property <int> view;
    in property <int> page-kind;
    in property <string> page-id;
    in property <[Card]> playlists;
    in property <[Card]> side-playlists;
    in property <string> server;
    in property <string> account;
    in property <string> account-initial;
    in property <bool> guest;
    callback open-accounts();
    in property <int> covers-rev;
    in property <length> inset-top;
    pure callback art(string, int, int) -> image;
    callback go(int);
    callback open-playlist(string);
    callback drag-window();
    callback zoom-window();
    SidebarContent {
        view: root.view;
        page-kind: root.page-kind;
        page-id: root.page-id;
        playlists: root.playlists;
        side-playlists: root.side-playlists;
        server: root.server;
        account: root.account;
        account-initial: root.account-initial;
        guest: root.guest;
        open-accounts => { root.open-accounts(); }
        covers-rev: root.covers-rev;
        inset-top: root.inset-top;
        art(a, s, r) => { return root.art(a, s, r); }
        go(v) => { root.go(v); }
        open-playlist(id) => { root.open-playlist(id); }
        drag-window => { root.drag-window(); }
        zoom-window => { root.zoom-window(); }
    }
}
