// nori's desktop window, built the way Apple Music is on macOS 26 and 27: a sidebar floating in its own
// rounded pane with the traffic lights inside it, the page on a near-black ground, and the player as a
// glass capsule floating at the bottom of the page. The queue is an inspector that floats in from the right,
// and Now Playing takes the whole window over the song's own colours. Album and artist pages dissolve their
// picture into the page as the iOS 27 artist pages (and nori's HeroPage on Android) do, from nori-look's wash.
//
// Everything here only draws and forwards what was clicked; the Rust side asks the core and the engine.

import { ListView, Switch, ComboBox, Button } from "std-widgets.slint";
// Linux has no SF Pro: the Android app's typeface is the fallback, from its resources.
import "../../../app/src/main/res/font/inter.ttf";

export struct Card {
    id: string,
    title: string,
    sub: string,
    art: string,
}

export struct SongRow {
    title: string,
    artist: string,
    album: string,
    time: string,
    art: string,
    // The list index a click plays or jumps to.
    index: int,
    playing: bool,
}

// A row of the settings page: 0 a group's heading, 1 a switch, 2 a choice, 3 a button, 4 a fact. `first`
// and `last` round the group's corners.
export struct SettingRow {
    kind: int,
    name: string,
    title: string,
    detail: string,
    on: bool,
    options: [string],
    chosen: int,
    button: string,
    first: bool,
    last: bool,
}

export struct Shelf {
    title: string,
    cards: [Card],
}

export global Theme {
    in-out property <color> accent: #fa2d48;
    // Measured from Music on the Mac (a screen recording of the current beta): a warm near-black ground,
    // text in three greys, hairlines barely there, and quiet grey fills for the buttons.
    out property <color> ground: #22201f;
    out property <color> text: #ffffffe5;
    out property <color> dim: #ffffff93;
    out property <color> faint: #ffffff5c;
    out property <color> hairline: #ffffff0a;
    out property <color> hover: #ffffff0d;
    out property <color> chosen: #ffffff1a;
    out property <color> fill: #ffffff12;
    // The sidebar's width, and the panel's on the right (lyrics, the queue), as Music has them.
    out property <length> side-w: 216px;
    out property <length> panel-w: 280px;
    // The panel's pane: a hair lighter than the page.
    out property <color> panel: #272423;
}

// Line icons on a 24 unit square, in the manner of SF Symbols; `solid` fills them instead.
export global Icons {
    out property <string> play: "M7.5 5.2 Q7.5 4 8.6 4.6 L19.2 10.9 Q20.3 11.6 19.2 12.3 L8.6 18.6 Q7.5 19.2 7.5 18 Z";
    out property <string> pause: "M6.5 5 Q6.5 4.5 7 4.5 L9.5 4.5 Q10 4.5 10 5 L10 19 Q10 19.5 9.5 19.5 L7 19.5 Q6.5 19.5 6.5 19 Z M14 5 Q14 4.5 14.5 4.5 L17 4.5 Q17.5 4.5 17.5 5 L17.5 19 Q17.5 19.5 17 19.5 L14.5 19.5 Q14 19.5 14 19 Z";
