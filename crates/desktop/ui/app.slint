    out property <string> gear: "M12 9 A3 3 0 1 1 12 15 A3 3 0 1 1 12 9 M10.3 3.5 L13.7 3.5 L14.2 5.8 L16.3 7 L18.5 6.2 L20.2 9.1 L18.5 10.7 L18.5 13.3 L20.2 14.9 L18.5 17.8 L16.3 17 L14.2 18.2 L13.7 20.5 L10.3 20.5 L9.8 18.2 L7.7 17 L5.5 17.8 L3.8 14.9 L5.5 13.3 L5.5 10.7 L3.8 9.1 L5.5 6.2 L7.7 7 L9.8 5.8 Z";
    out property <string> person: "M15.5 8 A3.5 3.5 0 1 1 8.5 8 A3.5 3.5 0 1 1 15.5 8 M5 20 Q5 14 12 14 Q19 14 19 20";
