<?xml version="1.0" encoding="utf-8"?>
<!-- The words the core module says outside the screens: the download notifications, the media session's
     buttons, the player's errors. Numbers are written by dev.nori.music.text.Fmt. -->
<resources>
    <!-- The download notification while a batch runs. -->
    <string name="notice_waiting">Waiting for a network</string>
    <string name="notice_downloading_named">Downloading “%1$s”</string>
    <string name="notice_downloading_one">Downloading 1 song</string>
    <string name="notice_downloading_of">Downloading: %1$d of %2$d</string>
    <string name="notice_album">“%1$s”</string>
    <string name="notice_complete">Downloads complete</string>
    <string name="notice_cancel">Cancel</string>

    <!-- How a batch went. -->
    <plurals name="summary_failed">
        <item quantity="one">%d song couldn’t be downloaded</item>
        <item quantity="other">%d songs couldn’t be downloaded</item>
    </plurals>
    <string name="summary_album">“%1$s” downloaded</string>
    <plurals name="summary_downloaded">
        <item quantity="one">%d song downloaded</item>
        <item quantity="other">%d songs downloaded</item>
    </plurals>
    <string name="summary_some_failed">%1$d downloaded · tap to see what failed</string>
    <string name="summary_try_again">Tap to try again</string>
    <!-- The batch's songs are saved and some are still being worked on; how it went is the line below. -->
    <plurals name="summary_finding_lyrics">
        <item quantity="one">Finding lyrics for %d song…</item>
        <item quantity="other">Finding lyrics for %d songs…</item>
    </plurals>
    <plurals name="summary_analysing">
        <item quantity="one">Analyzing %d song…</item>
        <item quantity="other">Analyzing %d songs…</item>
    </plurals>
    <!-- The beat model (Better beat detection) reading downloaded songs' intros and outros, after their audio is saved. -->
    <plurals name="summary_detecting_beats">
        <item quantity="one">Detecting beats for %d song…</item>
        <item quantity="other">Detecting beats for %d songs…</item>
    </plurals>
    <!-- Under the title while saved songs are processing: what else is left, each part joined by " · ". -->
    <plurals name="processing_analysing">
        <item quantity="one">%d to analyze</item>
        <item quantity="other">%d to analyze</item>
    </plurals>
    <plurals name="processing_beats">
        <item quantity="one">%d for beat detection</item>
        <item quantity="other">%d for beat detection</item>
    </plurals>

    <!-- The downloads screen's lines. -->
    <string name="downloads_active">%1$d downloading</string>
    <string name="downloads_waiting">%1$d waiting</string>
    <string name="downloads_failed">%1$d failed</string>
    <string name="downloads_nothing">Nothing downloading</string>
    <string name="eta_seconds">%1$d s left</string>
    <string name="eta_clock">%1$s left</string>

    <!-- The player. -->
    <string name="playback_error_network">The server could not be reached</string>
    <string name="playback_error_output">The audio output would not open</string>
    <string name="playback_error_other">This song would not play</string>
    <string name="radio_artist">Radio</string>
    <!-- A USB DAC that gives no name of its own. -->
    <string name="dac_unnamed">USB DAC</string>
    <string name="session_add_favourite">Add to favorites</string>
    <string name="session_remove_favourite">Remove from favorites</string>
    <string name="session_shuffle_on">Shuffle on</string>
    <string name="session_shuffle_off">Shuffle off</string>

    <!-- A failure of the server or the network, by its kind (dev.nori.music.net.Failures). -->
    <string name="error_metered">This server is set to Wi-Fi only</string>
    <string name="error_unknown_host">Server not found. Check the address.</string>
    <string name="error_connect">Nothing is answering at that address. Is the port right, and is the server running?</string>
    <string name="error_timeout">The server did not answer in time.</string>
    <string name="error_tls">The server\'s certificate was not accepted. If it is self-signed, turn on \"Accept self-signed certificate\"; if it needs a client certificate, import one.</string>
    <string name="error_cleartext">Cleartext HTTP was refused; use https://</string>
    <string name="error_http">HTTP %1$d</string>
    <string name="error_wrong_login">Wrong user name or password.</string>
    <string name="error_token_auth">This server does not support token authentication.</string>
    <string name="error_not_allowed">This user is not allowed to do that.</string>
    <string name="error_not_subsonic">That address answered, but not like a Subsonic server. Check the URL (and any reverse-proxy path).</string>
    <string name="error_bad_response">bad response: %1$s</string>
    <string name="error_database">database: %1$s</string>
    <string name="error_smart_playlist">This smart playlist\'s rules can\'t be read.</string>
    <string name="error_no_filters">that preset had no filters in it</string>

    <!-- The car's browse tree (Android Auto). -->
    <string name="car_root">nori</string>
    <string name="car_recently_played">Recently played</string>
    <string name="car_recently_added">Recently added</string>
    <string name="car_most_played">Most played</string>
    <string name="car_playlists">Playlists</string>
    <string name="car_favourites">Favorites</string>
    <string name="car_random">Random</string>
    <string name="car_downloads">Downloads</string>
    <plurals name="car_song_count">
        <item quantity="one">%1$d song</item>
        <item quantity="other">%1$d songs</item>
    </plurals>
    <string name="car_home">Home</string>
    <string name="car_library">Library</string>
    <string name="car_albums">Albums</string>
    <string name="car_artists">Artists</string>
    <string name="car_genres">Genres</string>
    <string name="car_songs">Songs</string>
    <string name="car_for_you">For you</string>
    <string name="car_play">Play</string>
    <string name="car_shuffle">Shuffle</string>
    <string name="car_play_next">Play next</string>
    <string name="car_add_to_queue">Add to queue</string>
    <string name="car_favourite">Favorite</string>
    <string name="car_download">Download</string>
    <string name="car_start_radio">Start radio</string>
    <string name="car_repeat_off">Repeat off</string>
    <string name="car_repeat_all">Repeat all</string>
    <string name="car_repeat_one">Repeat one</string>
    <string name="car_signed_out">Sign in to your server in nori on your phone</string>
    <string name="car_open_nori">Open nori</string>
    <string name="car_unreachable">Can’t reach your server</string>
</resources>
